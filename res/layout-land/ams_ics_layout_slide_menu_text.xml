<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/ams_toolbar_bg"
        android:paddingLeft="7.0dip"
        android:paddingTop="5.0dip"
        android:paddingRight="7.0dip"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginLeft="3.0dip"
        android:layout_marginTop="8.0dip"
        android:layout_marginRight="3.0dip">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:weightSum="297.0">
            <ImageView
                android:id="@id/btn_close"
                android:nextFocusLeft="@id/btn_close"
                android:nextFocusRight="@id/btn_close"
                android:nextFocusUp="@id/btn_close"
                android:nextFocusDown="@id/btn_text_color"
                android:layout_marginBottom="4.0dip"
                android:src="@drawable/ams_delete_icon"
                android:scaleType="center"
                android:layout_weight="32.0"
                style="@style/AMSIcsToolSlideMenuButtonStyleLand" />
            <ImageView
                android:id="@id/btn_text_color"
                android:nextFocusLeft="@id/btn_text_color"
                android:nextFocusRight="@id/btn_text_color"
                android:nextFocusUp="@id/btn_close"
                android:nextFocusDown="@id/btn_text_size"
                android:layout_marginBottom="4.0dip"
                android:src="@drawable/ams_toolbar_icon_color"
                android:scaleType="center"
                android:layout_weight="111.0"
                style="@style/AMSIcsToolSlideMenuButtonStyleLand" />
            <ImageView
                android:id="@id/btn_text_size"
                android:nextFocusLeft="@id/btn_text_size"
                android:nextFocusRight="@id/btn_text_size"
                android:nextFocusUp="@id/btn_text_color"
                android:nextFocusDown="@id/btn_text_size"
                android:scaleType="center"
                android:layout_weight="109.0"
                style="@style/AMSIcsToolSlideMenuButtonStyleLand" />
            <LinearLayout
                android:gravity="center"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="45.0">
                <ImageView
                    android:layout_width="33.0dip"
                    android:layout_height="33.0dip"
                    android:src="@drawable/ams_toolbar_icon_text"
                    android:scaleType="center" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>