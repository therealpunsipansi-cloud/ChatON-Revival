<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:background="@drawable/co_title_bar"
        android:paddingLeft="6.0dip"
        android:layout_width="fill_parent"
        android:layout_height="25.0dip"
        android:text="@string/settings_change_skins" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/change_skin_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1.0">
        <include
            layout="@layout/layout_skin_chatroom" />
        <ListView
            android:layout_gravity="center"
            android:id="@id/list_bg"
            android:background="@drawable/bg_bubble_option"
            android:layout_width="112.0dip"
            android:layout_height="fill_parent"
            android:cacheColorHint="@color/transparent"
            android:divider="@null" />
        <ListView
            android:layout_gravity="center"
            android:id="@id/list_bubble"
            android:background="@drawable/bg_bubble_option"
            android:layout_width="112.0dip"
            android:layout_height="fill_parent"
            android:cacheColorHint="@color/transparent"
            android:divider="@null" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/co_bg"
        android:paddingLeft="4.0dip"
        android:paddingTop="6.0dip"
        android:paddingRight="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="fill_parent"
        android:layout_height="55.0dip"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="16.0dip"
            android:id="@id/setSkin"
            android:layout_width="wrap_content"
            android:layout_height="48.0dip"
            android:text="@string/setSkin"
            android:layout_weight="1.0" />
        <Button
            android:textSize="16.0dip"
            android:id="@id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="48.0dip"
            android:text="@string/cancel"
            android:layout_weight="1.0" />
    </LinearLayout>
</LinearLayout>