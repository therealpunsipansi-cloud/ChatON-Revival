<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:scrollbars="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:background="@drawable/co_title_bar"
            android:paddingLeft="6.6999817dip"
            android:layout_width="fill_parent"
            android:layout_height="25.299988dip">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mypage_profile_name" />
        </LinearLayout>
        <EditText
            android:textSize="18.659973dip"
            android:gravity="top"
            android:id="@id/txtName"
            android:paddingLeft="15.0dip"
            android:paddingTop="15.0dip"
            android:paddingRight="15.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4.659973dip"
            android:layout_marginTop="6.0dip"
            android:layout_marginRight="4.659973dip"
            android:layout_marginBottom="6.0dip"
            android:text="My name is Bob"
            android:singleLine="true"
            android:maxLength="30"
            android:capitalize="sentences" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/layoutRegistName_0"
        android:background="@drawable/co_bg"
        android:paddingLeft="4.0dip"
        android:paddingTop="6.0dip"
        android:paddingRight="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="fill_parent"
        android:layout_height="55.0dip"
        android:layout_alignParentBottom="true">
        <Button
            android:enabled="false"
            android:textSize="16.0dip"
            android:id="@id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="48.0dip"
            android:text="@string/done"
            android:layout_weight="1.0" />
        <Button
            android:textSize="16.0dip"
            android:id="@id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="48.0dip"
            android:text="@string/cancel"
            android:layout_weight="1.0" />
    </LinearLayout>
</RelativeLayout>