<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:background="@drawable/bg_contact"
            android:paddingLeft="4.0dip"
            android:paddingRight="4.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@id/profile_chat"
                android:background="@drawable/btn_search_dialog_voice_xml"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4.0dip"
                android:layout_marginRight="4.0dip"
                android:src="@drawable/buddyprofile_chat_xml"
                android:layout_weight="1.0" />
            <ImageButton
                android:id="@id/profile_call"
                android:background="@drawable/btn_search_dialog_voice_xml"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4.0dip"
                android:layout_marginRight="4.0dip"
                android:src="@drawable/buddyprofile_call_xml"
                android:layout_weight="1.0" />
            <ImageButton
                android:id="@id/profile_msg"
                android:background="@drawable/btn_search_dialog_voice_xml"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4.0dip"
                android:layout_marginRight="4.0dip"
                android:src="@drawable/buddyprofile_msg_xml"
                android:layout_weight="1.0" />
        </LinearLayout>
        <ImageView
            android:background="#ff333a3a"
            android:layout_width="fill_parent"
            android:layout_height="0.30000007dip" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/layout_profile_phone_no"
            android:layout_width="fill_parent"
            android:layout_height="64.0dip">
            <TextView
                android:textSize="14.0dip"
                android:textColor="#ffffa800"
                android:layout_width="fill_parent"
                android:layout_height="24.0dip"
                android:layout_marginLeft="14.659973dip"
                android:layout_marginTop="6.3299866dip"
                android:text="@string/buddy_profile_chaton" />
            <TextView
                android:textSize="22.0dip"
                android:textColor="@color/brown_color_001"
                android:id="@id/profile_phone_no"
                android:layout_width="fill_parent"
                android:layout_height="24.0dip"
                android:layout_marginLeft="14.659973dip" />
        </LinearLayout>
        <ImageView
            android:background="#ff333a3a"
            android:layout_width="fill_parent"
            android:layout_height="0.30000007dip" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/profile_birthday_area"
            android:layout_width="fill_parent"
            android:layout_height="64.0dip">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="64.0dip"
                android:layout_weight="1.0">
                <TextView
                    android:textSize="14.0dip"
                    android:textColor="#ffffa800"
                    android:layout_width="fill_parent"
                    android:layout_height="24.0dip"
                    android:layout_marginLeft="14.659973dip"
                    android:layout_marginTop="6.3299866dip"
                    android:text="@string/buddy_profile_birthday" />
                <TextView
                    android:textSize="22.0dip"
                    android:textColor="@color/brown_color_001"
                    android:id="@id/profile_birthday"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginLeft="14.659973dip" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_width="50.659973dip"
                android:layout_height="64.0dip"
                android:layout_weight="0.0">
                <ImageView
                    android:id="@id/profile_calendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/buddy_profile_add_event_xml" />
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@id/profile_birthday_area_bottom_line"
            android:background="#ff333a3a"
            android:layout_width="fill_parent"
            android:layout_height="0.30000007dip" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="109.32999dip">
            <TextView
                android:textSize="14.0dip"
                android:textColor="#ffffa800"
                android:layout_width="fill_parent"
                android:layout_height="24.0dip"
                android:layout_marginLeft="14.659973dip"
                android:layout_marginTop="8.659973dip"
                android:text="@string/buddy_profile_interaction" />
            <TextView
                android:textSize="22.0dip"
                android:textColor="@color/brown_color_001"
                android:gravity="center|left|top"
                android:id="@id/profile_relationship_status"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14.659973dip" />
            <LinearLayout
                android:paddingLeft="12.0dip"
                android:paddingRight="12.0dip"
                android:layout_width="fill_parent"
                android:layout_height="37.329987dip"
                android:layout_marginTop="8.0dip">
                <ImageView
                    android:layout_width="18.659973dip"
                    android:layout_height="39.329987dip"
                    android:src="@drawable/relationship_bubble_left_tail"
                    android:scaleType="fitXY"
                    android:layout_weight="0.0" />
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/relationship_bubble_left"
                    android:layout_width="wrap_content"
                    android:layout_height="37.329987dip"
                    android:scaleType="fitXY"
                    android:layout_weight="0.0">
                    <TextView
                        android:textSize="12.0dip"
                        android:textStyle="bold"
                        android:textColor="#ff5e5842"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/buddy_profile_interaction_buddy" />
                    <TextView
                        android:textSize="12.0dip"
                        android:textStyle="bold"
                        android:textColor="#ff5e5842"
                        android:id="@id/interaction_buddy_point"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <ImageView
                    android:id="@id/interaction_buddy_weight"
                    android:background="@drawable/relationship_bubble_left"
                    android:layout_width="0.0dip"
                    android:layout_height="37.329987dip"
                    android:scaleType="fitXY"
                    android:layout_weight="1.0" />
                <ImageView
                    android:id="@id/interaction_me_weight"
                    android:background="@drawable/relationship_bubble_right"
                    android:layout_width="0.0dip"
                    android:layout_height="37.329987dip"
                    android:scaleType="fitXY"
                    android:layout_weight="1.0" />
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/interaction_right_me"
                    android:background="@drawable/relationship_bubble_right"
                    android:layout_width="40.0dip"
                    android:layout_height="37.329987dip"
                    android:scaleType="fitXY"
                    android:layout_weight="0.0">
                    <TextView
                        android:textSize="12.0dip"
                        android:textStyle="bold"
                        android:textColor="#ff5e5842"
                        android:gravity="right"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/buddy_profile_interaction_me" />
                    <TextView
                        android:textSize="12.0dip"
                        android:textStyle="bold"
                        android:textColor="#ff5e5842"
                        android:gravity="right"
                        android:id="@id/interaction_me_point"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <ImageView
                    android:id="@id/interaction_right_tail"
                    android:background="@drawable/relationship_bubble_right_tail"
                    android:layout_width="18.659973dip"
                    android:layout_height="39.329987dip"
                    android:scaleType="fitXY"
                    android:layout_weight="0.0" />
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:background="#ff333a3a"
            android:layout_width="fill_parent"
            android:layout_height="0.30000007dip" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/list_header"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@id/memo_layout_title"
                android:background="@drawable/co_sub_title_bg"
                android:paddingLeft="6.6999817dip"
                android:clickable="true"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:text="@string/memo_title" />
            <LinearLayout
                android:id="@id/profile_write_area"
                android:padding="6.659973dip"
                android:layout_width="fill_parent"
                android:layout_height="44.659973dip">
                <Button
                    android:textSize="16.0sp"
                    android:textColor="@color/memo_write_button_text"
                    android:gravity="center"
                    android:id="@id/memo_btn_write"
                    android:background="@drawable/memo_write_button_xml"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:text="@string/memo_btn_write" />
            </LinearLayout>
            <ImageView
                android:id="@id/memo_write_below_line"
                android:background="#ff333a3a"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="0.30000007dip" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>