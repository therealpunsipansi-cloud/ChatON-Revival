<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:background="@null"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/fontsizetopPanel"
        android:background="@drawable/popup_bg_top"
        android:layout_width="fill_parent"
        android:layout_height="76.0dip"
        android:layout_marginTop="36.0dip">
        <TextView
            android:textAppearance="@style/ChatONTextAppearance.Dialog"
            android:textSize="28.0dip"
            android:textColor="@color/white"
            android:gravity="center|left"
            android:id="@id/fontsizetext"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5.0dip"
            android:text="@string/settings_chat_view_font_size" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/fontsizebuttonPanel"
        android:background="@drawable/popup_bg_bottom"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="41.0dip"
        android:minHeight="75.0dip"
        android:layout_alignParentBottom="true">
        <Button
            android:id="@id/font_size_cancel_button"
            android:background="@drawable/popup_btn_default"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="9.0dip"
            android:layout_marginTop="5.0dip"
            android:layout_marginRight="10.0dip"
            android:layout_marginBottom="5.0dip"
            android:text="@string/dialog_cancel" />
    </LinearLayout>
    <ListView
        android:orientation="vertical"
        android:id="@android:id/list"
        android:fadingEdge="none"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:listSelector="#00000000"
        android:divider="@null"
        android:choiceMode="singleChoice"
        android:layout_above="@id/fontsizebuttonPanel"
        android:layout_below="@id/fontsizetopPanel" />
</RelativeLayout>