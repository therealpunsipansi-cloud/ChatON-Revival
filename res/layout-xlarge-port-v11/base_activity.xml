<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:id="@id/layout_fullframe"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <LinearLayout
        android:id="@id/layout_doubleframe"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <FrameLayout
            android:id="@id/fragment_controller"
            android:layout_width="@dimen/port_left_fragment_size"
            android:layout_height="fill_parent" />
        <ImageView
            android:id="@id/base_divider"
            android:layout_width="1.0dip"
            android:layout_height="fill_parent"
            android:src="@drawable/chat_preference_contents_list_no_arrow_left_holo_dark"
            android:scaleType="fitXY" />
        <FrameLayout
            android:id="@id/fragment_container"
            android:layout_width="@dimen/port_right_fragment_size"
            android:layout_height="fill_parent" />
    </LinearLayout>
    <ListView
        android:id="@id/more_option_list"
        android:background="@drawable/more_option_bg"
        android:visibility="gone"
        android:layout_width="270.0dip"
        android:layout_height="wrap_content"
        android:divider="@drawable/list_2line"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true" />
</RelativeLayout>