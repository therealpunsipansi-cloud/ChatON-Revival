<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/ics_main_background_color_2"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_weight="1.0">
        <LinearLayout
            android:orientation="vertical"
            android:scrollbars="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="100.0dip"
            android:layout_marginRight="100.0dip"
            android:layout_alignParentTop="true">
            <LinearLayout
                android:layout_gravity="left"
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <LinearLayout
                    android:gravity="bottom|center|left"
                    android:id="@id/llayoutid_01"
                    android:paddingTop="22.0dip"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="46.0dip">
                    <TextView
                        android:textSize="22.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:gravity="center|left"
                        android:id="@id/txt_title"
                        android:layout_width="wrap_content"
                        android:layout_height="30.0dip"
                        android:text="@string/provisioning_nonself_sent" />
                    <TextView
                        android:textSize="22.0dip"
                        android:textColor="@color/ics_orange_font_color"
                        android:gravity="center|left"
                        android:id="@id/phoneNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10.0dip"
                        android:layout_marginRight="12.0dip"
                        android:text="+919538913769"
                        android:layout_weight="1.0" />
                    <ImageView
                        android:id="@id/change_phone_no"
                        android:background="@drawable/list_round_more_arrow_selector"
                        android:duplicateParentState="true"
                        android:layout_width="20.0dip"
                        android:layout_height="20.0dip" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="bottom|center|left"
                    android:orientation="horizontal"
                    android:id="@id/llayoutid_02"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="35.0dip">
                    <TextView
                        android:textSize="22.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:id="@id/txtRegistName_0"
                        android:layout_width="wrap_content"
                        android:layout_height="26.0dip"
                        android:text="@string/new_provisioning_verification_code" />
                    <EditText
                        android:id="@id/vCode"
                        android:layout_width="fill_parent"
                        android:layout_height="47.0dip"
                        android:layout_marginLeft="14.0dip"
                        android:singleLine="true"
                        android:maxLength="4"
                        android:inputType="number"
                        android:imeOptions="actionNone" />
                </LinearLayout>
                <TextView
                    android:textSize="16.399994dip"
                    android:textColor="@color/ics_main_font_color_2"
                    android:id="@id/verification_explain_text"
                    android:layout_width="fill_parent"
                    android:layout_height="44.0dip"
                    android:layout_marginTop="21.0dip"
                    android:text="@string/new_provisioning_verification_explain" />
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:layout_weight="1.0">
                    <Button
                        android:enabled="true"
                        android:textSize="22.0dip"
                        android:layout_gravity="center"
                        android:id="@id/reSend"
                        android:background="@drawable/btn_disclaimer_bg_xml"
                        android:layout_width="fill_parent"
                        android:layout_height="57.0dip"
                        android:text="@string/view_send_sms"
                        android:layout_weight="1.0" />
                    <Button
                        android:enabled="true"
                        android:textSize="22.0dip"
                        android:layout_gravity="center"
                        android:id="@id/btnRegiACS"
                        android:background="@drawable/btn_disclaimer_bg_xml"
                        android:layout_width="fill_parent"
                        android:layout_height="57.0dip"
                        android:text="@string/regist_acs_button"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="bottom|center|left"
                    android:orientation="vertical"
                    android:id="@id/llayoutid_03"
                    android:layout_width="fill_parent"
                    android:layout_height="90.0dip"
                    android:layout_marginTop="8.0dip">
                    <TextView
                        android:textSize="17.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:id="@id/txtRegistName_03"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4.0dip"
                        android:text="@string/regist_having_problem" />
                    <Button
                        android:enabled="true"
                        android:textSize="22.0dip"
                        android:layout_gravity="left"
                        android:id="@id/contact_us"
                        android:background="@drawable/btn_disclaimer_bg_xml"
                        android:layout_width="fill_parent"
                        android:layout_height="57.0dip"
                        android:text="@string/contact_us" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@id/layout_done"
                android:background="@drawable/co_bg"
                android:paddingLeft="4.0dip"
                android:paddingTop="6.0dip"
                android:paddingRight="4.0dip"
                android:paddingBottom="4.0dip"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="55.0dip"
                android:layout_alignParentBottom="true">
                <Button
                    android:enabled="false"
                    android:textSize="16.0dip"
                    android:id="@id/btnDone"
                    android:background="@drawable/btn_disclaimer_bg_xml"
                    android:layout_width="wrap_content"
                    android:layout_height="48.0dip"
                    android:layout_marginLeft="64.0dip"
                    android:layout_marginRight="64.0dip"
                    android:text="@string/done"
                    android:layout_weight="1.0" />
                <Button
                    android:textSize="16.0dip"
                    android:id="@id/btnCancel"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="48.0dip"
                    android:text="@string/cancel"
                    android:layout_weight="1.0" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>