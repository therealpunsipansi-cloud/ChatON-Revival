<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/ics_main_background_color_2"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1.0">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="100.0dip"
            android:layout_marginRight="100.0dip">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:duplicateParentState="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <TextView
                        android:textSize="22.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:gravity="left"
                        android:id="@id/txt_select_country"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14.0dip"
                        android:text="@string/layout_regist_country_code" />
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@id/newSearch"
                        android:background="@drawable/provisioning_btn01"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="fill_parent"
                        android:layout_height="57.0dip"
                        android:layout_marginTop="4.0dip">
                        <TextView
                            android:textSize="22.0dip"
                            android:textStyle="bold"
                            android:textColor="@color/color_button_disable"
                            android:ellipsize="marquee"
                            android:gravity="center|left|top"
                            android:id="@id/editCountryName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12.0dip"
                            android:text="@string/layout_regist_no_country_selected"
                            android:singleLine="true" />
                        <TextView
                            android:textSize="22.0dip"
                            android:textStyle="bold"
                            android:textColor="@color/color_button_disable"
                            android:gravity="center_vertical"
                            android:id="@id/editCountryCode"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="2.0dip"
                            android:text="@string/layout_regist_code"
                            android:layout_weight="1.0" />
                        <ImageView
                            android:layout_gravity="center|right"
                            android:background="@drawable/list_round_more_arrow_selector"
                            android:duplicateParentState="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16.0dip"
                            android:layout_marginRight="9.0dip"
                            android:layout_marginBottom="15.0dip"
                            android:scaleType="fitXY" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="22.0dip"
                android:textColor="@color/ics_main_font_color_2"
                android:id="@id/txtRegist_1"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11.0dip"
                android:text="@string/regist_inputPno" />
            <com.sec.widget.EditTextWithClearButton
                android:textSize="22.0dip"
                android:id="@id/editPno"
                android:layout_width="fill_parent"
                android:layout_height="47.0dip"
                android:layout_marginTop="7.0dip"
                android:maxLength="30"
                android:inputType="number"
                android:privateImeOptions="inputType=YearDateTime_edittext"
                android:imeOptions="actionNone" />
            <TextView
                android:textSize="16.0dip"
                android:textColor="@color/ics_black_font_opacity_40"
                android:id="@id/txtRegist_2"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9.0dip"
                android:layout_marginRight="20.659973dip"
                android:text="@string/regist_select_acs_sms" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12.0dip">
                <Button
                    android:enabled="false"
                    android:id="@id/btnSMSACS"
                    android:visibility="gone"
                    android:layout_width="0.0dip"
                    android:layout_height="40.0dip"
                    android:text="@string/view_send_sms"
                    android:layout_weight="1.0" />
                <Button
                    android:enabled="false"
                    android:id="@id/btnACS"
                    android:visibility="gone"
                    android:layout_width="0.0dip"
                    android:layout_height="40.0dip"
                    android:text="@string/regist_acs_button"
                    android:layout_weight="1.0" />
                <Button
                    android:id="@id/btnGenerateIMEI"
                    android:visibility="gone"
                    android:layout_width="0.0dip"
                    android:layout_height="40.0dip"
                    android:layout_marginLeft="20.659973dip"
                    android:layout_marginRight="10.659973dip"
                    android:text="IMEI"
                    android:layout_weight="1.0" />
                <Button
                    android:id="@id/btnNSS"
                    android:visibility="gone"
                    android:layout_width="0.0dip"
                    android:layout_height="40.0dip"
                    android:layout_marginLeft="20.659973dip"
                    android:layout_marginRight="10.659973dip"
                    android:text="NSS"
                    android:layout_weight="1.0" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>