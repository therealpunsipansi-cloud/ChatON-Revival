<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/ics_main_background_color_2"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="18.0dip"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:background="@drawable/sub_title_bg_02"
        android:paddingLeft="8.0dip"
        android:layout_width="fill_parent"
        android:layout_height="40.0dip"
        android:text="@string/settings_about" />
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="340.0dip"
            android:layout_height="320.0dip"
            android:src="@drawable/setting_logo" />
        <TextView
            android:textSize="16.0dip"
            android:textColor="#ff646464"
            android:gravity="center"
            android:id="@id/setting_sina_for_china"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="37.0dip"
            android:text="@string/setting_sina_for_china"
            style="@style/ShadowTextStyle" />
        <TextView
            android:textSize="18.0dip"
            android:textColor="@color/color_palette_13"
            android:id="@id/setting_current_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:textSize="18.0dip"
            android:textColor="@color/color_palette_13"
            android:id="@id/setting_upgrade_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/list_bg"
        android:paddingBottom="30.0dip"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginTop="73.0dip">
        <Button
            android:id="@id/setting_about_btn_license"
            android:background="@drawable/bottom_button_background"
            android:layout_width="329.0dip"
            android:layout_height="40.0dip"
            android:layout_marginTop="20.0dip"
            android:text="@string/settings_license" />
        <Button
            android:id="@id/setting_about_btn1"
            android:background="@drawable/bottom_button_background"
            android:layout_width="329.0dip"
            android:layout_height="40.0dip"
            android:layout_marginTop="20.0dip"
            android:text="@string/setting_upgrade_text" />
    </LinearLayout>
</LinearLayout>