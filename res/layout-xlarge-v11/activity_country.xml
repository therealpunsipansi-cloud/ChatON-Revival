<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@null"
    android:layout_width="530.0dip"
    android:layout_height="360.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/llayout_subTitle"
        android:background="@drawable/provisioning_popup_top"
        android:layout_width="fill_parent"
        android:layout_height="56.0dip">
        <TextView
            android:textSize="22.0dip"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@id/subTitle"
            android:layout_width="0.0dip"
            android:layout_height="56.0dip"
            android:text="@string/select_country_hint"
            android:layout_weight="1.0" />
        <TextView
            android:textSize="22.0dip"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@id/subTitle_tablet"
            android:layout_width="0.0dip"
            android:layout_height="56.0dip"
            android:text="@string/select_country_hint"
            android:layout_weight="1.0" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/provisioning_popup_search"
        android:layout_width="fill_parent"
        android:layout_height="64.0dip">
        <ImageButton
            android:id="@id/buttonAdd"
            android:visibility="gone"
            android:layout_width="41.329987dip"
            android:layout_height="41.329987dip"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="2.0dip"
            android:layout_weight="0.0" />
        <com.sec.widget.EditTextWithClearButton
            android:textColor="@color/brown_color_002"
            android:gravity="center_vertical"
            android:id="@id/editCountry"
            android:background="@drawable/btn_search_dialog_xml"
            android:layout_width="480.0dip"
            android:layout_height="50.0dip"
            android:layout_marginLeft="19.0dip"
            android:layout_marginTop="14.0dip"
            android:layout_marginRight="22.0dip"
            android:layout_marginBottom="14.0dip"
            android:hint="@string/select_country_hint"
            android:singleLine="true"
            android:maxLength="30"
            android:editable="true"
            android:layout_weight="1.0"
            android:imeOptions="actionDone" />
    </LinearLayout>
    <ListView
        android:id="@android:id/list"
        android:background="@color/ics_main_background_color_2"
        android:layout_width="508.0dip"
        android:layout_height="0.0dip"
        android:divider="@drawable/provisioning_popup_line"
        android:layout_weight="1.0" />
    <TextView
        android:textSize="18.0dip"
        android:textStyle="bold"
        android:textColor="#ffefad51"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@id/country_list_no_search_result"
        android:background="@color/ics_main_background_color_2"
        android:visibility="gone"
        android:layout_width="508.0dip"
        android:layout_height="fill_parent"
        android:text="@string/no_results"
        android:singleLine="true" />
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:background="@drawable/co_bg"
        android:paddingLeft="4.0dip"
        android:paddingTop="6.0dip"
        android:paddingRight="4.0dip"
        android:paddingBottom="4.0dip"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="53.0dip">
        <Button
            android:textSize="18.0dip"
            android:layout_gravity="center_vertical"
            android:id="@id/buttonSelect"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4.0dip"
            android:layout_marginRight="2.0dip"
            android:text="@string/done"
            android:layout_weight="1.0"
            android:onClick="onClick" />
        <Button
            android:textSize="18.0dip"
            android:layout_gravity="center_vertical"
            android:id="@id/buttonCancel"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2.0dip"
            android:layout_marginRight="4.0dip"
            android:text="@string/cancel"
            android:layout_weight="1.0"
            android:onClick="onClick" />
    </LinearLayout>
</LinearLayout>