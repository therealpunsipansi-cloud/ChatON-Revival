<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/ams_toolbar_menu_popup_02"
        android:paddingLeft="10.0dip"
        android:paddingTop="16.0dip"
        android:paddingRight="10.0dip"
        android:paddingBottom="13.0dip"
        android:layout_width="@dimen/ams_ics2_tool_pen_popup_width"
        android:layout_height="@dimen/ams_ics2_tool_pen_popup_height"
        android:layout_marginTop="@dimen/ams_ics2_tool_popup_margin_top">
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="@dimen/ams_ics2_tool_pen_popup_title_height">
            <TextView
                android:textSize="22.0sp"
                android:textColor="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15.0dip"
                android:text="@string/ams_tool_pen"
                android:shadowColor="#ff000000"
                android:shadowDx="0.0"
                android:shadowDy="-1.0"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true" />
            <ImageView
                android:id="@id/btn_close_popup"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="18.0dip"
                android:src="@drawable/ams_ics2_selector_tool_popup_close"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/ams_ics2_tool_pen_popup_body_height">
            <LinearLayout
                android:orientation="horizontal"
                android:paddingLeft="13.0dip"
                android:paddingTop="15.0dip"
                android:paddingRight="14.0dip"
                android:paddingBottom="14.0dip"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/ams_ics2_tool_pen_popup_pen_style">
                <ImageView
                    android:id="@id/btn_pen_style1"
                    android:src="@drawable/toolbar_pen_01"
                    style="@style/AMSIcs2ToolPopupMenuButtonStyle" />
                <ImageView
                    android:layout_width="9.0dip"
                    android:layout_height="fill_parent" />
                <ImageView
                    android:id="@id/btn_pen_style2"
                    android:src="@drawable/toolbar_pen_02"
                    style="@style/AMSIcs2ToolPopupMenuButtonStyle" />
                <ImageView
                    android:layout_width="9.0dip"
                    android:layout_height="fill_parent" />
                <ImageView
                    android:id="@id/btn_pen_style3"
                    android:src="@drawable/toolbar_pen_03"
                    style="@style/AMSIcs2ToolPopupMenuButtonStyle" />
                <ImageView
                    android:layout_width="9.0dip"
                    android:layout_height="fill_parent" />
                <ImageView
                    android:id="@id/btn_pen_style4"
                    android:src="@drawable/toolbar_pen_04"
                    style="@style/AMSIcs2ToolPopupMenuButtonStyle" />
            </LinearLayout>
            <ImageView
                android:background="@drawable/ams_toolbar_menu_popup_line"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="13.0dip"
                android:layout_marginRight="14.0dip" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/ams_ics2_tool_pen_popup_pen_size"
                android:layout_marginLeft="9.0dip"
                android:layout_marginRight="16.0dip"
                android:weightSum="321.0">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_weight="261.0">
                    <SeekBar
                        android:id="@id/seekbar_pen_size"
                        android:paddingLeft="15.0dip"
                        android:paddingRight="15.0dip"
                        android:focusable="true"
                        android:layout_width="fill_parent"
                        android:layout_height="32.0dip"
                        android:maxHeight="15.0dip"
                        android:progressDrawable="@drawable/ams_ics2_seekbar_pen_size"
                        android:minHeight="15.0dip"
                        android:thumb="@drawable/ams_ics2_selector_thumb_pen_size"
                        android:thumbOffset="15.0dip"
                        android:layout_centerInParent="true"
                        style="?android:progressBarStyleHorizontal" />
                </LinearLayout>
                <RelativeLayout
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_weight="60.0">
                    <RelativeLayout
                        android:background="@drawable/ams_stroke_option_01"
                        android:layout_width="54.0dip"
                        android:layout_height="54.0dip"
                        android:layout_centerInParent="true">
                        <ImageView
                            android:id="@id/iv_pen_stroke_preview"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:scaleType="fitCenter" />
                    </RelativeLayout>
                </RelativeLayout>
            </LinearLayout>
            <ImageView
                android:background="@drawable/ams_toolbar_menu_popup_line"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="13.0dip"
                android:layout_marginRight="14.0dip" />
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="@dimen/ams_ics2_tool_pen_popup_pen_color">
                <ViewStub
                    android:id="@id/stub_pen_color"
                    android:layout="@layout/ams_ics2_layout_tool_color"
                    android:inflatedId="@id/color_property"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>