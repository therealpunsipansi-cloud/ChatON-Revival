<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/ams_toolbar_menu_popup_02"
        android:paddingLeft="10.0dip"
        android:paddingTop="16.0dip"
        android:paddingRight="10.0dip"
        android:paddingBottom="13.0dip"
        android:layout_width="@dimen/ams_ics2_tool_text_popup_width"
        android:layout_height="@dimen/ams_ics2_tool_text_popup_height"
        android:layout_marginTop="@dimen/ams_ics2_tool_popup_margin_top">
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="@dimen/ams_ics2_tool_text_popup_title_height">
            <TextView
                android:textSize="22.0sp"
                android:textColor="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15.0dip"
                android:text="@string/ams_title_text"
                android:shadowColor="#ff000000"
                android:shadowDx="0.0"
                android:shadowDy="-1.0"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true" />
            <ImageView
                android:id="@id/btn_close_popup"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="18.0dip"
                android:src="@drawable/ams_ics2_selector_tool_popup_close"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/ams_ics2_tool_text_popup_body_height">
            <LinearLayout
                android:orientation="horizontal"
                android:paddingLeft="13.0dip"
                android:paddingTop="15.0dip"
                android:paddingRight="14.0dip"
                android:paddingBottom="14.0dip"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/ams_ics2_tool_text_popup_text_size">
                <ImageView
                    android:id="@id/btn_text_size1"
                    android:src="@drawable/ams_ics2_selector_text_size1"
                    style="@style/AMSIcs2ToolPopupMenuButtonStyle" />
                <ImageView
                    android:layout_width="9.0dip"
                    android:layout_height="fill_parent" />
                <ImageView
                    android:id="@id/btn_text_size2"
                    android:src="@drawable/ams_ics2_selector_text_size2"
                    style="@style/AMSIcs2ToolPopupMenuButtonStyle" />
                <ImageView
                    android:layout_width="9.0dip"
                    android:layout_height="fill_parent" />
                <ImageView
                    android:id="@id/btn_text_size3"
                    android:src="@drawable/ams_ics2_selector_text_size3"
                    style="@style/AMSIcs2ToolPopupMenuButtonStyle" />
                <ImageView
                    android:layout_width="9.0dip"
                    android:layout_height="fill_parent" />
                <ImageView
                    android:id="@id/btn_text_size4"
                    android:src="@drawable/ams_ics2_selector_text_size4"
                    style="@style/AMSIcs2ToolPopupMenuButtonStyle" />
                <ImageView
                    android:layout_width="9.0dip"
                    android:layout_height="fill_parent" />
                <ImageView
                    android:id="@id/btn_text_size5"
                    android:src="@drawable/ams_ics2_selector_text_size5"
                    style="@style/AMSIcs2ToolPopupMenuButtonStyle" />
            </LinearLayout>
            <ImageView
                android:background="@drawable/ams_toolbar_menu_popup_line"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="13.0dip"
                android:layout_marginRight="14.0dip" />
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="@dimen/ams_ics2_tool_text_popup_text_color">
                <ViewStub
                    android:id="@id/stub_text_color"
                    android:layout="@layout/ams_ics2_layout_tool_color"
                    android:inflatedId="@id/color_property"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>