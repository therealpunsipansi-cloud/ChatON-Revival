<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="center"
    android:padding="3.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/layout_frame"
        android:background="@drawable/ams_ics_selector_basic_tool_frame"
        android:layout_width="180.0dip"
        android:layout_height="180.0dip"
        android:layout_centerInParent="true">
        <LinearLayout
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:id="@id/image_frame"
                android:layout_width="176.0dip"
                android:layout_height="176.0dip"
                android:scaleType="fitCenter" />
        </LinearLayout>
        <LinearLayout
            android:id="@id/layout_add"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:background="#ff000000"
                android:layout_width="176.0dip"
                android:layout_height="176.0dip"
                android:src="@drawable/ams_add"
                android:scaleType="center" />
        </LinearLayout>
        <LinearLayout
            android:id="@id/layout_none"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="22.0sp"
                android:textColor="#80ffffff"
                android:gravity="center"
                android:background="#ff000000"
                android:layout_width="176.0dip"
                android:layout_height="176.0dip"
                android:text="@string/ams_strarr_effect_image_01" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>