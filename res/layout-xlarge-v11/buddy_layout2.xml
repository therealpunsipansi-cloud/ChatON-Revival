<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/buddy_layout_main"
    android:background="@drawable/list_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip" />
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@id/honeycomb_bar"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="62.0dip"
        android:layout_alignParentTop="true">
        <ImageButton
            android:id="@id/chatprofile_menu_back"
            android:background="@drawable/btn_default"
            android:visibility="visible"
            android:layout_width="55.0dip"
            android:layout_height="40.0dip"
            android:layout_marginLeft="14.0dip"
            android:layout_marginTop="6.0dip"
            android:src="@drawable/chat_profile_back" />
        <TextView
            android:textSize="18.0dip"
            android:textStyle="bold"
            android:textColor="@color/color_palette_13"
            android:id="@id/honeycomb_title"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5.0dip"
            android:layout_marginTop="13.5dip"
            android:text="@string/buddy_chat_profile"
            android:layout_toRightOf="@id/chatprofile_menu_back" />
        <ImageButton
            android:id="@id/chatprofile_menu_invite"
            android:background="@drawable/btn_default"
            android:visibility="visible"
            android:layout_width="55.0dip"
            android:layout_height="40.0dip"
            android:layout_marginTop="6.0dip"
            android:layout_marginRight="14.0dip"
            android:src="@drawable/buddy_list_menu_button_xml"
            android:layout_alignParentRight="true" />
    </RelativeLayout>
    <TextView
        android:textSize="14.0dip"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@id/title_menu"
        android:background="@drawable/co_title_bar"
        android:paddingLeft="7.299988dip"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="25.329987dip"
        android:text="@string/buddy_chat_profile"
        android:layout_below="@id/honeycomb_bar" />
    <com.sec.widget.ChoicePanel
        android:id="@id/buddy_choice_select_member_panel"
        android:background="@drawable/buddy_name_bg"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutChatButtons">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:padding="2.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </com.sec.widget.ChoicePanel>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@id/searcdh_bar"
        android:background="@drawable/searchfiled_background_bg"
        android:layout_width="fill_parent"
        android:layout_height="76.0dip"
        android:layout_below="@id/buddy_choice_select_member_panel">
        <com.sec.widget.EditTextWithClearButton
            android:textColor="@color/buddylist_search_edittext_text_color"
            android:gravity="center_vertical"
            android:id="@id/buddy_search"
            android:background="@drawable/btn_search_dialog_xml"
            android:layout_width="fill_parent"
            android:layout_height="50.0dip"
            android:layout_marginLeft="7.0dip"
            android:layout_marginTop="12.0dip"
            android:layout_marginRight="6.0dip"
            android:layout_marginBottom="14.0dip"
            android:hint="@string/buddy_list_search_hint"
            android:singleLine="true"
            android:maxLength="30"
            android:editable="true"
            android:layout_weight="1.0"
            android:imeOptions="actionDone" />
        <FrameLayout
            android:id="@id/layout_suggestion"
            android:layout_width="54.0dip"
            android:layout_height="76.0dip"
            android:layout_marginTop="13.0dip"
            android:layout_marginBottom="15.0dip">
            <ImageButton
                android:layout_gravity="center|left"
                android:id="@id/buddylist_add_buddy_button"
                android:background="@drawable/buddylist_add_buddy_button"
                android:visibility="gone"
                android:layout_width="46.0dip"
                android:layout_height="46.0dip" />
            <TextView
                android:textSize="13.0sp"
                android:textStyle="bold"
                android:textColor="@color/ics_main_font_color_2"
                android:gravity="center"
                android:layout_gravity="center|right|top"
                android:id="@id/buddy_suggestion_badge"
                android:background="@drawable/tab_icon_notification"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="11.0dip"
                android:layout_marginTop="5.0dip"
                android:layout_marginRight="3.0dip"
                android:shadowColor="#7fffffff"
                android:shadowDx="1.0"
                android:shadowDy="1.0"
                android:shadowRadius="1.0" />
        </FrameLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@id/chat_title_bar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="64.0dip"
            android:layout_weight="1.0">
            <com.sec.widget.EditTextWithClearButton
                android:textSize="22.0dip"
                android:textColor="@color/buddylist_search_edittext_text_color"
                android:gravity="center_vertical"
                android:id="@id/edit_title"
                android:background="@drawable/btn_search_dialog_xml"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="40.0dip"
                android:layout_marginLeft="13.0dip"
                android:layout_marginTop="8.0dip"
                android:layout_marginRight="14.0dip"
                android:layout_marginBottom="6.0dip"
                android:singleLine="true"
                android:maxLength="30"
                android:editable="true"
                android:layout_weight="1.0"
                android:layout_toLeftOf="@id/buddy_menu_save"
                android:imeOptions="actionDone" />
            <EditText
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@id/tmp_title"
                android:visibility="visible"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:editable="true"
                android:imeOptions="actionDone" />
            <Button
                android:enabled="false"
                android:textSize="16.0dip"
                android:id="@id/buddy_menu_save"
                android:visibility="gone"
                android:layout_width="125.0dip"
                android:layout_height="41.0dip"
                android:layout_marginTop="7.0dip"
                android:layout_marginRight="14.0dip"
                android:text="@string/done"
                android:layout_alignParentRight="true" />
        </RelativeLayout>
        <EditText
            android:textSize="14.0dip"
            android:textColor="@color/brown_color_002"
            android:gravity="center_vertical"
            android:id="@id/chat_title"
            android:background="@drawable/btn_search_dialog_xml"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="42.69998dip"
            android:layout_marginLeft="10.659973dip"
            android:layout_marginTop="6.0dip"
            android:layout_marginRight="10.699982dip"
            android:layout_marginBottom="6.0dip"
            android:singleLine="true"
            android:editable="true"
            android:layout_weight="1.0"
            android:imeOptions="actionDone" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@id/select_all_bar"
        android:background="@drawable/buddy_name_bg"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/searcdh_bar">
        <TextView
            android:textSize="18.0dip"
            android:textColor="@color/color_text_black"
            android:id="@id/selected_buddy_count"
            android:paddingLeft="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.0dip"
            android:singleLine="true" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/lLayoutProfile"
        android:background="@drawable/messenger_info_bg"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/LinearLayout01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <com.revived.chaton.util.EllipsisTextView
                android:textSize="16.0dip"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@id/textNames"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="13.0dip"
                android:layout_marginTop="5.0dip"
                android:maxLines="2"
                android:lines="2" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/buddy_list_layout"
        android:visibility="invisible"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/select_all_bar">
        <com.sec.widget.FastScrollableExpandableListView
            android:id="@id/buddy_list"
            android:background="@null"
            android:scrollbars="none"
            android:fadingEdge="vertical"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:listSelector="#00000000"
            android:scrollingCache="false"
            android:groupIndicator="@null"
            android:childDivider="@drawable/list_2line"
            android:layout_weight="1.0" />
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@id/buddy_list_noresult_layout"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="0.0">
            <TextView
                android:textSize="18.0dip"
                android:textStyle="bold"
                android:textColor="#ffefad51"
                android:ellipsize="marquee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="100.0dip"
                android:text="@string/buddy_list_search_noresult"
                android:singleLine="true" />
        </LinearLayout>
        <LinearLayout
            android:id="@id/buddy_menu_bar"
            android:background="@drawable/winset_softkey_bg"
            android:layout_width="fill_parent"
            android:layout_height="59.0dip"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginLeft="4.0dip"
                android:layout_marginTop="6.299988dip"
                android:layout_marginRight="4.0dip"
                android:layout_marginBottom="2.5999756dip">
                <Button
                    android:enabled="false"
                    android:textSize="16.0dip"
                    android:id="@id/buddy_menu_group_chat"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginRight="0.70000005dip"
                    android:text="@string/done"
                    android:layout_weight="1.0" />
                <Button
                    android:enabled="false"
                    android:textSize="16.0dip"
                    android:id="@id/buddy_menu_broadcast"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginRight="1.2999878dip"
                    android:text="@string/done"
                    android:layout_weight="1.0" />
                <Button
                    android:textSize="16.0dip"
                    android:id="@id/buddy_menu_invite"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginRight="1.2999878dip"
                    android:text="@string/done"
                    android:layout_weight="1.0" />
                <Button
                    android:enabled="false"
                    android:textSize="16.0dip"
                    android:id="@id/buddy_menu_add_group"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginRight="0.70000005dip"
                    android:text="@string/done"
                    android:layout_weight="1.0" />
                <Button
                    android:textSize="16.0dip"
                    android:id="@id/buddy_menu_blind_memo"
                    android:background="@drawable/buddyprofile_chat_button_xml"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginRight="1.2999878dip"
                    android:text="@string/done"
                    android:layout_weight="1.0" />
                <Button
                    android:enabled="false"
                    android:textSize="16.0dip"
                    android:id="@id/buddy_menu_voice_call"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginRight="1.2999878dip"
                    android:text="@string/done"
                    android:layout_weight="1.0" />
                <Button
                    android:enabled="false"
                    android:textSize="16.0dip"
                    android:id="@id/buddy_menu_video_call"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginRight="1.2999878dip"
                    android:text="@string/done"
                    android:layout_weight="1.0" />
                <Button
                    android:textSize="16.0dip"
                    android:id="@id/buddy_menu_cancel"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginRight="0.70000005dip"
                    android:text="@string/buddy_list_menubar_cancel"
                    android:layout_weight="1.0" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/tell_friends_layout"
        android:visibility="invisible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/searcdh_bar">
        <LinearLayout
            android:background="@drawable/list_divider_holo_dark"
            android:layout_width="fill_parent"
            android:layout_height="1.0dip" />
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="75.0dip">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:background="@drawable/thumb_default_line"
                android:layout_width="58.0dip"
                android:layout_height="58.0dip"
                android:layout_marginLeft="14.0dip"
                android:layout_marginRight="10.0dip">
                <com.revived.chaton.widget.RoundedImageView
                    android:background="@drawable/profile_noimage"
                    android:layout_width="56.0dip"
                    android:layout_height="56.0dip" />
            </LinearLayout>
            <TextView
                android:textSize="22.0dip"
                android:textColor="@color/ics_main_font_color_2"
                android:layout_gravity="center_vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="14.0dip"
                android:text="@string/buddy_list_tell_friends_info" />
        </LinearLayout>
        <ImageView
            android:background="@drawable/list_2line"
            android:layout_width="fill_parent"
            android:layout_height="2.0dip" />
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="60.0dip"
            android:layout_marginTop="8.0dip">
            <Button
                android:textSize="22.0dip"
                android:gravity="center"
                android:id="@id/add_buddies_button"
                android:layout_width="fill_parent"
                android:layout_height="52.0dip"
                android:layout_marginLeft="48.0dip"
                android:layout_marginRight="49.0dip"
                android:text="@string/buddy_profile_button_addbuddy" />
        </LinearLayout>
    </LinearLayout>
    <ListView
        android:id="@id/more_option_list_group_profile"
        android:background="@drawable/more_option_bg"
        android:visibility="gone"
        android:layout_width="270.0dip"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true" />
</RelativeLayout>