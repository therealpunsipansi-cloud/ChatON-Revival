<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/list_header"
    android:background="@color/ics_main_background_color_2"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/ics_main_background_color"
        android:layout_width="fill_parent"
        android:layout_height="130.0dip"
        android:layout_weight="0.0">
        <LinearLayout
            android:layout_width="100.0dip"
            android:layout_height="100.0dip"
            android:layout_marginLeft="14.0dip"
            android:layout_marginTop="14.0dip">
            <com.revived.chaton.widget.RoundedImageView
                android:id="@id/profile_image"
                android:layout_width="100.0dip"
                android:layout_height="100.0dip"
                android:scaleType="fitXY" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30.0dip">
                <TextView
                    android:textSize="32.0dip"
                    android:textColor="@color/ics_buddy_profile_name"
                    android:ellipsize="marquee"
                    android:layout_gravity="top"
                    android:id="@id/profile_name"
                    android:layout_width="180.0dip"
                    android:layout_height="43.0dip"
                    android:text=""
                    android:singleLine="true" />
                <TextView
                    android:textSize="16.0dip"
                    android:textColor="@color/ics_buddy_profile_status"
                    android:ellipsize="marquee"
                    android:layout_gravity="top"
                    android:id="@id/profile_status_message"
                    android:layout_width="180.0dip"
                    android:layout_height="22.0dip"
                    android:layout_marginTop="10.0dip"
                    android:text=""
                    android:maxLines="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <CheckBox
                    android:gravity="left"
                    android:id="@id/profile_is_favorite"
                    android:layout_width="38.0dip"
                    android:layout_height="42.0dip"
                    android:layout_marginLeft="12.0dip"
                    android:layout_marginTop="32.0dip"
                    android:button="@drawable/buddyprofile_favorite_btn_xml" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="right"
            android:layout_gravity="center|right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="18.0dip">
            <ImageButton
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@id/profile_chat"
                android:background="@drawable/btn_search_dialog_voice_xml"
                android:layout_width="94.0dip"
                android:layout_height="72.0dip"
                android:layout_marginLeft="9.0dip"
                android:layout_marginRight="9.0dip"
                android:src="@drawable/buddyprofile_chat_xml" />
            <ImageButton
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@id/profile_call"
                android:background="@drawable/btn_search_dialog_voice_xml"
                android:layout_width="94.0dip"
                android:layout_height="72.0dip"
                android:layout_marginRight="9.0dip"
                android:src="@drawable/buddyprofile_call_3g_xml" />
            <ImageButton
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@id/profile_contact"
                android:background="@drawable/btn_search_dialog_voice_xml"
                android:layout_width="94.0dip"
                android:layout_height="72.0dip"
                android:layout_marginRight="9.0dip"
                android:src="@drawable/buddyprofile_contact_xml" />
            <ImageButton
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@id/profile_voice_call"
                android:background="@drawable/btn_search_dialog_voice_xml"
                android:layout_width="94.0dip"
                android:layout_height="72.0dip"
                android:layout_marginRight="9.0dip"
                android:src="@drawable/buddyprofile_call_xml" />
            <ImageButton
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@id/profile_video_call"
                android:background="@drawable/btn_search_dialog_voice_xml"
                android:layout_width="94.0dip"
                android:layout_height="72.0dip"
                android:src="@drawable/buddyprofile_videocall_xml" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="200.0dip"
        android:layout_marginTop="12.0dip"
        android:layout_marginBottom="12.0dip">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="50.0dip">
            <TextView
                android:textSize="26.0dip"
                android:textColor="#ffffffff"
                android:layout_width="238.0dip"
                android:layout_height="50.0dip"
                android:layout_marginLeft="18.0dip"
                android:text="@string/buddy_profile_chaton" />
            <TextView
                android:textSize="22.0dip"
                android:textColor="#ffa6a6a6"
                android:id="@id/profile_phone_no"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                android:text=" " />
        </LinearLayout>
        <ImageView
            android:background="@drawable/list_2line"
            android:layout_width="fill_parent"
            android:layout_height="2.0dip"
            android:layout_marginLeft="10.0dip"
            android:layout_marginRight="10.0dip" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="50.0dip">
            <TextView
                android:textSize="26.0dip"
                android:textColor="#ffffffff"
                android:ellipsize="marquee"
                android:layout_width="238.0dip"
                android:layout_height="50.0dip"
                android:layout_marginLeft="18.0dip"
                android:text="@string/buddy_profile_birthday"
                android:singleLine="true" />
            <TextView
                android:textSize="22.0dip"
                android:textColor="#ffa6a6a6"
                android:id="@id/profile_birthday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                android:text=" " />
            <ImageView
                android:layout_gravity="center|right"
                android:id="@id/profile_calendar"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="34.0dip"
                android:layout_marginLeft="18.0dip"
                android:layout_marginRight="18.0dip"
                android:src="@drawable/buddyprofile_add_event_xml" />
        </LinearLayout>
        <ImageView
            android:background="@drawable/list_2line"
            android:layout_width="fill_parent"
            android:layout_height="2.0dip"
            android:layout_marginLeft="10.0dip"
            android:layout_marginRight="10.0dip" />
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="47.0dip"
            android:layout_marginLeft="18.0dip">
            <TextView
                android:textSize="26.0dip"
                android:textColor="#ffffffff"
                android:ellipsize="marquee"
                android:gravity="center_vertical"
                android:layout_width="238.0dip"
                android:layout_height="fill_parent"
                android:text="@string/buddy_profile_interaction"
                android:singleLine="true" />
            <TextView
                android:textSize="22.0dip"
                android:textColor="#ffa6a6a6"
                android:gravity="center_vertical"
                android:id="@id/profile_relationship_status"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:text="Rank 5 / Point 400" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@id/interaction_point_bar_layout"
            android:layout_width="fill_parent"
            android:layout_height="58.0dip"
            android:layout_marginLeft="16.0dip"
            android:layout_marginRight="16.0dip"
            android:layout_marginBottom="0.0dip"
            android:baselineAligned="false">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/interaction_left"
                android:background="@drawable/interaction_rank_01"
                android:paddingRight="10.0dip"
                android:layout_width="wrap_content"
                android:layout_height="30.0dip"
                android:scaleType="fitXY"
                android:layout_weight="1.0">
                <TextView
                    android:textSize="18.0sp"
                    android:textColor="#ff513d2b"
                    android:gravity="center_vertical"
                    android:id="@id/interaction_buddy_point"
                    android:layout_width="82.0dip"
                    android:layout_height="fill_parent"
                    android:layout_marginLeft="6.0dip"
                    android:text="@string/buddy_profile_interaction_buddy" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/interaction_right"
                android:background="@drawable/interaction_rank_02"
                android:paddingLeft="10.0dip"
                android:layout_width="wrap_content"
                android:layout_height="30.0dip"
                android:scaleType="fitXY"
                android:layout_weight="1.0">
                <TextView
                    android:textSize="18.0sp"
                    android:textColor="#ff513d2b"
                    android:gravity="center|right"
                    android:id="@id/interaction_me_point"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginRight="6.0dip"
                    android:text="@string/buddy_profile_interaction_me" />
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:background="#ff333a3a"
            android:layout_width="fill_parent"
            android:layout_height="0.30000007dip" />
        <LinearLayout
            android:background="@color/ics_main_background_color_2"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18.0dip"
                android:textColor="#ff787878"
                android:gravity="center"
                android:id="@id/interaction_no_point_bar_layout"
                android:visibility="visible"
                android:layout_width="fill_parent"
                android:layout_height="33.0dip"
                android:layout_marginLeft="15.0dip"
                android:layout_marginRight="15.0dip"
                android:text="@string/buddy_profile_interaction_no_point" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="18.0dip"
        android:textStyle="bold"
        android:textColor="#ffd2dfe0"
        android:gravity="center_vertical"
        android:id="@id/memo_layout_title"
        android:background="@drawable/buddyprofile_buddysay_title_xml"
        android:paddingLeft="13.0dip"
        android:clickable="true"
        android:layout_width="fill_parent"
        android:layout_height="40.0dip"
        android:layout_marginTop="0.0dip"
        android:layout_marginBottom="0.0dip"
        android:text="@string/memo_title" />
    <LinearLayout
        android:id="@id/profile_write_area"
        android:background="@color/ics_main_background_color"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginBottom="0.0dip">
        <Button
            android:gravity="center"
            android:id="@id/memo_btn_write"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:text="@string/memo_btn_write"
            style="@style/ChatONDefaultButton" />
    </LinearLayout>
    <ImageView
        android:id="@id/memo_write_below_line"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="1.0dip" />
</LinearLayout>