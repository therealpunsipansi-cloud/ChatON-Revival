<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/ics_main_background_color_2"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/buddy_profile_llayout"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/list_header"
            android:background="@color/ics_main_background_color_2"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/profile_header_layout"
                android:background="@color/ics_main_background_color_2"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14.0dip"
                android:layout_marginTop="10.0dip"
                android:layout_marginRight="14.0dip"
                android:layout_marginBottom="10.0dip"
                android:layout_weight="0.0">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10.0dip"
                    android:layout_marginBottom="5.0dip"
                    android:layout_weight="1.0">
                    <com.sec.chaton.widget.RoundedImageView
                        android:id="@id/profile_image"
                        android:layout_width="100.0dip"
                        android:layout_height="100.0dip"
                        android:scaleType="fitXY" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10.0dip"
                        android:layout_weight="1.0">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="36.0dip"
                                android:textColor="@color/ics_main_font_color_2"
                                android:ellipsize="end"
                                android:id="@id/profile_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:layout_weight="1.0" /> android:textSize="36dip" />
<CheckBox
                                android:id="@id/profile_is_favorite"
                                android:focusable="true"
                                android:layout_width="38.0dip"
                                android:layout_height="42.0dip"
                                android:layout_marginLeft="12.0dip"
                                android:button="@drawable/buddyprofile_favorite_btn_xml" />
                        </LinearLayout>
                        <TextView
                            android:textSize="18.0dip"
                            android:textColor="@color/ics_buddy_profile_status"
                            android:ellipsize="end"
                            android:id="@id/profile_status_message"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10.0dip"
                            android:maxLines="2" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center|left"
                    android:orientation="horizontal"
                    android:background="@color/ics_main_background_color_2"
                    android:scrollbars="horizontal"
                    android:layout_width="300.0dip"
                    android:layout_height="72.0dip">
                    <ImageButton
                        android:layout_gravity="center"
                        android:id="@id/profile_chat"
                        android:background="@drawable/btn_search_dialog_voice_xml"
                        android:focusable="true"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="9.0dip"
                        android:src="@drawable/buddyprofile_chat_xml"
                        android:scaleType="center"
                        android:layout_weight="1.0"
                        android:contentDescription="@string/dialog_header_text" />
                    <ImageButton
                        android:layout_gravity="center"
                        android:id="@id/profile_call"
                        android:background="@drawable/btn_search_dialog_voice_xml"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="9.0dip"
                        android:src="@drawable/buddyprofile_call_3g_xml"
                        android:scaleType="center"
                        android:layout_weight="1.0"
                        android:contentDescription="@string/menu_call" />
                    <ImageButton
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@id/profile_contact"
                        android:background="@drawable/btn_search_dialog_voice_xml"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="9.0dip"
                        android:src="@drawable/buddyprofile_contact_xml"
                        android:scaleType="center"
                        android:layout_weight="1.0"
                        android:contentDescription="@string/menu_button_contact" />
                    <ImageButton
                        android:layout_gravity="center"
                        android:id="@id/profile_voice_call"
                        android:background="@drawable/btn_search_dialog_voice_xml"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="9.0dip"
                        android:src="@drawable/buddyprofile_call_xml"
                        android:scaleType="center"
                        android:layout_weight="1.0"
                        android:contentDescription="@string/menu_button_voice_call" />
                    <ImageButton
                        android:layout_gravity="center"
                        android:id="@id/profile_video_call"
                        android:background="@drawable/btn_search_dialog_voice_xml"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="9.0dip"
                        android:src="@drawable/buddyprofile_videocall_xml"
                        android:scaleType="center"
                        android:layout_weight="1.0"
                        android:layout_alignParentRight="true"
                        android:contentDescription="@string/menu_video_call" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="50.0dip">
                    <TextView
                        android:textSize="22.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:gravity="center_vertical"
                        android:layout_width="168.0dip"
                        android:layout_height="50.0dip"
                        android:layout_marginLeft="18.0dip"
                        android:text="@string/buddy_profile_chaton" />
                    <TextView
                        android:textSize="18.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:gravity="center_vertical"
                        android:id="@id/profile_phone_no"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text=" " />
                </LinearLayout>
                <ImageView
                    android:background="@drawable/list_2line"
                    android:layout_width="fill_parent"
                    android:layout_height="2.0dip"
                    android:layout_marginLeft="10.0dip"
                    android:layout_marginRight="10.0dip" />
                <RelativeLayout
                    android:orientation="horizontal"
                    android:id="@id/layout_birthday"
                    android:layout_width="fill_parent"
                    android:layout_height="50.0dip">
                    <TextView
                        android:textSize="22.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:gravity="center_vertical"
                        android:id="@id/birthday_string"
                        android:layout_width="168.0dip"
                        android:layout_height="50.0dip"
                        android:layout_marginLeft="18.0dip"
                        android:text="@string/buddy_profile_birthday" />
                    <TextView
                        android:textSize="18.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:gravity="center_vertical"
                        android:id="@id/profile_birthday"
                        android:layout_width="168.0dip"
                        android:layout_height="fill_parent"
                        android:text=" "
                        android:layout_toRightOf="@id/birthday_string" />
                    <Button
                        android:id="@id/profile_calendar"
                        android:background="@drawable/btn_buddies_say"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10.0dip"
                        android:layout_marginRight="14.0dip"
                        android:layout_marginBottom="10.0dip"
                        android:text="@string/edit_group_add_member"
                        android:layout_alignParentRight="true" />
                </RelativeLayout>
                <ImageView
                    android:id="@id/layout_birthday_divider"
                    android:background="@drawable/list_2line"
                    android:layout_width="fill_parent"
                    android:layout_height="2.0dip"
                    android:layout_marginLeft="10.0dip"
                    android:layout_marginRight="10.0dip" />
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="47.0dip"
                    android:layout_marginLeft="18.0dip">
                    <TextView
                        android:textSize="22.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:gravity="center_vertical"
                        android:layout_width="168.0dip"
                        android:layout_height="fill_parent"
                        android:text="@string/buddy_profile_interaction" />
                    <TextView
                        android:textSize="18.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:gravity="center_vertical"
                        android:id="@id/profile_relationship_status"
                        android:layout_width="wrap_content"
                        android:layout_height="fill_parent"
                        android:text="Rank 5 / Point 400" />
                </LinearLayout>
                <LinearLayout
                    android:id="@id/interaction_point_bar_layout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="18.0dip"
                    android:layout_marginRight="18.0dip"
                    android:layout_marginBottom="23.0dip">
                    <LinearLayout
                        android:gravity="center|left"
                        android:orientation="horizontal"
                        android:id="@id/interaction_left"
                        android:background="@drawable/interaction_rank_01"
                        android:paddingRight="10.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"
                        android:layout_weight="1.0">
                        <TextView
                            android:textSize="18.0dip"
                            android:textStyle="bold"
                            android:textColor="#ff513d2b"
                            android:gravity="center_vertical"
                            android:id="@id/interaction_buddy_point"
                            android:layout_width="wrap_content"
                            android:layout_height="30.0dip"
                            android:layout_marginLeft="6.0dip"
                            android:text="@string/buddy_profile_interaction_buddy" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center|right"
                        android:orientation="horizontal"
                        android:id="@id/interaction_right"
                        android:background="@drawable/interaction_rank_02"
                        android:paddingLeft="10.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"
                        android:layout_weight="1.0">
                        <TextView
                            android:textSize="18.0dip"
                            android:textStyle="bold"
                            android:textColor="#ff513d2b"
                            android:gravity="center_vertical"
                            android:id="@id/interaction_me_point"
                            android:layout_width="wrap_content"
                            android:layout_height="30.0dip"
                            android:layout_marginRight="6.0dip"
                            android:text="@string/buddy_profile_interaction_me" />
                    </LinearLayout>
                </LinearLayout>
                <ImageView
                    android:background="#ff333a3a"
                    android:layout_width="fill_parent"
                    android:layout_height="0.30000007dip" />
            </LinearLayout>
            <RelativeLayout
                android:id="@id/profile_write_area"
                android:background="@drawable/buddyprofile_buddysay_title_xml"
                android:layout_width="fill_parent"
                android:layout_height="40.0dip"
                android:layout_marginBottom="0.0dip">
                <TextView
                    android:textSize="18.0dip"
                    android:textColor="@color/ams_tool_default_color_01"
                    android:gravity="center_vertical"
                    android:id="@id/memo_layout_title"
                    android:paddingLeft="14.0dip"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="40.0dip"
                    android:text="@string/memo_title" />
                <Button
                    android:gravity="center"
                    android:id="@id/memo_btn_write"
                    android:background="@drawable/sub_title_button_selector"
                    android:paddingRight="8.0dip"
                    android:visibility="gone"
                    android:layout_width="78.0dip"
                    android:layout_height="30.0dip"
                    android:layout_marginRight="12.0dip"
                    android:text="@string/memo_button_write"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>
            <ImageView
                android:id="@id/memo_write_below_line"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="1.0dip" />
        </LinearLayout>
        <RelativeLayout
            android:id="@id/RelativeLayout1"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <Button
                android:enabled="false"
                android:textSize="18.0dip"
                android:id="@id/buttonWriteText"
                android:background="@drawable/btn_buddies_say"
                android:visibility="gone"
                android:layout_width="96.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip"
                android:layout_marginRight="14.0dip"
                android:layout_marginBottom="10.0dip"
                android:text="@string/edit_group_add_member"
                android:layout_alignParentRight="true" />
            <LinearLayout
                android:id="@id/linearLayout1"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@id/buttonWriteText">
                <EditText
                    android:textSize="18.0dip"
                    android:id="@id/txtName"
                    android:background="@drawable/btn_search_dialog_xml"
                    android:paddingLeft="14.0dip"
                    android:paddingRight="14.0dip"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14.0dip"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginRight="10.0dip"
                    android:layout_marginBottom="10.0dip"
                    android:hint="@string/memo_hint"
                    android:singleLine="true"
                    android:maxLength="140"
                    android:capitalize="sentences"
                    android:imeOptions="actionUnspecified|normal"
                    android:textCursorDrawable="@null" />
            </LinearLayout>
            <ImageView
                android:id="@id/memo_below_line"
                android:background="@drawable/list_2line"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="1.0dip"
                android:layout_marginLeft="10.0dip"
                android:layout_below="@id/linearLayout1" />
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>