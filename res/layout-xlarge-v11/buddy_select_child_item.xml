<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:background="@color/ics_main_background_color"
    android:layout_width="fill_parent"
    android:layout_height="75.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <CheckBox
        android:layout_gravity="center_vertical"
        android:id="@id/buddy_select_child_check"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="32.0dip"
        android:layout_height="32.0dip"
        android:layout_marginLeft="9.0dip"
        android:layout_marginRight="8.0dip"
        android:button="@drawable/checkbox_background_xml" />
    <LinearLayout
        android:gravity="center"
        android:background="@drawable/thumb_default_line"
        android:layout_width="58.0dip"
        android:layout_height="58.0dip"
        android:layout_marginTop="9.0dip"
        android:layout_marginRight="10.0dip"
        android:layout_weight="0.0">
        <com.revived.chaton.widget.RoundedImageView
            android:layout_gravity="center_vertical"
            android:id="@id/buddy_select_child_profile"
            android:layout_width="56.0dip"
            android:layout_height="56.0dip" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginLeft="10.0dip"
        android:layout_weight="1.0">
        <TextView
            android:textSize="22.0dip"
            android:textColor="@color/white"
            android:ellipsize="marquee"
            android:id="@id/buddy_select_child_name"
