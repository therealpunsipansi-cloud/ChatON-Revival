<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/list_bg_bottom"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/buddy_select_group_name_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="50.0dip"
        android:layout_marginLeft="5.0dip"
        android:layout_marginTop="5.0dip"
        android:layout_marginRight="5.0dip"
        android:layout_marginBottom="5.0dip"
        android:layout_weight="0.0">
        <LinearLayout
            android:id="@id/buddy_select_group_name_edit_layout"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <EditText
                android:textSize="22.0dip"
                android:id="@id/buddy_select_group_name_edit"
                android:background="@drawable/edit_text"
                android:paddingLeft="12.0dip"
                android:paddingRight="12.0dip"
                android:visibility="visible"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:hint="@string/buddy_group_list_newgroup_hint"
                android:singleLine="true"
                android:maxLength="30"
                android:capitalize="sentences"
                android:layout_weight="1.0"
                android:imeOptions="actionDone"
                android:textCursorDrawable="@null" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/buddy_select_for_call_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="40.0dip"
        android:layout_marginBottom="14.0dip"
        android:layout_weight="0.0">
        <LinearLayout
            android:id="@id/buddy_select_call_type_layout"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <Button
                android:enabled="false"
                android:textSize="18.0dip"
                android:id="@id/buddy_select_voice_call"
                android:layout_width="125.0dip"
                android:layout_height="fill_parent"
                android:layout_marginLeft="10.0dip"
                android:text="@string/menu_voice_call"
                android:layout_weight="0.0" />
            <Button
                android:enabled="false"
                android:textSize="18.0dip"
                android:id="@id/buddy_select_video_call"
                android:layout_width="125.0dip"
                android:layout_height="fill_parent"
                android:layout_marginLeft="12.0dip"
                android:text="@string/menu_video_call"
                android:layout_weight="0.0" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@id/buddy_select_group_chat_broadcast_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="40.0dip"
        android:layout_marginBottom="14.0dip"
        android:layout_weight="0.0">
        <LinearLayout
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0">
            <TextView
                android:textSize="22.0dip"
                android:textStyle="bold"
                android:textColor="#ff787878"
                android:ellipsize="marquee"
                android:gravity="center_vertical"
                android:id="@id/buddy_select_group_name_4_chat"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:singleLine="true"
                android:layout_weight="0.0" />
            <TextView
                android:textSize="22.0dip"
                android:textColor="#ff787878"
                android:ellipsize="marquee"
                android:gravity="center_vertical"
                android:id="@id/buddy_select_group_count_4_chat"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_marginLeft="10.0dip"
                android:singleLine="true"
                android:layout_weight="1.0" />
        </LinearLayout>
        <Button
            android:enabled="false"
            android:textSize="18.0dip"
            android:id="@id/buddy_select_group_chat"
            android:layout_width="125.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="10.0dip"
            android:text="@string/menu_button_start_chat"
            android:layout_weight="0.0" />
        <Button
            android:enabled="false"
            android:textSize="18.0dip"
            android:id="@id/buddy_select_group_broadcast"
            android:layout_width="125.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="12.0dip"
            android:text="@string/buddy_list_optionmenu_broadcast"
            android:layout_weight="0.0" />
    </LinearLayout>
    <LinearLayout
        android:id="@id/buddy_select_group_member_layout"
        android:background="@drawable/buddy_select_group_background_xml"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="36.0dip"
        android:layout_marginBottom="2.0dip">
        <TextView
            android:textSize="18.0dip"
            android:textStyle="bold"
            android:textColor="#ffd2dfe0"
            android:gravity="center_vertical"
            android:id="@id/buddy_select_group_member"
            android:paddingLeft="13.0dip"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/buddy_select_category_group_member"
            android:shadowColor="#ff243339"
            android:shadowDx="0.0"
            android:shadowDy="-1.0"
            android:shadowRadius="1.0" />
        <TextView
            android:textSize="18.0dip"
            android:textStyle="bold"
            android:textColor="#ffd2dfe0"
            android:gravity="center_vertical"
            android:id="@id/buddy_select_group_member_participant"
            android:paddingLeft="10.0dip"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="(0)"
            android:shadowColor="#ff243339"
            android:shadowDx="0.0"
            android:shadowDy="-1.0"
            android:shadowRadius="1.0" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/buddy_select_list_layout"
        android:addStatesFromChildren="true"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <com.sec.widget.FastScrollableExpandableListView
            android:id="@id/buddy_select_list"
            android:scrollbars="vertical"
            android:fadingEdge="vertical"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:scrollingCache="false"
            android:groupIndicator="@null"
            android:childDivider="@drawable/list_2line"
            android:layout_weight="1.0" />
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@id/buddy_select_list_nobuddy_layout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0">
            <ImageView
                android:gravity="center_horizontal"
                android:id="@id/buddy_select_list_nobuddy_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/chaton_list_ic_none" />
            <TextView
                android:textSize="22.0dip"
                android:textColor="#ff808080"
                android:gravity="center_horizontal"
                android:id="@id/buddy_select_list_nobuddy_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buddy_select_no_list_select_buddies" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>