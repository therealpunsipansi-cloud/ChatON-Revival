<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_gravity="right"
    android:orientation="vertical"
    android:descendantFocusability="afterDescendants"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/rLayoutChatParent"
        android:background="#ffe5e5e5"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <TextView
            android:textSize="14.0dip"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@id/title_menu"
            android:background="@drawable/co_title_bar"
            android:paddingLeft="7.299988dip"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="25.329987dip"
            android:text="@string/layout_chat_fragment_delete"
            android:layout_alignParentTop="true" />
        <RelativeLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/honeycomb_deletetop"
            android:background="@color/white"
            android:visibility="gone"
            android:alwaysDrawnWithCache="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:background="@drawable/shape_title_indicator_top"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14.0dip"
                android:layout_marginTop="13.0dip"
                android:layout_marginRight="14.0dip">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:background="@drawable/chaton_chats_header"
                    android:layout_width="fill_parent"
                    android:layout_height="55.0dip">
                    <TextView
                        android:textSize="22.0dip"
                        android:textStyle="bold"
                        android:textColor="@color/color1"
                        android:id="@id/honeycomb_title_menu"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="14.0dip"
                        android:layout_marginRight="10.0dip"
                        android:text="@string/layout_chat_fragment_delete" />
                    <RelativeLayout
                        android:gravity="center_vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="75.0dip"
                        android:layout_weight="1.0">
                        <Button
                            android:textSize="16.0dip"
                            android:textColor="@color/color1"
                            android:id="@id/btnRangeAll"
                            android:background="@drawable/chat_title_btn_back_honeycom"
                            android:layout_width="125.0dip"
                            android:layout_height="40.0dip"
                            android:layout_marginTop="2.0dip"
                            android:layout_marginRight="12.0dip"
                            android:text="@string/layout_chat_fragment_selectall"
                            android:layout_weight="1.0"
                            android:layout_toLeftOf="@id/btnDelete" />
                        <Button
                            android:textSize="16.0dip"
                            android:textColor="@color/color1"
                            android:id="@id/btnDelete"
                            android:background="@drawable/chat_title_btn_back_honeycom"
                            android:layout_width="125.0dip"
                            android:layout_height="40.0dip"
                            android:layout_marginTop="2.0dip"
                            android:layout_marginRight="12.0dip"
                            android:text="@string/done"
                            android:layout_weight="1.0"
                            android:layout_toLeftOf="@id/btnDelCancel" />
                        <Button
                            android:textSize="16.0dip"
                            android:textColor="@color/color1"
                            android:id="@id/btnDelCancel"
                            android:background="@drawable/chat_title_btn_back_honeycom"
                            android:layout_width="125.0dip"
                            android:layout_height="40.0dip"
                            android:layout_marginTop="2.0dip"
                            android:layout_marginRight="12.0dip"
                            android:text="@string/layout_chat_fragment_cancel"
                            android:layout_weight="1.0"
                            android:layout_alignParentRight="true" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@id/ldeletetop"
            android:background="@drawable/co_bt_bg2"
            android:padding="7.299988dip"
            android:visibility="gone"
            android:alwaysDrawnWithCache="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="16.0dip"
                android:id="@id/btnRangeAll"
                android:layout_width="97.29999dip"
                android:layout_height="fill_parent"
                android:layout_marginTop="2.0dip"
                android:layout_marginRight="6.5999756dip"
                android:text="@string/layout_chat_fragment_selectall"
                android:layout_weight="1.0" />
            <Button
                android:textSize="16.0dip"
                android:id="@id/btnRangeRcv"
                android:layout_width="97.29999dip"
                android:layout_height="fill_parent"
                android:layout_marginTop="2.0dip"
                android:layout_marginRight="6.5999756dip"
                android:text="@string/layout_chat_fragment_received"
                android:layout_weight="1.0" />
            <Button
                android:textSize="16.0dip"
                android:id="@id/btnRangeSnt"
                android:layout_width="97.29999dip"
                android:layout_height="fill_parent"
                android:layout_marginTop="2.0dip"
                android:text="@string/layout_chat_fragment_sent"
                android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/lLayoutChat"
            android:visibility="visible"
            android:descendantFocusability="afterDescendants"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0">
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@id/lLayoutProfile"
                android:background="@drawable/chatting_header"
                android:focusable="false"
                android:layout_width="fill_parent"
                android:layout_height="76.0dip">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/optionBar"
                    android:layout_width="fill_parent"
                    android:layout_height="76.0dip">
                    <com.revived.chaton.widget.ProfileImageView
                        android:layout_gravity="center_vertical"
                        android:id="@id/Chaticon"
                        android:layout_width="51.0dip"
                        android:layout_height="51.0dip"
                        android:layout_marginLeft="12.0dip" />
                    <TextView
                        android:textSize="22.0dip"
                        android:typeface="sans"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:gravity="center|left"
                        android:layout_gravity="center_vertical"
                        android:id="@id/chatTitle"
                        android:layout_width="0.0dip"
                        android:layout_height="fill_parent"
                        android:layout_marginLeft="12.0dip"
                        android:maxLines="2"
                        android:shadowColor="@color/white"
                        android:shadowDx="0.0"
                        android:shadowDy="-1.0"
                        android:layout_weight="1.0" />
                    <FrameLayout
                        android:layout_gravity="center_vertical"
                        android:id="@id/imageTrunkBg"
                        android:background="@drawable/chatting_btn_trunk"
                        android:focusable="true"
                        android:fadingEdgeLength="0.0dip"
                        android:descendantFocusability="beforeDescendants"
                        android:layout_width="93.0dip"
                        android:layout_height="51.0dip"
                        android:layout_marginRight="14.0dip">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="40.0dip"
                            android:layout_height="40.0dip"
                            android:src="@drawable/chatting_btn_lcon_turnk" />
                        <TextView
                            android:textColor="#ff6a2a00"
                            android:gravity="center"
                            android:layout_gravity="center|right|top"
                            android:id="@id/unReadCount"
                            android:background="@drawable/tab_icon_notification"
                            android:visibility="gone"
                            android:layout_width="26.0dip"
                            android:layout_height="29.0dip"
                            android:layout_marginRight="13.0dip"
                            android:shadowColor="#80ffffff" />
                    </FrameLayout>
                </LinearLayout>
                <TextView
                    android:textSize="22.0dip"
                    android:textStyle="bold"
                    android:textColor="#ff000000"
                    android:gravity="center|left"
                    android:id="@id/textBroadcast"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10.0dip"
                    android:shadowColor="#60ffffff"
                    android:shadowDx="0.0"
                    android:shadowDy="-1.0"
                    android:drawableLeft="@drawable/chat_list_broadcast_default"
                    android:drawablePadding="19.0dip"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <FrameLayout
                android:id="@id/chatlistframe"
                android:descendantFocusability="afterDescendants"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:shadowColor="@color/ics_main_background_color"
                android:shadowDx="10.0"
                android:shadowDy="10.0"
                android:shadowRadius="10.0">
                <ImageView
                    android:id="@id/imagebackgroup"
                    android:visibility="visible"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:scaleType="matrix" />
                <com.sec.widget.HeightChangedListView
                    android:id="@id/chat_listview"
                    android:background="@null"
                    android:alwaysDrawnWithCache="true"
                    android:descendantFocusability="afterDescendants"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:listSelector="#00000000"
                    android:transcriptMode="alwaysScroll"
                    android:cacheColorHint="#00000000"
                    android:divider="@null"
                    android:layout_weight="1.0" />
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="bottom"
                    android:background="@color/transparent"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <ImageButton
                        android:layout_gravity="center"
                        android:id="@id/previewText"
                        android:background="@color/transparent"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/new_message_noti" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/chatEditLayout"
            android:background="@drawable/chat_btn_bg"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/lLayoutMsgEdit"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8.0dip"
                android:layout_marginRight="14.0dip"
                android:minHeight="53.0dip">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_weight="1.0">
                    <ImageButton
                        android:layout_gravity="center_vertical"
                        android:id="@id/btnAdd"
                        android:layout_width="57.0dip"
                        android:layout_height="53.0dip"
                        android:src="@drawable/chat_attach_button_honeycom" />
                    <ImageButton
                        android:layout_gravity="center_vertical"
                        android:id="@id/btnChatImage"
                        android:layout_width="57.0dip"
                        android:layout_height="53.0dip"
                        android:layout_marginLeft="10.0dip"
                        android:src="@drawable/chat_emoticon_btn_honeycom"
                        android:onClick="onEmoticonClick" />
                    <com.revived.chaton.chat.MyEditText
                        android:textSize="22.0dip"
                        android:textColorHint="#aa505050"
                        android:id="@id/editChatMsg"
                        android:paddingLeft="10.0dip"
                        android:paddingTop="5.0dip"
                        android:paddingRight="10.0dip"
                        android:paddingBottom="5.0dip"
                        android:focusable="true"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="9.0dip"
                        android:minHeight="53.0dip"
                        android:hint="@string/chat_enter_message_hint"
                        android:maxLines="3"
                        android:maxLength="2000"
                        android:inputType="textCapSentences|textMultiLine"
                        android:imeOptions="actionUnspecified|normal"
                        android:textCursorDrawable="@null" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent">
                    <Button
                        android:enabled="false"
                        android:textSize="18.0dip"
                        android:textColor="@color/chat_send_button_xml"
                        android:layout_gravity="center_vertical"
                        android:id="@id/btnChatSend"
                        android:background="@drawable/chat_send_btn_honeycom"
                        android:layout_width="93.0dip"
                        android:layout_height="53.0dip"
                        android:layout_marginLeft="12.0dip"
                        android:text="@string/layout_chat_fragment_send" />
                </LinearLayout>
                <Button
                    android:id="@id/btnImoticon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@id/ldeletebot"
            android:background="@drawable/co_bt_bg1"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <Button
                android:enabled="false"
                android:layout_gravity="center_vertical"
                android:id="@id/btnDelete"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginLeft="2.0dip"
                android:layout_marginTop="3.0dip"
                android:text="@string/layout_chat_fragment_delete"
                android:layout_weight="0.5" />
            <Button
                android:layout_gravity="center_vertical"
                android:id="@id/btnDelCancel"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="3.0dip"
                android:layout_marginRight="2.0dip"
                android:text="@string/layout_chat_fragment_cancel"
                android:layout_weight="0.5" />
        </LinearLayout>
    </LinearLayout>
    <com.revived.chaton.multimedia.emoticon.EmoticonSelectionView
        android:orientation="vertical"
        android:id="@id/scrollemoticon"
        android:background="@drawable/chat_emoticon_bg"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/linearemoticon"
            android:background="#00000000"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="142.6dip">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/linearemoticontop"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="52.0dip">
                <GridView
                    android:gravity="center"
                    android:id="@id/emoticonGrid1"
                    android:visibility="visible"
                    android:scrollbars="none"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:horizontalSpacing="8.0dip"
                    android:stretchMode="columnWidth"
                    android:columnWidth="50.0dip"
                    android:numColumns="auto_fit" />
            </LinearLayout>
            <ImageView
                android:id="@id/imageline"
                android:background="@drawable/emoticon_line"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="1.5dip"
                android:layout_marginTop="11.0dip" />
            <GridView
                android:gravity="center"
                android:id="@id/emoticonGrid0"
                android:scrollbars="none"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_marginTop="10.0dip"
                android:horizontalSpacing="8.0dip"
                android:verticalSpacing="8.0dip"
                android:stretchMode="columnWidth"
                android:columnWidth="50.0dip"
                android:numColumns="auto_fit"
                android:layout_weight="1.0" />
        </LinearLayout>
    </com.revived.chaton.multimedia.emoticon.EmoticonSelectionView>
</RelativeLayout>