<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:paddingLeft="13.0dip"
    android:paddingTop="15.0dip"
    android:paddingRight="13.0dip"
    android:paddingBottom="5.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="20.0dip"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:id="@id/progressDialogMessage"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="@string/anicon_file_downloading" />
    <ProgressBar
        android:id="@id/progressDialogBar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15.0dip"
        android:progress="50"
        style="@style/GeneralProgressBarHorizontal" />
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@android:color/black"
            android:id="@id/progressDialogCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1.0" />
        <TextView
            android:textColor="@android:color/black"
            android:gravity="right"
            android:id="@id/progressDialogsPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1.0" />
    </LinearLayout>
</LinearLayout>