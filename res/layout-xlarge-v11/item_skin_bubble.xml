<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:id="@id/skin_bubble_layout"
        android:focusable="true"
        android:descendantFocusability="afterDescendants"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2.0dip"
        xmlns:android="http://schemas.android.com/apk/res/android">
        <ImageView
            android:id="@id/skin_bubble"
            android:background="@drawable/btn_change_bubble_bg_xml"
            android:focusable="true"
            android:layout_width="159.0dip"
            android:layout_height="159.0dip"
            android:src="@drawable/thumb_bubble_01" />
        <TextView
            android:textSize="22.0dip"
            android:textColor="#ff3c1f0a"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@id/skin_bubble_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>