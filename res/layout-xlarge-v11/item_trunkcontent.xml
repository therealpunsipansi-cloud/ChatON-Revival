<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_gravity="center|left|top"
        android:id="@id/trunk_profile_image_outer"
        android:background="@drawable/thumb_default_line"
        android:layout_width="58.0dip"
        android:layout_height="58.0dip"
        android:layout_marginLeft="14.0dip"
        android:layout_marginTop="15.0dip"
        android:layout_marginRight="10.0dip"
        android:layout_weight="0.0">
        <com.sec.chaton.widget.ProfileImageView
            android:layout_gravity="center_vertical"
            android:id="@id/commentBuddyProfile"
            android:layout_width="56.0dip"
            android:layout_height="56.0dip"
            android:layout_marginLeft="1.0dip"
            android:layout_marginTop="9.0dip"
            android:layout_marginBottom="9.0dip" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginRight="14.0dip"
        android:layout_weight="1.0">
        <TextView
            android:textSize="22.0dip"
            android:textColor="#ff000000"
            android:ellipsize="marquee"
            android:id="@id/commentWriterName"
            android:paddingBottom="2.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13.0dip"
            android:singleLine="true"
            android:layout_weight="1.0" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18.0dip"
                android:textColor="#ff328296"
                android:ellipsize="marquee"
                android:id="@id/commentBuddyContent"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18.0dip"
                android:layout_weight="1.0" />
            <TextView
                android:textSize="18.0dip"
                android:textColor="#ff000000"
                android:gravity="center"
                android:id="@id/commentRegistrationTime"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="32.0dip"
                android:lines="1"
                android:singleLine="true"
                android:layout_weight="0.0"
                android:layout_alignParentRight="true" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>