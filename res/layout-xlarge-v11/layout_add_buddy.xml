<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/ics_main_background_color_2"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TabHost
        android:id="@id/tabhost"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TabWidget
            android:id="@android:id/tabs"
            android:layout_width="fill_parent"
            android:layout_height="51.0dip"
            android:layout_marginLeft="14.0dip"
            android:layout_marginRight="14.0dip" />
        <LinearLayout
            android:id="@id/honeycomb_divider"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="14.0dip"
            android:layout_marginLeft="14.0dip"
            android:layout_marginRight="14.0dip">
            <ImageView
                android:id="@id/divider"
                android:background="@drawable/list_divider_holo_light"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <FrameLayout
            android:id="@android:id/tabcontent"
            android:paddingTop="60.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@id/layoutAddBuddyBySuggestions"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@id/layoutAddBuddyBySuggestion"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <ScrollView
                android:id="@id/layoutAddBuddyByPhone"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="22.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:gravity="left"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="24.0dip"
                        android:layout_marginTop="4.0dip"
                        android:layout_marginRight="24.0dip"
                        android:layout_marginBottom="8.0dip"
                        android:text="@string/provision_select_country_or_region" />
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@id/pickCountry"
                        android:background="@drawable/provisioning_btn01"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="fill_parent"
                        android:layout_height="49.0dip"
                        android:layout_marginLeft="22.0dip"
                        android:layout_marginRight="22.0dip"
                        android:layout_marginBottom="22.0dip">
                        <TextView
                            android:textSize="18.0dip"
                            android:textStyle="bold"
                            android:textColor="@color/ics_main_font_color_2"
                            android:ellipsize="marquee"
                            android:gravity="center_vertical"
                            android:id="@id/editCountryName"
                            android:paddingLeft="22.0dip"
                            android:duplicateParentState="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="170.0dip"
                            android:text="@string/layout_regist_no_country_selected"
                            android:singleLine="true" />
                        <TextView
                            android:textSize="18.0dip"
                            android:textStyle="bold"
                            android:textColor="@color/ics_main_font_color_2"
                            android:gravity="center_vertical"
                            android:id="@id/editCountryCode"
                            android:duplicateParentState="true"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0" />
                        <ImageView
                            android:layout_gravity="center|right"
                            android:background="@drawable/list_round_more_arrow_selector"
                            android:duplicateParentState="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5.0dip"
                            android:scaleType="fitXY" />
                    </LinearLayout>
                    <TextView
                        android:textSize="22.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:layout_width="fill_parent"
                        android:layout_height="37.0dip"
                        android:layout_marginLeft="24.0dip"
                        android:layout_marginTop="3.0dip"
                        android:layout_marginRight="24.0dip"
                        android:text="@string/buddy_list_dialog_addbuddy_hint" />
                    <com.sec.widget.EditTextWithClearButton
                        android:id="@id/editPno"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="22.0dip"
                        android:layout_marginRight="22.0dip"
                        android:layout_marginBottom="20.0dip"
                        android:hint="@string/buddy_list_dialog_addbuddy_hint"
                        android:maxLength="20"
                        android:inputType="number"
                        android:imeOptions="actionSearch"
                        android:contentDescription="@string/buddy_list_dialog_addbuddy_hint" />
                    <TextView
                        android:textSize="18.0dip"
                        android:textColor="@color/ams_tool_default_color_01"
                        android:gravity="center_vertical"
                        android:id="@id/buddy_found"
                        android:background="@drawable/buddyprofile_buddysay_title_xml"
                        android:paddingLeft="14.0dip"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="fill_parent"
                        android:layout_height="30.0dip"
                        android:text="@string/add_buddy_results" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/layoutResultByPhone"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </ScrollView>
            <ScrollView
                android:id="@id/layoutAddBuddyById"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
