                        android:layout_width="fill_parent"
                        android:layout_height="47.0dip"
                        android:layout_marginLeft="22.0dip"
                        android:layout_marginRight="22.0dip"
                        android:layout_marginBottom="20.0dip"
                        android:hint="example@samsung.com"
                        android:inputType="textEmailAddress"
                        android:imeOptions="actionSearch"
                        android:contentDescription="@string/enter_samsung_account_id" />
                    <TextView
                        android:textSize="18.0dip"
                        android:textColor="@color/ams_tool_default_color_01"
                        android:gravity="center_vertical"
                        android:id="@id/buddy_found2"
                        android:background="@drawable/buddyprofile_buddysay_title_xml"
                        android:paddingLeft="14.0dip"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="fill_parent"
                        android:layout_height="30.0dip"
                        android:text="@string/add_buddy_results" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/layoutResultById"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </ScrollView>
            <ScrollView
                android:id="@id/layoutTellFriends"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14.0dip"
                    android:layout_marginRight="14.0dip">
                    <TextView
                        android:textSize="22.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:gravity="center|left"
                        android:paddingLeft="18.0dip"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="fill_parent"
                        android:layout_height="58.0dip"
                        android:text="@string/setting_tell_friends" />
                    <ImageView
                        android:background="@drawable/list_2line"
                        android:layout_width="fill_parent"
                        android:layout_height="2.0dip" />
                    <TextView
                        android:textSize="22.0dip"
                        android:textColor="@color/addbuddy_tellfriends_text_color"
                        android:gravity="center|left"
                        android:id="@id/tellfriends_via_message"
                        android:background="@drawable/settings_preference_item_xml"
                        android:paddingLeft="18.0dip"
                        android:paddingRight="18.0dip"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="fill_parent"
                        android:layout_height="75.0dip"
                        android:text="@string/tellfriends_via_message"
                        android:drawableEnd="@drawable/list_round_more_arrow_selector" />
                    <ImageView
                        android:background="@drawable/list_2line"
                        android:layout_width="fill_parent"
                        android:layout_height="2.0dip" />
                    <TextView
                        android:textSize="22.0dip"
                        android:textColor="@color/addbuddy_tellfriends_text_color"
                        android:gravity="center|left"
                        android:id="@id/tellfriends_via_facebook"
                        android:background="@drawable/settings_preference_item_xml"
                        android:paddingLeft="18.0dip"
                        android:paddingRight="18.0dip"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="fill_parent"
                        android:layout_height="75.0dip"
                        android:text="@string/tellfriends_via_facebook"
                        android:drawableEnd="@drawable/list_round_more_arrow_selector" />
                    <ImageView
                        android:background="@drawable/list_2line"
                        android:layout_width="fill_parent"
                        android:layout_height="2.0dip" />
                    <TextView
                        android:textSize="22.0dip"
                        android:textColor="@color/addbuddy_tellfriends_text_color"
                        android:gravity="center|left"
                        android:id="@id/tellfriends_via_twitter"
                        android:background="@drawable/settings_preference_item_xml"
                        android:paddingLeft="18.0dip"
                        android:paddingRight="18.0dip"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="fill_parent"
                        android:layout_height="75.0dip"
                        android:text="@string/tellfriends_via_twitter"
                        android:drawableEnd="@drawable/list_round_more_arrow_selector" />
                    <ImageView
                        android:background="@drawable/list_2line"
                        android:layout_width="fill_parent"
                        android:layout_height="2.0dip" />
