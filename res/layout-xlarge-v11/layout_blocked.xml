<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/l_layout_blocked"
    android:background="@color/ics_main_background_color_2"
    android:focusable="true"
    android:descendantFocusability="afterDescendants"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="18.0dip"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@id/title_settings_block_list"
        android:background="@drawable/sub_title_bg_02"
        android:paddingLeft="8.0dip"
        android:layout_width="fill_parent"
        android:layout_height="40.0dip"
        android:text="@string/settings_blocked" />
    <ListView
        android:id="@id/list"
        android:background="@null"
        android:focusable="true"
        android:descendantFocusability="afterDescendants"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:drawSelectorOnTop="false"
        android:scrollingCache="false"
        android:layout_weight="1.0"
        android:fastScrollEnabled="true" />
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@id/no_item_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_weight="1.0">
        <ImageView
            android:layout_gravity="center"
            android:background="@drawable/no_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:textSize="24.0dip"
            android:textColor="#ffaaaaaa"
            android:gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_title_noblock_item" />
        <TextView
            android:textSize="18.0dip"
            android:textColor="#ffaaaaaa"
            android:gravity="center"
            android:layout_width="414.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="6.0dip"
            android:text="@string/setting_block_list_text"
            android:lines="2" />
    </LinearLayout>
</LinearLayout>