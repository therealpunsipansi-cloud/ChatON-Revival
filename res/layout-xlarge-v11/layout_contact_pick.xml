<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/ics_main_background_color_2"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:background="@drawable/chaton_attach_header"
        android:paddingLeft="13.0dip"
        android:paddingTop="8.0dip"
        android:paddingRight="13.0dip"
        android:paddingBottom="8.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.sec.widget.EditTextWithClearButton
            android:textColor="@color/buddylist_search_edittext_text_color"
            android:gravity="center_vertical"
            android:id="@id/searchText"
            android:background="@drawable/btn_search_dialog_xml"
            android:paddingLeft="15.0dip"
            android:layout_width="fill_parent"
            android:layout_height="50.0dip"
            android:hint="@string/search_contacts"
            android:singleLine="true"
            android:maxLength="512"
            android:editable="true"
            android:layout_weight="1.0"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@null" />
    </LinearLayout>
    <ListView
        android:id="@id/contactList"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
</LinearLayout>