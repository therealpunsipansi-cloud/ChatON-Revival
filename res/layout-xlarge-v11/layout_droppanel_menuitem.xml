<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/droppanel_menuitem"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/droppanel_menu_item_height"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/droppanel_menuitem_divider"
        android:background="#ffd8d8d8"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="1.0dip" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/droppanel_menu_listitem"
        android:background="@drawable/droppanel_menu_bg_color"
        android:focusable="true"
        android:layout_width="fill_parent"
        android:layout_height="50.0dip">
        <ImageView
            android:id="@id/droppanel_menuitem_icon"
            android:paddingLeft="9.0dip"
            android:paddingTop="9.0dip"
            android:paddingBottom="9.0dip"
            android:visibility="gone"
            android:layout_width="50.0dip"
            android:layout_height="fill_parent"
            android:scaleType="centerInside" />
        <TextView
            android:textSize="18.0dip"
            android:textColor="@color/droppanel_menu_item_text"
            android:gravity="center_vertical"
            android:id="@id/droppanel_menuitem_text"
            android:background="#00000000"
            android:paddingLeft="9.0dip"
            android:paddingTop="9.0dip"
            android:paddingRight="9.0dip"
            android:paddingBottom="9.0dip"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>