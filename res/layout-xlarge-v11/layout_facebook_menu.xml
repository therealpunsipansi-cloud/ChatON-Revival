<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/ics_main_background_color"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@drawable/tab_title_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@id/btnExit"
            style="@style/BtnExitStyle" />
        <TextView
            android:id="@id/header_title"
            android:text="@string/user_facebook_account"
            style="@style/CommonTitleTextViewStyle" />
    </LinearLayout>
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        xmlns:android="http://schemas.android.com/apk/res/android">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:background="@drawable/buddy_item_xml"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="64.0dip">"
<TextView
                    android:textSize="22.0dip"
                    android:typeface="sans"
                    android:textColor="@color/ics_main_font_color_2"
                    android:ellipsize="marquee"
                    android:id="@id/facebook_account_info"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8.0dip"
                    android:singleLine="false"
                    android:layout_weight="1.0" />
                <Button
                    android:textSize="16.0dip"
                    android:typeface="sans"
                    android:ellipsize="marquee"
                    android:layout_gravity="center_vertical"
                    android:id="@id/facebook_menu_logout"
                    android:background="@drawable/btn_block_buddy_bg_xml"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="42.0dip"
                    android:layout_marginRight="8.0dip"
                    android:text="@string/logout"
                    android:singleLine="true" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:background="@drawable/sub_title_bg_02"
                android:layout_width="fill_parent"
                android:layout_height="28.0dip">"
<TextView
                    android:textSize="18.0dip"
                    android:typeface="sans"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:background="@drawable/sub_title_bg_02"
                    android:paddingLeft="8.0dip"
                    android:layout_width="0.0dip"
                    android:layout_height="30.0dip"
                    android:text="@string/facebook_header_post"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <TextView
                android:textSize="22.0dip"
                android:typeface="sans"
                android:textColor="@color/ics_main_font_color_2"
                android:ellipsize="marquee"
                android:gravity="center_vertical"
                android:id="@id/facebook_menu_invitation_card"
                android:background="@drawable/buddy_item_xml"
                android:paddingLeft="8.0dip"
                android:paddingRight="22.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="64.0dip"
                android:text="@string/facebook_invitation_card"
                android:singleLine="true"
                android:drawableRight="@drawable/list_round_more_arrow" />
            <TextView
                android:gravity="center_vertical"
                android:id="@id/facebook_menu_chaton_family"
                android:background="@drawable/buddy_item_xml"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/facebook_chaton_family" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>