<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/parentPanel"
    android:background="@color/ics_main_background_color_2"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/tab_title_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@id/chatonLogo_file"
            style="@style/BtnExitStyle" />
        <TextView
            android:text="@string/menu_multimedia_file"
            style="@style/CommonTitleTextViewStyle" />
        <ImageView
            android:id="@id/file_up"
            android:layout_width="48.0dip"
            android:layout_height="32.0dip"
            android:src="@drawable/chatting_btn_up" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/sub_title_bg"
        android:paddingLeft="8.0dip"
        android:layout_width="fill_parent"
        android:layout_height="40.0dip">
        <TextView
            android:textSize="20.0dip"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="marquee"
            android:id="@id/file_path"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1.0" />
    </LinearLayout>
    <ListView
        android:id="@id/file_list"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:scrollingCache="false"
        android:groupIndicator="@null"
        android:divider="@drawable/list_2line"
        android:dividerHeight="2.0dip"
        android:layout_weight="1.0" />
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@id/vcal_events_noresult"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="0.0">
        <TextView
            android:textSize="18.0dip"
            android:textStyle="bold"
            android:textColor="#ffefad51"
            android:ellipsize="marquee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/file_no_files"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>