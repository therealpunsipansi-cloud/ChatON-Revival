<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/parentPanel"
    android:background="@color/ics_main_background_color_2"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/contentPanel"
        android:background="@color/ics_main_background_color_2"
        android:layout_width="fill_parent"
        android:layout_height="682.0dip"
        android:layout_weight="1.0">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/searchfiled_background_bg"
            android:layout_width="fill_parent"
            android:layout_height="65.0dip">
            <LinearLayout
                android:gravity="center_vertical"
                android:background="@drawable/btn_search_dialog_xml"
                android:addStatesFromChildren="true"
                android:layout_width="fill_parent"
                android:layout_height="50.0dip"
                android:layout_marginLeft="13.0dip"
                android:layout_marginTop="8.0dip"
                android:layout_marginRight="14.0dip"
                android:layout_marginBottom="7.0dip">
                <com.sec.widget.EditTextWithClearButton
                    android:textColor="@color/brown_color_002"
                    android:gravity="center_vertical"
                    android:id="@id/vcal_search_text"
                    android:background="@null"
                    android:paddingLeft="15.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="50.0dip"
                    android:hint="@string/vcalendar_list_search_hint"
                    android:singleLine="true"
                    android:maxLength="1024"
                    android:editable="true"
                    android:layout_weight="1.0"
                    android:imeOptions="actionDone" />
            </LinearLayout>
        </LinearLayout>
        <ExpandableListView
            android:id="@id/vcal_events_list"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:scrollingCache="false"
            android:groupIndicator="@null"
            android:childDivider="@drawable/list_2line"
            android:dividerHeight="1.0dip"
            android:layout_weight="1.0" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@id/vcal_events_noresult"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="0.0">
        <TextView
            android:textSize="18.0dip"
            android:textStyle="bold"
            android:textColor="#ffefad51"
            android:ellipsize="marquee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calendar_no_events"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>