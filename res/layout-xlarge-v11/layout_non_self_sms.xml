<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/ics_main_background_color"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_weight="1.0">
        <LinearLayout
            android:orientation="vertical"
            android:scrollbars="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="600.0dip"
                android:layout_height="fill_parent">
                <LinearLayout
                    android:gravity="bottom|center|left"
                    android:orientation="vertical"
                    android:id="@id/llayoutid_01"
                    android:layout_width="fill_parent"
                    android:layout_height="64.0dip">
                    <TextView
                        android:textSize="22.0dip"
                        android:textColor="@color/ics_main_font_color"
                        android:gravity="center|left"
                        android:id="@id/txt_title"
                        android:paddingLeft="8.659973dip"
                        android:paddingBottom="10.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/provisioning_registration" />
                </LinearLayout>
                <ImageView
                    android:background="@color/color_palette_12"
                    android:layout_width="600.0dip"
                    android:layout_height="1.0dip" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center|left"
                        android:orientation="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="64.0dip"
                        android:layout_marginLeft="6.659973dip"
                        android:layout_marginRight="6.659973dip"
                        android:layout_weight="1.0">
                        <TextView
                            android:textSize="16.0dip"
                            android:textColor="@color/blue_color_021"
                            android:gravity="center|left"
                            android:id="@id/txt_title"
                            android:paddingLeft="8.659973dip"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/provisioning_nonself_sent"
                            android:layout_weight="1.0" />
                        <TextView
                            android:textSize="17.0dip"
                            android:textColor="@color/ics_orange_font_color"
                            android:gravity="center|left"
                            android:id="@id/phoneNo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="3.0dip"
                            android:layout_marginRight="6.659973dip"
                            android:text="+1234567890"
                            android:layout_weight="1.0" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6.659973dip"
                        android:layout_marginRight="6.659973dip">
                        <TextView
                            android:textSize="17.0dip"
                            android:textColor="@color/ics_main_font_color"
                            android:gravity="center"
                            android:id="@id/changePho"
                            android:layout_width="125.0dip"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6.659973dip"
                            android:layout_marginRight="15.0dip"
                            android:text="@string/ams_optmenu_edit"
                            android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>
                <ImageView
                    android:background="@color/color_palette_2"
                    android:layout_width="600.0dip"
                    android:layout_height="1.0dip" />
                <TextView
                    android:textSize="18.0dip"
                    android:textColor="@color/ics_main_font_color"
                    android:id="@id/txtRegistName_0"
                    android:paddingLeft="14.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10.0dip"
                    android:text="@string/provisioning_verification_code"
                    android:layout_weight="1.0"
                    android:layout_below="@id/llayoutid_01" />
                <TextView
                    android:textSize="18.0dip"
                    android:textColor="@color/ics_black_font_opacity_40"
                    android:id="@id/verification_explain_text"
                    android:paddingLeft="14.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3.0dip"
                    android:text="@string/provisioning_verification_explain" />
                <EditText
                    android:id="@id/vCode"
                    android:paddingLeft="14.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="40.0dip"
                    android:layout_marginLeft="12.0dip"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginRight="12.0dip"
                    android:singleLine="true"
                    android:maxLength="4"
                    android:inputType="number"
                    android:imeOptions="actionNone"
                    android:textCursorDrawable="@null" />
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="580.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6.659973dip"
                    android:layout_weight="1.0">
                    <Button
                        android:enabled="true"
                        android:textSize="16.0dip"
                        android:layout_gravity="center"
                        android:id="@id/reSend"
                        android:background="@drawable/btn_disclaimer_bg_xml"
                        android:paddingLeft="5.0dip"
                        android:paddingRight="5.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="40.0dip"
                        android:layout_marginRight="3.0dip"
                        android:text="@string/view_send_sms"
                        android:layout_weight="1.0" />
                    <Button
                        android:enabled="true"
                        android:textSize="16.0dip"
                        android:layout_gravity="center"
                        android:id="@id/btnRegiACS"
                        android:background="@drawable/btn_disclaimer_bg_xml"
                        android:paddingLeft="5.0dip"
                        android:paddingRight="5.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="40.0dip"
                        android:layout_marginLeft="3.0dip"
                        android:text="@string/regist_acs_button"
                        android:layout_weight="1.0" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@id/layout_done"
                android:background="@drawable/co_bg"
                android:paddingLeft="4.0dip"
                android:paddingTop="6.0dip"
                android:paddingRight="4.0dip"
                android:paddingBottom="4.0dip"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="55.0dip"
                android:layout_alignParentBottom="true">
                <Button
                    android:enabled="false"
                    android:textSize="16.0dip"
                    android:id="@id/btnDone"
                    android:background="@drawable/btn_disclaimer_bg_xml"
                    android:layout_width="wrap_content"
                    android:layout_height="48.0dip"
                    android:layout_marginLeft="64.0dip"
                    android:layout_marginRight="64.0dip"
                    android:text="@string/done"
                    android:layout_weight="1.0" />
                <Button
                    android:textSize="16.0dip"
                    android:id="@id/btnCancel"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="48.0dip"
                    android:text="@string/cancel"
                    android:layout_weight="1.0" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>