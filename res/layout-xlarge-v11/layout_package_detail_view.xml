<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/picturebox"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="18.0dip"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:background="@drawable/sub_title_bg_02"
        android:paddingLeft="8.0dip"
        android:layout_width="fill_parent"
        android:layout_height="40.0dip"
        android:text="@string/anicon_download_detail_title" />
    <RelativeLayout
        android:id="@id/anicon_package_item"
        android:background="@drawable/buddy_item_xml"
        android:paddingLeft="5.0dip"
        android:layout_width="fill_parent"
        android:layout_height="65.0dip">
        <ImageView
            android:id="@id/anicon_package_item_thumbnail"
            android:background="@drawable/picturebox"
            android:layout_width="@dimen/anicon_download_thumbnail_width"
            android:layout_height="@dimen/anicon_download_thumbnail_height"
            android:layout_centerVertical="true" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/anicon_package_item_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginRight="10.0dip"
            android:layout_toLeftOf="@id/anicon_package_item_download"
            android:layout_toRightOf="@id/anicon_package_item_thumbnail"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="22.0dip"
                android:textColor="#ff000000"
                android:ellipsize="marquee"
                android:id="@id/anicon_package_item_name"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:singleLine="true" />
            <TextView
                android:textSize="17.0dip"
                android:textColor="#fffd8e3b"
                android:ellipsize="marquee"
                android:id="@id/anicon_package_item_volume"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:singleLine="true" />
        </LinearLayout>
        <ImageView
            android:id="@id/anicon_package_item_download"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/anicon_package_item_download_event_xml"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true" />
        <TextView
            android:textSize="14.0dip"
            android:textColor="#ff737373"
            android:ellipsize="marquee"
            android:id="@id/anicon_download_information"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8.0dip"
            android:text="@string/anicon_package_downloaded"
            android:singleLine="true"
            android:layout_alignBottom="@id/anicon_package_item_text"
            android:layout_alignParentRight="true" />
    </RelativeLayout>
    <ImageView
        android:id="@id/package_detail_divider"
        android:background="@drawable/list_2line"
        android:layout_width="fill_parent"
        android:layout_height="1.0dip" />
    <ImageView
        android:layout_gravity="center"
        android:id="@id/anicon_preview_image"
        android:layout_width="wrap_content"
        android:layout_height="0.0dip"
        android:layout_marginLeft="20.0dip"
        android:layout_marginTop="25.0dip"
        android:layout_marginRight="20.0dip"
        android:layout_marginBottom="25.0dip"
        android:scaleType="centerInside"
        android:layout_weight="1.0" />
</LinearLayout>