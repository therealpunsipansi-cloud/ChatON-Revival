<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/ics_main_background_color_2"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="2.6">
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1.1" />
        <TextView
            android:textSize="28.0dip"
            android:textColor="@color/ics_main_font_color_2"
            android:gravity="center"
            android:id="@id/title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/summary_for_passlock" />
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1.0" />
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="38.0sp"
                android:textColor="#ffffe6c1"
                android:gravity="center"
                android:id="@id/code_1"
                android:background="@drawable/password_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10.0dip" />
            <TextView
                android:textSize="38.0sp"
                android:textColor="#ffffe6c1"
                android:gravity="center"
                android:id="@id/code_2"
                android:background="@drawable/password_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10.0dip" />
            <TextView
                android:textSize="38.0sp"
                android:textColor="#ffffe6c1"
                android:gravity="center"
                android:id="@id/code_3"
                android:background="@drawable/password_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10.0dip" />
            <TextView
                android:textSize="38.0sp"
                android:textColor="#ffffe6c1"
                android:gravity="center"
                android:id="@id/code_4"
                android:background="@drawable/password_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10.0dip" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.5" />
        <TextView
            android:textSize="16.0dip"
            android:textColor="@color/ics_orange_font_color"
            android:ellipsize="marquee"
            android:gravity="center"
            android:id="@id/hint"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20.0dip"
            android:layout_marginRight="20.0dip"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.5">
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1.0" />
        <TextView
            android:textSize="18.0dip"
            android:textColor="#ffe86d00"
            android:gravity="center|top"
            android:id="@id/description"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40.0dip"
            android:layout_marginTop="10.0dip"
            android:layout_marginRight="40.0dip"
            android:text="@string/description_for_passlock"
            android:layout_weight="1.2" />
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1.0" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="#fffff8ee"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="2.8">
        <TextView
            android:background="@drawable/lock_bg_line"
            android:layout_width="fill_parent"
            android:layout_height="2.0dip" />
        <TableLayout
            android:layout_gravity="center"
            android:paddingTop="10.0dip"
            android:layout_width="389.0dip"
            android:layout_height="wrap_content">
            <TableRow
                android:layout_height="0.0dip"
                android:layout_marginLeft="2.5dip"
                android:layout_marginRight="2.5dip"
                android:layout_weight="1.0">
                <ImageButton
                    android:id="@id/keypad_1"
                    android:src="@drawable/keypad_btn_number_1_src"
                    android:onClick="clickkeypad"
                    style="@style/Widget.Keypad" />
                <ImageButton
                    android:id="@id/keypad_2"
                    android:src="@drawable/keypad_btn_number_2_src"
                    android:onClick="clickkeypad"
                    style="@style/Widget.Keypad" />
                <ImageButton
                    android:id="@id/keypad_3"
                    android:src="@drawable/keypad_btn_number_3_src"
                    android:onClick="clickkeypad"
                    style="@style/Widget.Keypad" />
            </TableRow>
            <TableRow
                android:layout_height="0.0dip"
                android:layout_marginLeft="2.5dip"
                android:layout_marginRight="2.5dip"
                android:layout_weight="1.0">
                <ImageButton
                    android:id="@id/keypad_4"
                    android:src="@drawable/keypad_btn_number_4_src"
                    android:onClick="clickkeypad"
                    style="@style/Widget.Keypad" />
                <ImageButton
                    android:id="@id/keypad_5"
                    android:src="@drawable/keypad_btn_number_5_src"
                    android:onClick="clickkeypad"
                    style="@style/Widget.Keypad" />
                <ImageButton
                    android:id="@id/keypad_6"
                    android:src="@drawable/keypad_btn_number_6_src"
                    android:onClick="clickkeypad"
                    style="@style/Widget.Keypad" />
            </TableRow>
            <TableRow
                android:layout_height="0.0dip"
                android:layout_marginLeft="2.5dip"
                android:layout_marginRight="2.5dip"
                android:layout_weight="1.0">
                <ImageButton
                    android:id="@id/keypad_7"
                    android:src="@drawable/keypad_btn_number_7_src"
                    android:onClick="clickkeypad"
                    style="@style/Widget.Keypad" />
                <ImageButton
                    android:id="@id/keypad_8"
                    android:src="@drawable/keypad_btn_number_8_src"
                    android:onClick="clickkeypad"
                    style="@style/Widget.Keypad" />
                <ImageButton
                    android:id="@id/keypad_9"
                    android:src="@drawable/keypad_btn_number_9_src"
                    android:onClick="clickkeypad"
                    style="@style/Widget.Keypad" />
            </TableRow>
            <TableRow
                android:layout_height="0.0dip"
                android:layout_marginLeft="2.5dip"
                android:layout_marginRight="2.5dip"
                android:layout_weight="1.0">
                <Button
                    android:enabled="false"
                    android:textSize="22.0dip"
                    android:textColor="@drawable/keypad_btn_cancel_color_src"
                    android:id="@id/keypad_cancel"
                    android:padding="5.0dip"
                    android:onClick="clickkeypad_cancel"
                    style="@style/Widget.Keypad" />
                <ImageButton
                    android:id="@id/keypad_0"
                    android:src="@drawable/keypad_btn_number_0_src"
                    android:onClick="clickkeypad"
                    style="@style/Widget.Keypad" />
                <ImageButton
                    android:id="@id/keypad_back"
                    android:src="@drawable/keypad_btn_backspace_src"
                    android:onClick="clickkeypad_back"
                    style="@style/Widget.Keypad" />
            </TableRow>
        </TableLayout>
    </LinearLayout>
</LinearLayout>