<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@color/ics_main_background_color_2"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/pushName_rootView"
        android:scrollbars="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginTop="80.0dip"
        android:minWidth="500.0dip"
        android:layout_alignParentTop="true">
        <TextView
            android:textSize="22.0dip"
            android:textColor="@color/ics_main_font_color_2"
            android:id="@id/txtRegistName_0"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.0dip"
            android:text="@string/setting_enter_name" />
        <EditText
            android:textSize="22.0dip"
            android:id="@id/txtName"
            android:paddingLeft="14.0dip"
            android:paddingTop="14.0dip"
            android:paddingRight="14.0dip"
            android:paddingBottom="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="50.0dip"
            android:layout_marginTop="10.0dip"
            android:hint="Aaron Johnson"
            android:singleLine="true"
            android:maxLength="30"
            android:capitalize="sentences"
            android:imeOptions="actionNone"
            android:textCursorDrawable="@null" />
        <TextView
            android:textSize="18.0dip"
            android:textColor="@color/ics_main_font_color_2"
            android:id="@id/pushnameExplain"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7.0dip"
            android:text="@string/regist_name_detail" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/layoutRegistName_0"
        android:background="@drawable/co_bg"
        android:paddingLeft="4.0dip"
        android:paddingTop="6.0dip"
        android:paddingRight="4.0dip"
        android:paddingBottom="4.0dip"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="55.0dip"
        android:layout_alignParentBottom="true">
        <Button
            android:enabled="false"
            android:textSize="16.0dip"
            android:id="@id/btnDone"
            android:background="@drawable/btn_disclaimer_bg_xml"
            android:layout_width="wrap_content"
            android:layout_height="48.0dip"
            android:layout_marginLeft="64.0dip"
            android:layout_marginRight="64.0dip"
            android:text="@string/done"
            android:layout_weight="1.0" />
        <Button
            android:textSize="16.0dip"
            android:id="@id/btnCancel"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="48.0dip"
            android:text="@string/cancel"
            android:layout_weight="1.0" />
    </LinearLayout>
</RelativeLayout>