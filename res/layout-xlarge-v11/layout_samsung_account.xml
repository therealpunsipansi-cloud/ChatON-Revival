<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/list_bg_bottom"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="18.0dip"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:background="@drawable/sub_title_bg_02"
        android:paddingLeft="8.0dip"
        android:layout_width="fill_parent"
        android:layout_height="30.0dip"
        android:text="@string/setting_samsung_account" />
    <RelativeLayout
        android:id="@id/RelativeLayout1"
        android:background="@color/ics_main_background_color"
        android:paddingLeft="10.0dip"
        android:paddingTop="20.0dip"
        android:paddingRight="12.0dip"
        android:paddingBottom="17.0dip"
        android:layout_width="fill_parent"
        android:layout_height="200.0dip">
        <EditText
            android:id="@id/editText1"
            android:background="@drawable/btn_search_dialog_xml"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:hint="@string/acct_id" />
        <EditText
            android:id="@id/editText2"
            android:background="@drawable/btn_search_dialog_xml"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:hint="@string/acct_password"
            android:layout_below="@id/editText1" />
        <TextView
            android:textSize="18.0dip"
            android:id="@id/textView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.0dip"
            android:text="@string/forgot_password"
            android:layout_below="@id/editText2"
            android:layout_alignParentLeft="true" />
        <Button
            android:textSize="22.0dip"
            android:id="@id/button1"
            android:background="@drawable/samsung_account_signup"
            android:layout_width="100.0dip"
            android:layout_height="43.0dip"
            android:layout_marginTop="10.0dip"
            android:text="@string/user_sign_in_account"
            android:layout_below="@id/editText2"
            android:layout_alignParentRight="true" />
    </RelativeLayout>
    <Button
        android:layout_gravity="center_horizontal"
        android:id="@id/LogIn"
        android:layout_width="414.0dip"
        android:layout_height="52.0dip"
        android:layout_marginTop="23.0dip"
        android:text="@string/login" />
</LinearLayout>