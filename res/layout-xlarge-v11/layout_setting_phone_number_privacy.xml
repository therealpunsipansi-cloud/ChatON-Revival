<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/parentPanel"
    android:background="@null"
    android:focusable="true"
    android:descendantFocusability="afterDescendants"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textAppearance="@style/ChatONTextAppearance.Dialog"
        android:textColor="@color/white"
        android:gravity="center|left"
        android:id="@id/txt_title"
        android:background="@drawable/popup_bg_top"
        android:paddingLeft="20.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="60.0dip"
        android:text="@string/setting_category_privacy" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/contentPanel"
        android:background="@drawable/popup_bg_center_2"
        android:focusable="true"
        android:descendantFocusability="afterDescendants"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <ScrollView
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16.0dip"
            android:layout_marginRight="16.0dip">
            <include
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                layout="@layout/layout_setting_phone_number_privacy_phone" />
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/popup_bg_bottom"
        android:paddingLeft="10.0dip"
        android:paddingRight="10.0dip"
        android:paddingBottom="10.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="55.0dip">
        <Button
            android:textSize="18.0dip"
            android:id="@id/btnCancel"
            android:background="@drawable/btn_disclaimer_bg_xml"
            android:layout_width="0.0dip"
            android:layout_height="48.0dip"
            android:layout_marginLeft="10.0dip"
            android:layout_marginRight="3.0dip"
            android:text="@string/cancel"
            android:layout_weight="1.0" />
        <Button
            android:textSize="18.0dip"
            android:id="@id/btnSave"
            android:background="@drawable/btn_disclaimer_bg_xml"
            android:layout_width="0.0dip"
            android:layout_height="48.0dip"
            android:layout_marginLeft="2.0dip"
            android:layout_marginRight="10.0dip"
            android:text="@string/save"
            android:layout_weight="1.0" />
    </LinearLayout>
</LinearLayout>