<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/ics_main_font_color_2"
        android:gravity="center_vertical"
        android:background="@drawable/co_title_bar"
        android:paddingLeft="6.0dip"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="25.0dip"
        android:text="@string/setting_category_privacy" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <TextView
            android:textSize="18.0dip"
            android:textColor="@color/ics_main_font_color_2"
            android:gravity="center_vertical"
            android:id="@id/phone_number_privacy_message"
            android:paddingLeft="6.6999817dip"
            android:paddingTop="10.0dip"
            android:paddingBottom="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        <View
            android:background="#ff333a3a"
            android:layout_width="fill_parent"
            android:layout_height="0.30000007dip" />
        <LinearLayout
            android:gravity="center"
            android:id="@id/phone_number_layout"
            android:paddingTop="10.0dip"
            android:paddingBottom="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="22.0dip"
                android:textColor="@color/ics_main_font_color_2"
                android:id="@id/phone_number_text"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10.0dip"
                android:layout_weight="1.0" />
            <CheckBox
                android:id="@id/phone_number_checkbox"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="48.0dip"
                android:layout_marginRight="10.0dip"
                android:button="@drawable/checkbox_background_xml" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>