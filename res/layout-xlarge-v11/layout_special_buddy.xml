<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:descendantFocusability="afterDescendants"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.sec.widget.GeneralHeaderView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:button="@null"
        android:text="@string/buddy_suggestion_special_buddy" />
    <LinearLayout
        android:background="@color/main_background_color"
        android:descendantFocusability="afterDescendants"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0.0">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@id/profile_image"
            android:layout_width="70.0dip"
            android:layout_height="70.0dip"
            android:layout_marginLeft="8.0dip"
            android:layout_marginTop="8.0dip"
            android:layout_marginRight="12.0dip"
            android:layout_marginBottom="14.0dip"
            android:src="@drawable/contacts_default_special"
            android:scaleType="fitXY"
            android:layout_weight="0.0" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/profile_name_status"
            android:layout_width="0.0dip"
            android:layout_height="22.0dip"
            android:layout_marginTop="20.0dip"
            android:layout_weight="1.0">
            <TextView
                android:textSize="20.0dip"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:id="@id/specialbuddy_name"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:textSize="15.0dip"
                android:textColor="#ff498d92"
                android:gravity="center_vertical"
                android:id="@id/specialbuddy_status_message"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7.0dip"
                android:maxLines="3" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <CheckBox
                android:layout_gravity="center_vertical"
                android:id="@id/profile_is_favorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12.0dip"
                android:layout_marginRight="8.0dip"
                android:button="@drawable/buddyprofile_favorite_btn_xml"
                android:layout_weight="0.0" />
            <TextView
                android:textSize="14.0dip"
                android:textColor="#ff498d92"
                android:layout_gravity="center"
                android:id="@id/profile_favorite_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="test" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="19.0dip"
        android:layout_marginLeft="19.0dip"
        android:layout_marginBottom="10.0dip">
        <TextView
            android:textSize="17.0dip"
            android:textColor="#ff000000"
            android:layout_gravity="left"
            android:id="@id/specialbuddy_subscribe_count"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:text="test" />
    </LinearLayout>
    <LinearLayout
        android:background="@color/main_background_color"
        android:paddingLeft="8.0dip"
        android:paddingTop="10.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="7.0dip"
        android:descendantFocusability="afterDescendants"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:layout_gravity="center"
            android:id="@id/block_special_buddies"
            android:layout_marginRight="4.0dip"
            android:src="@drawable/special_buddies_block_icon"
            android:contentDescription="@string/menu_button_start_chat"
            style="@style/BuddyProfileMenuImageButton" />
        <ImageButton
            android:layout_gravity="center"
            android:id="@id/add_special_buddies"
            android:layout_marginRight="4.0dip"
            android:src="@drawable/special_buddies_accept_icon"
            android:contentDescription="@string/menu_voice_call"
            style="@style/BuddyProfileMenuImageButton" />
    </LinearLayout>
</LinearLayout>