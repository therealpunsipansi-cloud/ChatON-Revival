<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@id/lLayoutProfile"
        android:background="@drawable/chatting_header"
        android:focusable="false"
        android:layout_width="fill_parent"
        android:layout_height="76.0dip">
        <com.sec.chaton.widget.ProfileImageView
            android:layout_gravity="center_vertical"
            android:id="@id/Chaticon"
            android:layout_width="51.0dip"
            android:layout_height="51.0dip"
            android:layout_marginLeft="12.0dip" />
        <TextView
            android:textSize="22.0dip"
            android:typeface="sans"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center|left"
            android:layout_gravity="center_vertical"
            android:id="@id/chatTitle"
            android:clickable="true"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="12.0dip"
            android:shadowColor="@color/white"
            android:shadowDx="0.0"
            android:shadowDy="-1.0"
            android:layout_weight="1.0" />
    </LinearLayout>
    <FrameLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_weight="1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
        <WebView
            android:id="@id/spbd_webview"
            android:scrollbars="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
        <LinearLayout
            android:gravity="center"
            android:id="@id/progressbar"
            android:visibility="invisible"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <ProgressBar
                android:layout_width="40.0dip"
                android:layout_height="40.0dip" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>