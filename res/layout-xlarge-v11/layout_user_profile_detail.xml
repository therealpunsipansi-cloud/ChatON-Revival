<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/ics_main_background_color_2"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <com.revived.chaton.widget.RoundedImageView
                    android:id="@id/imgbtnUPPhoto"
                    android:background="@drawable/selector_emoticon_selected"
                    android:padding="4.0dip"
                    android:focusable="true"
                    android:layout_width="100.0dip"
                    android:layout_height="100.0dip"
                    android:layout_marginLeft="8.0dip"
                    android:layout_marginTop="8.0dip"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="22.0dip"
                        android:typeface="sans"
                        android:textColor="@color/ics_main_font_color_2"
                        android:id="@id/nameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10.0dip"
                        android:layout_marginTop="10.0dip"
                        android:layout_marginRight="8.0dip"
                        android:text="@string/mypage_profile_name" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/linear_profile_name"
                        android:clickable="true"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10.0dip"
                        android:layout_marginTop="11.0dip"
                        android:layout_marginRight="8.0dip"
                        android:layout_marginBottom="8.0dip">
                        <EditText
                            android:textSize="21.0dip"
                            android:textColorHint="@color/gray2"
                            android:gravity="center_vertical"
                            android:id="@id/textPersonalName"
                            android:paddingRight="15.0dip"
                            android:layout_width="fill_parent"
                            android:layout_height="47.0dip"
                            android:layout_marginTop="2.0dip"
                            android:layout_marginRight="6.0dip"
                            android:layout_marginBottom="4.0dip"
                            android:minHeight="30.0dip"
                            android:hint="@string/mypage_profile_name"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:maxLength="30"
                            android:capitalize="sentences" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@id/llayout_account_1"
                android:paddingLeft="13.299988dip"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="64.0dip">
                <TextView
                    android:textSize="22.0dip"
                    android:typeface="sans"
                    android:textColor="@color/white"
                    android:gravity="left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_samsung_account" />
                <TextView
                    android:textSize="14.0dip"
                    android:typeface="sans"
                    android:textColor="@color/ssm_blue"
                    android:gravity="left"
                    android:id="@id/user_Account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_gmail_account" />
            </LinearLayout>
            <ImageView
                android:background="@drawable/list_2line"
                android:layout_width="fill_parent"
                android:layout_height="1.0dip"
                android:layout_marginLeft="14.0dip"
                android:layout_marginTop="7.0dip"
                android:layout_marginRight="14.0dip" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="22.0dip"
                    android:typeface="sans"
                    android:textColor="@color/ics_main_font_color_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10.0dip"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginRight="8.0dip"
                    android:text="@string/mypage_profile_status" />
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/linear_status_msg"
                    android:clickable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10.0dip"
                    android:layout_marginTop="11.0dip"
                    android:layout_marginRight="8.0dip"
                    android:layout_marginBottom="8.0dip">
                    <EditText
                        android:textSize="21.0dip"
                        android:textColorHint="@color/gray2"
                        android:layout_gravity="center_vertical"
                        android:id="@id/statusMsgText"
                        android:paddingRight="15.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="47.0dip"
                        android:layout_marginTop="2.0dip"
                        android:layout_marginRight="6.0dip"
                        android:layout_marginBottom="4.0dip"
                        android:minHeight="30.0dip"
                        android:hint="@string/mypage_profile_status"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:maxLength="40"
                        android:capitalize="sentences" />
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:id="@id/rlayoutPhoneNumber"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="64.0dip">
                <TextView
                    android:textSize="22.0dip"
                    android:typeface="sans"
                    android:textColor="@color/ics_main_font_color_2"
                    android:gravity="left"
                    android:id="@id/text_phone_number"
                    android:paddingLeft="13.0dip"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:text="@string/setting_phone" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@id/llayoutPhone"
                    android:background="@drawable/edit_text"
                    android:focusable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:layout_width="fill_parent"
                    android:layout_height="48.0dip"
                    android:layout_marginLeft="10.0dip"
                    android:layout_marginTop="11.0dip"
                    android:layout_marginRight="14.0dip"
                    android:layout_below="@id/text_phone_number"
                    android:layout_alignParentLeft="true">
                    <TextView
                        android:textSize="21.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:gravity="center_vertical"
                        android:id="@id/user_Pno"
                        android:paddingLeft="12.0dip"
                        android:paddingTop="8.0dip"
                        android:paddingRight="15.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="47.0dip"
                        android:layout_marginTop="2.0dip"
                        android:layout_marginRight="6.0dip"
                        android:layout_marginBottom="4.0dip"
                        android:alpha="50.0" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/rlayoutBDay"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:minHeight="64.0dip">
                <TextView
                    android:textSize="22.0dip"
                    android:typeface="sans"
                    android:textColor="@color/ics_main_font_color_2"
                    android:gravity="left"
                    android:id="@id/text_birthday"
                    android:paddingLeft="13.0dip"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:text="@string/setting_birthday" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@id/llayoutBDay"
                    android:background="@drawable/edit_text"
                    android:focusable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:layout_width="fill_parent"
                    android:layout_height="48.0dip"
                    android:layout_marginLeft="10.0dip"
                    android:layout_marginTop="11.0dip"
                    android:layout_marginRight="14.0dip"
                    android:layout_below="@id/text_birthday"
                    android:layout_alignParentLeft="true">
                    <TextView
                        android:textSize="21.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:textColorHint="@color/gray2"
                        android:gravity="center_vertical"
                        android:id="@id/dateDisplay"
                        android:paddingLeft="12.0dip"
                        android:paddingTop="10.0dip"
                        android:paddingRight="15.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="47.0dip"
                        android:layout_marginRight="6.0dip"
                        android:layout_marginBottom="4.0dip"
                        android:hint="@string/add_your_birthday" />
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="13.299988dip"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="64.0dip">
                <TextView
                    android:textSize="14.0dip"
                    android:typeface="sans"
                    android:textColor="@color/blue_color_021"
                    android:gravity="left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_samsung_account" />
                <TextView
                    android:textSize="22.0dip"
                    android:typeface="sans"
                    android:textColor="@color/white"
                    android:gravity="left"
                    android:id="@id/user_samsung_account_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>