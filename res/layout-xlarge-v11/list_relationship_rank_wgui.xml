<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/rlay_relation"
    android:background="@color/ics_main_background_color_2"
    android:layout_width="fill_parent"
    android:layout_height="86.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:gravity="center"
        android:id="@id/relationImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24.0dip"
        android:layout_marginTop="13.0dip"
        android:layout_marginRight="0.30000007dip"
        android:layout_marginBottom="12.0dip">
        <com.sec.chaton.widget.ProfileImageView
            android:id="@id/relation_img"
            android:layout_width="60.0dip"
            android:layout_height="60.0dip"
            android:scaleType="fitXY"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@id/relative0"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginLeft="10.0dip"
        android:layout_toRightOf="@id/relationImage">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/linear0"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="12.0dip"
            android:layout_marginBottom="7.0dip">
            <TextView
                android:textSize="22.0dip"
                android:textColor="#ff000000"
                android:ellipsize="marquee"
                android:id="@id/relation_rank_text_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_interaction_wall"
                android:singleLine="true"
                android:shadowColor="@color/black" />
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/namenpoint"
                android:layout_width="wrap_content"
                android:layout_height="0.0dip">
                <TextView
                    android:textSize="10.0dip"
                    android:textColor="@color/white"
                    android:id="@id/relation_rank_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buddy_profile_rank"
                    android:shadowColor="@color/black" />
                <TextView
                    android:textSize="10.0dip"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" : " />
                <TextView
                    android:textSize="10.0dip"
                    android:textColor="@color/white"
                    android:id="@id/relation_rank_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buddy_profile_rank"
                    android:shadowColor="@color/black" />
                <TextView
                    android:textSize="10.0dip"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / "
                    android:shadowColor="@color/black" />
                <TextView
                    android:textSize="10.0dip"
                    android:textColor="@color/white"
                    android:id="@id/relation_point_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buddy_profile_point"
                    android:shadowColor="@color/black" />
                <TextView
                    android:textSize="10.0dip"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" : "
                    android:shadowColor="@color/black" />
                <TextView
                    android:textSize="10.0dip"
                    android:textColor="@color/white"
                    android:id="@id/relation_point"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_interaction_zero"
                    android:shadowColor="@color/black" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@id/lbar"
            android:layout_width="@dimen/my_page_interaction_rank_detail_width"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18.0dip"
            android:layout_marginBottom="11.0dip"
            android:layout_below="@id/linear0">
            <TextView
                android:textSize="16.0dip"
                android:textColor="#ffe86d00"
                android:gravity="center|right"
                android:id="@id/relation_received_pt"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent" />
            <TextView
                android:textSize="16.0dip"
                android:textColor="@color/black"
                android:gravity="center|left"
                android:id="@id/relation_received"
                android:background="@drawable/interaction_rank_01"
                android:paddingLeft="5.0dip"
                android:layout_width="wrap_content"
                android:layout_height="29.0dip"
                android:layout_marginLeft="5.0dip"
                android:layout_weight="250.0" />
            <TextView
                android:textSize="16.0dip"
                android:textColor="@color/black"
                android:gravity="center|right"
                android:id="@id/relation_send"
                android:background="@drawable/interaction_rank_02"
                android:paddingRight="8.0dip"
                android:layout_width="wrap_content"
                android:layout_height="29.0dip"
                android:layout_weight="150.0" />
            <TextView
                android:textSize="16.0dip"
                android:textColor="#ff328296"
                android:gravity="center|left"
                android:id="@id/relation_send_pt"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_marginLeft="6.0dip" />
            <RelativeLayout
                android:id="@id/rbar"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_marginLeft="2.0dip"
                android:layout_marginRight="5.0dip"
                android:layout_weight="50.0">
                <TextView
                    android:textSize="16.0dip"
                    android:textColor="@color/black"
                    android:gravity="right"
                    android:id="@id/relation_gap"
                    android:background="#ffffffff"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="14.699982dip"
                    android:text="@string/setting_interaction_gap"
                    android:layout_alignParentLeft="true" />
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
    <ImageView
        android:id="@id/relation_rank_img"
        android:layout_width="20.0dip"
        android:layout_height="40.0dip"
        android:layout_marginTop="3.0dip"
        android:layout_marginRight="6.0dip"
        android:layout_alignParentRight="true" />
    <LinearLayout
        android:background="#ff464646"
        android:layout_width="fill_parent"
        android:layout_height="1.0dip" />
</RelativeLayout>