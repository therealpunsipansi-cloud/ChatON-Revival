<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/buddy_say_main_layout"
    android:background="@drawable/buddy_item_xml"
    android:focusable="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14.0dip"
    android:minHeight="80.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:focusable="true"
        android:clickable="true"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:gravity="center"
            android:id="@id/memo_profile_image_outer"
            android:background="@drawable/thumb_default_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12.0dip"
            android:layout_marginTop="9.0dip"
            android:layout_marginRight="10.0dip">
            <com.sec.chaton.widget.RoundedImageView
                android:id="@id/memo_profile_image"
                android:layout_width="60.0dip"
                android:layout_height="60.0dip" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/buddies_say_layout"
            android:focusable="false"
            android:clickable="false"
            android:longClickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <TextView
                android:textSize="22.0dip"
                android:textStyle="bold"
                android:textColor="@color/ics_main_font_color_2"
                android:ellipsize="marquee"
                android:id="@id/memo_profile_name"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6.0dip"
                android:text="Name"
                android:singleLine="true" />
            <TextView
                android:textSize="18.0dip"
                android:textColor="@color/ics_main_font_color_2"
                android:id="@id/memo_content"
                android:paddingBottom="6.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5.0dip"
                android:text="Contents"
                android:maxLength="140" />
        </LinearLayout>
        <TextView
            android:textSize="14.0dip"
            android:textColor="@color/memo_item_time"
            android:id="@id/memo_time"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="8.0dip"
            android:layout_marginRight="14.0dip"
            android:singleLine="true"
            android:layout_weight="0.0" />
    </LinearLayout>
</RelativeLayout>