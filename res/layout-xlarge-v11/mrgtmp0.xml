<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/tab_title_bg"
        android:paddingTop="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@id/layout_back_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Button
                android:id="@id/back_key"
                android:background="@drawable/header_btn_bg_xml"
                android:paddingLeft="10.0dip"
                android:paddingRight="14.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/title_arrow_left"
                android:drawableRight="@drawable/chaton_logo" />
        </LinearLayout>
        <TextView
            android:textSize="18.0dip"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/multimedia_geotag_header"
            android:layout_weight="1.0" />
        <TextView
            android:textSize="18.0dip"
            android:textStyle="bold"
            android:textColor="#ffc8c8c8"
            android:gravity="center_vertical"
            android:id="@id/geo_cancel"
            android:paddingLeft="34.0dip"
            android:paddingRight="28.0dip"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ams_btn_cancel"
            android:shadowColor="#a0000000"
            android:drawableLeft="@drawable/popup_tab_icon_cancel"
            android:drawablePadding="12.0dip"
            style="?android:actionButtonStyle" />
        <TextView
            android:textSize="18.0dip"
            android:textStyle="bold"
            android:textColor="#ffc8c8c8"
            android:gravity="center_vertical"
            android:id="@id/geo_send"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ams_btn_send"
            android:shadowColor="#a0000000"
            android:drawableLeft="@drawable/popup_tab_icon_send"
            android:drawablePadding="12.0dip"
            style="?android:actionButtonStyle" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/geotag_searcdh_bar"
        android:background="@drawable/searchfiled_background_bg"
        android:paddingLeft="15.0dip"
        android:paddingTop="8.0dip"
        android:paddingRight="14.0dip"
        android:paddingBottom="7.0dip"
        android:layout_width="fill_parent"
        android:layout_height="65.0dip">
        <com.sec.widget.EditTextWithClearButton
            android:textColor="@color/buddylist_search_edittext_text_color"
            android:gravity="center_vertical"
            android:id="@id/geo_search"
            android:background="@drawable/btn_search_dialog_xml"
            android:layout_width="fill_parent"
            android:layout_height="50.0dip"
            android:hint="@string/search_location"
            android:singleLine="true"
            android:editable="true"
            android:layout_weight="1.0"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@null" />
        <ImageButton
            android:id="@id/geo_current"
            android:paddingRight="14.0dip"
            android:layout_width="48.0dip"
            android:layout_height="50.0dip"
            android:layout_marginLeft="10.0dip"
            android:src="@drawable/btn_location_point_xml" />
    </LinearLayout>
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        xmlns:android="http://schemas.android.com/apk/res/android">
        <com.google.android.maps.MapView
            android:id="@id/map"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:apiKey="0VfHZNQ41WRnj9lQ_ZaDGJpDFwQ0V8VnA7B_bfg" />
        <LinearLayout
            android:id="@id/linearLayout1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16.0dip"
            android:layout_marginBottom="13.0dip"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true">
            <ImageButton
                android:id="@id/ZoomIn"
                android:background="@drawable/zoom_btn_bg"
                android:layout_width="54.0dip"
                android:layout_height="54.0dip"
                android:src="@drawable/zoom_in" />
            <ImageButton
                android:id="@id/ZoomOut"
                android:background="@drawable/zoom_btn_bg"
                android:layout_width="54.0dip"
                android:layout_height="54.0dip"
                android:layout_marginLeft="8.0dip"
                android:src="@drawable/zoom_out" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>