<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/ics_main_background_color_2"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/tab_title_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@id/layout_back_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Button
                android:id="@id/back_key"
                style="@style/BtnExitStyle" />
        </LinearLayout>
        <TextView
            android:textSize="18.0dip"
            android:text="@string/setting_about_btn1_text"
            style="@style/CommonTitleTextViewStyle" />
    </LinearLayout>
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/layout_disclaimer"
            android:paddingLeft="220.0dip"
            android:paddingRight="220.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/llayout"
                android:paddingTop="12.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="22.0dip"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:gravity="left"
                    android:id="@id/data_packet_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_about_disclaimer_txt"
                    android:maxLines="4" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/linearLayout1"
                android:background="@drawable/korea_terms_privacy_bg"
                android:paddingLeft="12.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24.0dip">
                <TextView
                    android:textSize="22.0dip"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="left"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip"
                    android:text="@string/disclaimer_terms_condition_header"
                    android:singleLine="true" />
                <TextView
                    android:textSize="22.0dip"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:gravity="left"
                    android:id="@id/data_packet_textview"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip"
                    android:layout_marginBottom="7.0dip"
                    android:text="@string/disclaimer_terms_condition"
                    android:maxLines="4" />
                <ImageButton
                    android:layout_gravity="right"
                    android:id="@id/link_button"
                    android:background="@drawable/btn_registration_disclaimer_xml"
                    android:layout_width="40.0dip"
                    android:layout_height="40.0dip"
                    android:layout_marginRight="10.0dip"
                    android:layout_marginBottom="10.0dip" />
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="left"
                android:orientation="horizontal"
                android:id="@id/linear_disclaimer_chekcbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18.0dip"
                android:layout_marginBottom="30.0dip">
                <CheckBox
                    android:id="@id/disclaimer_chekcbox"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8.0dip"
                    android:layout_marginRight="8.0dip"
                    android:button="@drawable/ams_ics_selector_checkbox" />
                <TextView
                    android:textSize="17.0dip"
                    android:textColor="@color/black"
                    android:layout_gravity="center|left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/disclaimer_agree" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/linearLayout2"
                android:background="@drawable/korea_terms_privacy_bg"
                android:paddingLeft="12.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="22.0dip"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="left"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip"
                    android:text="@string/disclaimer_accept_use_header"
                    android:singleLine="true" />
                <TextView
                    android:textSize="22.0dip"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:gravity="left"
                    android:id="@id/data_packet_textview"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip"
                    android:layout_marginBottom="7.0dip"
                    android:text="@string/disclaimer_accept_use"
                    android:maxLines="4" />
                <ImageButton
                    android:layout_gravity="right"
                    android:id="@id/link_button2"
                    android:background="@drawable/btn_registration_disclaimer_xml"
                    android:layout_width="40.0dip"
                    android:layout_height="40.0dip"
                    android:layout_marginRight="10.0dip"
                    android:layout_marginBottom="10.0dip" />
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="left"
                android:orientation="horizontal"
                android:id="@id/linear_disclaimer_chekcbox2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8.0dip"
                android:layout_marginRight="8.0dip">
                <CheckBox
                    android:id="@id/disclaimer_chekcbox2"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18.0dip"
                    android:layout_marginBottom="30.0dip"
                    android:button="@drawable/ams_ics_selector_checkbox" />
                <TextView
                    android:textSize="17.0dip"
                    android:textColor="@color/black"
                    android:layout_gravity="center|left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/disclaimer_agree" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/linearLayout3"
                android:background="@drawable/korea_terms_privacy_bg"
                android:paddingLeft="12.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="22.0dip"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="left"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip"
                    android:text="@string/disclaimer_privacy_policy_header"
                    android:singleLine="true" />
                <TextView
                    android:textSize="22.0dip"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:gravity="left"
                    android:id="@id/data_packet_textview"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip"
                    android:layout_marginBottom="7.0dip"
                    android:text="@string/disclaimer_privacy_policy"
                    android:maxLines="4" />
                <ImageButton
                    android:layout_gravity="right"
                    android:id="@id/link_button3"
                    android:background="@drawable/btn_registration_disclaimer_xml"
                    android:layout_width="40.0dip"
                    android:layout_height="40.0dip"
                    android:layout_marginRight="10.0dip"
                    android:layout_marginBottom="10.0dip" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/button_bg"
        android:paddingLeft="220.0dip"
        android:paddingRight="220.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <Button
            android:enabled="false"
            android:textSize="22.0dip"
            android:textColor="@color/default_button_text"
            android:id="@id/accept_button"
            android:background="@drawable/popup_btn_default"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8.0dip"
            android:layout_marginTop="8.0dip"
            android:layout_marginRight="8.0dip"
            android:layout_marginBottom="5.0dip"
            android:text="@string/setting_disclaimer_accept" />
    </LinearLayout>
</LinearLayout>