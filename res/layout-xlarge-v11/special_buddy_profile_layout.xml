<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/ics_main_background_color_2"
    android:descendantFocusability="afterDescendants"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:descendantFocusability="afterDescendants"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        xmlns:android="http://schemas.android.com/apk/res/android">
        <FrameLayout
            android:background="@color/ics_main_background_color_2"
            android:descendantFocusability="afterDescendants"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.0">
            <LinearLayout
                android:background="@color/ics_main_background_color_2"
                android:descendantFocusability="afterDescendants"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.0">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@id/profile_special_image"
                    android:layout_width="100.0dip"
                    android:layout_height="100.0dip"
                    android:layout_marginLeft="14.0dip"
                    android:layout_marginTop="14.0dip"
                    android:layout_marginRight="11.0dip"
                    android:layout_marginBottom="16.0dip"
                    android:layout_weight="0.0" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@id/profile_special_name_status"
                    android:layout_width="0.0dip"
                    android:layout_height="100.0dip"
                    android:layout_weight="1.0">
                    <TextView
                        android:textSize="36.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@id/profile_special_name"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:textSize="18.0dip"
                        android:textColor="@color/buddy_list_item_status"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@id/profile_special_status_message"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.0dip"
                        android:maxLines="2" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10.0dip"
                    android:layout_marginRight="10.0dip">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@id/profile_specialButton"
                        android:paddingTop="3.0dip"
                        android:paddingRight="6.0dip"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/add_buddies_special_heart" />
                    <CheckBox
                        android:layout_gravity="center"
                        android:id="@id/profile_special_is_favorite"
                        android:layout_width="38.0dip"
                        android:layout_height="38.0dip"
                        android:button="@drawable/special_buddyprofile_heart_btn_xml" />
                    <TextView
                        android:textSize="30.0dip"
                        android:textColor="#ffe65f14"
                        android:layout_gravity="center"
                        android:id="@id/profile_special_like_count"
                        android:paddingRight="6.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10.0dip" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="bottom|center|right"
                android:layout_gravity="bottom|center|right"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="22.0dip"
                    android:textColor="@color/ics_main_font_color_2"
                    android:ellipsize="marquee"
                    android:gravity="right"
                    android:layout_gravity="right"
                    android:id="@id/profile_special_subcribed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20.0dip"
                    android:singleLine="true" />
            </LinearLayout>
        </FrameLayout>
        <ScrollView
            android:id="@id/profile_special_scroll_area"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_weight="1.0">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <LinearLayout
                    android:gravity="center"
                    android:background="@drawable/list_bg"
                    android:descendantFocusability="afterDescendants"
                    android:layout_width="fill_parent"
                    android:layout_height="96.0dip">
                    <Button
                        android:textSize="22.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@id/profile_add_special_buddy"
                        android:background="@drawable/bottom_button_background"
                        android:layout_width="316.0dip"
                        android:layout_height="52.0dip"
                        android:text="@string/buddy_list_dialog_addbuddy_title"
                        android:contentDescription="@string/buddy_profile_button_addbuddy" />
                    <Button
                        android:textSize="22.0dip"
                        android:textColor="@color/ics_main_font_color_2"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@id/profile_special_chat"
                        android:background="@drawable/bottom_button_background"
                        android:visibility="gone"
                        android:layout_width="316.0dip"
                        android:layout_height="52.0dip"
                        android:text="@string/menu_button_start_chat"
                        android:contentDescription="@string/menu_button_start_chat" />
                </LinearLayout>
                <include
                    android:id="@id/layout_profile_phone_no_line"
                    layout="@layout/list_divider" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/profile_special_url_area"
                    android:background="@color/ics_main_background_color_2"
                    android:paddingTop="12.0dip"
                    android:paddingBottom="11.0dip"
                    android:focusableInTouchMode="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@id/profile_special_url_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="22.0dip"
                        android:src="@drawable/special_link" />
                    <TextView
                        android:textSize="17.0dip"
                        android:textStyle="bold"
                        android:textColor="@color/buddy_profile_item_value"
                        android:layout_gravity="center_vertical"
                        android:id="@id/profile_special_url"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="17.0dip"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/list_special_header"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    style="@style/SubTitleStyle">
                    <TextView
                        android:id="@id/special_selected_category"
                        style="@style/SuggestionSubTitleTextStyle" />
                </LinearLayout>
                <ScrollView
                    android:id="@id/profile_special_scroll_area"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_weight="1.0">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent">
                        <TextView
                            android:textSize="17.0dip"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:id="@id/special_selected_description"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:layout_marginLeft="13.0dip"
                            android:layout_marginTop="11.0dip"
                            android:layout_marginRight="13.0dip"
                            android:layout_weight="1.0" />
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/layoutButton"
            android:background="@drawable/bottom_button_bg"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="18.0dip"
                android:id="@id/profile_spcial_buddy_see_more_btn"
                android:background="@drawable/btn_registration_bg_xml"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8.0dip"
                android:layout_marginTop="8.0dip"
                android:layout_marginRight="8.0dip"
                android:layout_marginBottom="5.0dip"
                android:text="@string/special_buddy_button_see_more"
                android:contentDescription="@string/special_buddy_button_see_more"
                style="@style/ShadowTextStyle" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>