<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/parentPanel"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/topPanel"
        android:background="@drawable/dialog_top_holo_light"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="fill_horizontal"
            android:id="@id/titleDividerTop"
            android:paddingLeft="16.0dip"
            android:paddingRight="16.0dip"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="4.0dip"
            android:src="@android:drawable/ic_dialog_alert"
            android:scaleType="fitXY" />
        <LinearLayout
            android:gravity="center|left"
            android:orientation="horizontal"
            android:id="@id/title_template"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32.0dip"
            android:layout_marginRight="32.0dip"
            android:minHeight="60.0dip">
            <ImageView
                android:id="@id/icon"
                android:paddingRight="16.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_dialog_alert_holo_light" />
            <com.android.internal.widget.DialogTitle
                android:ellipsize="end"
                android:id="@id/dialog_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/upgrade_dialog_title"
                android:singleLine="true"
                style="?android:textAppearanceMedium" />
        </LinearLayout>
        <ImageView
            android:gravity="fill_horizontal"
            android:id="@id/titleDivider"
            android:paddingLeft="16.0dip"
            android:paddingRight="16.0dip"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="4.0dip"
            android:scaleType="fitXY" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/contentPanel"
        android:background="@drawable/dialog_middle_holo_light"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1.0">
        <ScrollView
            android:paddingTop="32.0dip"
            android:paddingBottom="32.0dip"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16.0dip"
            android:layout_marginRight="16.0dip">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="@style/ChatONTextAppearance.Dialog"
                    android:gravity="center"
                    android:id="@id/dialog_message"
                    android:paddingLeft="34.0dip"
                    android:paddingRight="34.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/upgrade_dialog_basic_message" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/buttonPanel"
        android:background="@drawable/dialog_bottom_holo_light"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:divider="?android:dividerHorizontal"
        android:minHeight="54.0dip"
        android:showDividers="beginning"
        android:dividerPadding="16.0dip">
        <LinearLayout
            android:orientation="horizontal"
            android:paddingLeft="2.0dip"
            android:paddingRight="2.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:measureWithLargestChild="true"
            style="?android:buttonBarStyle">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/leftSpacer"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="0.25" />
            <Button
                android:id="@id/dialog_btn_yes"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/dialog_ok"
                android:layout_weight="1.0" />
            <Button
                android:id="@id/dialog_btn_no"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/dialog_cancel"
                android:layout_weight="1.0" />
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/rightSpacer"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="0.25" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>