<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@id/subTitle"
        android:paddingLeft="6.0dip"
        android:layout_width="fill_parent"
        android:layout_height="25.0dip"
        android:text="@string/select_country_hint" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/co_search_plate"
        android:layout_width="fill_parent"
        android:layout_height="64.0dip">
        <ImageButton
            android:id="@id/buttonAdd"
            android:visibility="gone"
            android:layout_width="41.329987dip"
            android:layout_height="41.329987dip"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="2.0dip"
            android:layout_weight="0.0" />
        <EditText
            android:textSize="14.0dip"
            android:textColor="@color/brown_color_002"
            android:gravity="center_vertical"
            android:id="@id/editCountry"
            android:paddingLeft="7.0dip"
            android:layout_width="fill_parent"
            android:layout_height="42.69998dip"
            android:layout_marginLeft="10.659973dip"
            android:layout_marginTop="10.699982dip"
            android:layout_marginRight="10.699982dip"
            android:layout_marginBottom="10.699982dip"
            android:hint="@string/select_country_hint"
            android:singleLine="true"
            android:editable="true"
            android:layout_weight="1.0"
            android:inputType="textVisiblePassword"
            android:imeOptions="actionNone" />
    </LinearLayout>
    <ListView
        android:id="@android:id/list"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:scrollingCache="false"
        android:choiceMode="singleChoice"
        android:layout_weight="1.0"
        android:fastScrollEnabled="true" />
</LinearLayout>