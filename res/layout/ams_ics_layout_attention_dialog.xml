<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="@dimen/ams_ics_attention_dialog_width"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/popup_top"
                android:layout_width="fill_parent"
                android:layout_height="55.0dip">
                <TextView
                    android:textSize="22.0dip"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pop_up_attention" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/popup_center"
                android:paddingLeft="12.0dip"
                android:paddingTop="14.0dip"
                android:paddingRight="12.0dip"
                android:paddingBottom="14.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="18.0dip"
                    android:textColor="#ffffffff"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ams_attention_main" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11.0dip">
                    <CheckBox
                        android:id="@id/checkbox_never_show_again"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10.0dip"
                        android:button="@drawable/ams_ics_selector_checkbox" />
                    <TextView
                        android:textSize="18.0dip"
                        android:textColor="#80ffffff"
                        android:id="@id/text_never_show_again"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ams_never_show_again" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/popup_bottom"
            android:layout_width="fill_parent"
            android:layout_height="59.0dip">
            <Button
                android:id="@id/btn_ok"
                android:layout_width="fill_parent"
                android:layout_height="42.0dip"
                android:layout_marginLeft="32.0dip"
                android:layout_marginTop="4.0dip"
                android:layout_marginRight="32.0dip"
                android:text="@string/ams_btn_ok" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>