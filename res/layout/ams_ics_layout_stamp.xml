<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.sec.widget.GeneralHeaderView
        android:id="@id/view_titlebar"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/ams_ics_titlebar_height" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/layout_preference"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="100.0dip">
        <GridView
            android:id="@id/gridview_preference"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_margin="6.0dip"
            android:columnWidth="87.0dip"
            android:numColumns="auto_fit" />
    </LinearLayout>
    <ImageView
        android:id="@id/stamp_line"
        android:background="@drawable/emoticon_line"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="1.5dip" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/layout_stamp"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1.0">
        <GridView
            android:id="@id/gridview_stamp"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginLeft="6.0dip"
            android:layout_marginTop="6.0dip"
            android:layout_marginRight="6.0dip"
            android:columnWidth="87.0dip"
            android:numColumns="auto_fit" />
    </LinearLayout>
</LinearLayout>