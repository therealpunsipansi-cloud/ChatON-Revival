<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="center"
    android:padding="2.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/layout_ams_image"
        android:background="@drawable/ams_ics_selector_basic_tool_frame"
        android:layout_width="112.0dip"
        android:layout_height="112.0dip"
        android:layout_centerInParent="true">
        <LinearLayout
            android:gravity="center"
            android:background="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:id="@id/image_ams_image"
                android:layout_width="108.0dip"
                android:layout_height="108.0dip"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="112.0dip"
        android:layout_height="112.0dip"
        android:layout_centerInParent="true">
        <LinearLayout
            android:gravity="center|right|top"
            android:layout_width="108.0dip"
            android:layout_height="108.0dip"
            android:layout_centerInParent="true">
            <CheckBox
                android:id="@id/check_box_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="-4.0dip"
                android:button="@drawable/ams_ics_selector_checkbox" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>