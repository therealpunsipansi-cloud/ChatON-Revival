<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="64.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <CheckBox
        android:gravity="center"
        android:id="@id/buddy_child_check"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="38.0dip"
        android:layout_height="48.0dip"
        android:layout_marginLeft="8.659973dip"
        android:layout_marginRight="0.6600001dip"
        android:button="@drawable/checkbox_background_xml"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true" />
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/buddy_child_check"
        style="@style/BuddyListItemImage">
        <ImageView
            android:id="@id/buddy_child_profile"
            android:layout_width="53.329987dip"
            android:layout_height="53.329987dip"
            android:layout_marginLeft="8.659973dip"
            android:layout_marginRight="8.0dip"
            android:layout_centerVertical="true" />
        <ImageView
            android:gravity="right"
            android:id="@id/buddy_like_badge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="37.0dip"
            android:layout_marginTop="37.0dip"
            android:src="@drawable/special_buddies_list_icon" />
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginRight="20.599976dip"
        android:layout_toRightOf="@id/buddy_child_profile">
        <TextView
            android:textSize="18.0dip"
            android:textColor="@color/brown_color_001"
            android:ellipsize="marquee"
            android:gravity="center|left|top"
            android:id="@id/buddy_child_name"
            android:layout_width="fill_parent"
            android:layout_height="23.699982dip"
            android:layout_marginTop="4.0999756dip"
            android:singleLine="true" />
        <TextView
            android:textSize="14.0dip"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:id="@id/buddy_child_status_msg"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginTop="3.5dip"
            android:layout_marginBottom="6.6999817dip"
            android:singleLine="true" />
    </LinearLayout>
</RelativeLayout>