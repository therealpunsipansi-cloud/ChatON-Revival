        android:textColor="@color/brown_color_001"
        android:id="@id/buddy_group_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6.659973dip"
        android:layout_marginRight="6.659973dip"
