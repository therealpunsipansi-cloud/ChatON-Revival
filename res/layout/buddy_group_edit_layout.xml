<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip" />
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@color/header_color"
        android:layout_width="fill_parent"
        android:layout_height="25.329987dip">
        <TextView
            android:textSize="14.0dip"
            android:textStyle="bold"
            android:textColor="@color/brown_color_001"
            android:ellipsize="marquee"
            android:id="@id/buddy_group_profile_title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6.659973dip"
            android:text="@string/buddy_group_profile_title"
            android:singleLine="true" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/buddy_group_profile_header_layout"
        android:layout_width="fill_parent"
        android:layout_height="54.659973dip"
        android:layout_weight="0.0">
        <TextView
            android:textSize="14.0dip"
            android:textColor="#ffffffff"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:id="@id/buddy_group_profile_groupname"
            android:background="@drawable/co_textfield_search_empty_02"
            android:paddingLeft="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="42.659973dip"
            android:layout_marginLeft="10.659973dip"
            android:layout_marginTop="6.0dip"
            android:layout_marginRight="10.659973dip"
            android:text="@string/buddy_group_list_newgroup_info"
            android:singleLine="true" />
        <LinearLayout
            android:id="@id/buddy_group_profile_edit_layout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginLeft="10.659973dip"
            android:layout_marginRight="8.0dip">
            <com.sec.widget.EditTextWithClearButton
                android:textSize="14.0dip"
                android:id="@id/buddy_group_profile_edit_groupname"
                android:background="@drawable/btn_search_dialog_xml"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_marginTop="6.0dip"
                android:layout_marginBottom="6.0dip"
                android:singleLine="true"
                android:maxLength="30"
                android:layout_weight="1.0"
                android:inputType="textCapSentences"
                android:imeOptions="actionDone" />
            <Button
                android:textSize="16.0dip"
                android:id="@id/buddy_group_profile_rename_groupname"
                android:layout_width="97.32999dip"
                android:layout_height="48.549988dip"
                android:layout_marginLeft="6.0dip"
                android:layout_marginTop="5.5dip"
                android:text="@string/buddy_list_dialog_addbuddy_save"
                android:layout_weight="0.0" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/buddy_group_profile_addmember_layout"
        android:layout_width="fill_parent"
        android:layout_height="58.299988dip"
        android:layout_weight="0.0">
        <ImageView
            android:id="@id/profile_birthday_area_bottom_line"
            android:background="#ff333a3a"
            android:layout_width="fill_parent"
            android:layout_height="0.30000007dip" />
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="fill_parent"
            android:layout_height="58.0dip">
            <ImageButton
                android:id="@id/buddy_group_profile_addmember"
                android:layout_width="45.329987dip"
                android:layout_height="40.659973dip"
                android:layout_marginLeft="8.659973dip"
                android:src="@drawable/buddy_profile_add_member_xml"
                android:layout_weight="0.0" />
            <TextView
                android:textSize="18.0dip"
                android:textColor="#ffffffff"
                android:gravity="center_vertical"
                android:id="@id/buddy_group_profile_addmember_info"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_marginLeft="10.0dip"
                android:text="@string/buddy_group_edit_menubar_add"
                android:layout_weight="1.0" />
            <ImageButton
                android:id="@id/buddy_group_profile_remove_member"
                android:layout_width="45.329987dip"
                android:layout_height="40.659973dip"
                android:layout_marginLeft="8.659973dip"
                android:src="@drawable/buddy_profile_remove_member_xml"
                android:layout_weight="0.0" />
            <TextView
                android:textSize="18.0dip"
                android:textColor="#ffffffff"
                android:gravity="center_vertical"
                android:id="@id/buddy_group_profile_remove_member_info"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_marginLeft="10.0dip"
                android:text="@string/buddy_group_edit_menubar_remove"
                android:layout_weight="1.0" />
        </LinearLayout>
    </LinearLayout>
    <HorizontalScrollView
        android:id="@id/buddy_choice_panel"
        android:background="@drawable/co_add_plate"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="40.0dip">
        <LinearLayout
            android:paddingLeft="3.3299866dip"
            android:paddingTop="2.6599731dip"
            android:paddingRight="3.3299866dip"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_margin="2.0dip" />
    </HorizontalScrollView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/group_search_bar"
        android:background="@drawable/co_search_plate"
        android:layout_width="fill_parent"
        android:layout_height="64.0dip">
        <com.sec.widget.EditTextWithClearButton
            android:textSize="14.0dip"
            android:textColor="@color/brown_color_002"
            android:gravity="center_vertical"
            android:id="@id/buddy_search_for_add"
            android:background="@drawable/btn_search_dialog_xml"
            android:paddingLeft="7.0dip"
            android:layout_width="fill_parent"
            android:layout_height="42.69998dip"
            android:layout_marginLeft="10.659973dip"
            android:layout_marginTop="10.699982dip"
            android:layout_marginRight="10.699982dip"
            android:layout_marginBottom="10.699982dip"
            android:hint="@string/buddy_list_search_hint"
            android:singleLine="true"
            android:maxLength="30"
            android:editable="true"
            android:layout_weight="1.0" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <com.sec.widget.FastScrollableExpandableListView
            android:id="@id/buddy_list_for_group_edit"
            android:background="@null"
            android:scrollbars="vertical"
            android:fadingEdge="vertical"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:scrollingCache="false"
            android:groupIndicator="@null"
            android:layout_weight="1.0" />
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@id/buddy_list_add_to_group_search_noresult_layout"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="0.0">
            <TextView
                android:textSize="18.0dip"
                android:textStyle="bold"
                android:textColor="#ffefad51"
                android:ellipsize="marquee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buddy_list_search_noresult"
                android:singleLine="true" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@id/buddy_group_nomembers_layout"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="0.0">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/no_lists" />
            <TextView
                android:textSize="24.0dip"
                android:textColor="#ff4e4e4e"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buddy_group_no_members" />
        </LinearLayout>
        <LinearLayout
            android:id="@id/group_menu_bar"
            android:background="@drawable/co_bg"
            android:paddingLeft="4.0dip"
            android:paddingTop="4.659973dip"
            android:paddingRight="4.0dip"
            android:paddingBottom="4.0dip"
            android:layout_width="fill_parent"
            android:layout_height="54.659973dip"
            android:layout_weight="0.0">
            <Button
                android:textSize="16.0dip"
                android:id="@id/buddy_add_to_group"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:text="@string/done"
                android:layout_weight="1.0" />
            <Button
                android:textSize="16.0dip"
                android:id="@id/buddy_remove_to_group"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:text="@string/done"
                android:layout_weight="1.0" />
            <Button
                android:textSize="16.0dip"
                android:id="@id/buddy_menu_cancel"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:text="@string/buddy_group_edit_menubar_cancel"
                android:layout_weight="1.0" />
            <Button
                android:textSize="16.0dip"
                android:id="@id/buddy_menu_groupchat"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:text="@string/buddy_list_menubar_groupchat"
                android:layout_weight="1.0" />
            <Button
                android:textSize="@dimen/text_size_buddy_list_menubar_broadcast"
                android:id="@id/buddy_menu_broadcast"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:text="@string/buddy_list_menubar_broadcast"
                android:layout_weight="1.0" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>