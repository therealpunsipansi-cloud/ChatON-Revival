<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@color/header_color"
        android:layout_width="fill_parent"
        android:layout_height="25.329987dip">
        <TextView
            android:textSize="14.0dip"
            android:textStyle="bold"
            android:textColor="@color/brown_color_001"
            android:id="@id/buddy_group_list_title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6.659973dip"
            android:text="@string/buddy_group_list_newgroup_info" />
    </LinearLayout>
    <LinearLayout
        android:id="@id/buddy_group_addgroup_area"
        android:layout_width="fill_parent"
        android:layout_height="54.659973dip"
        android:layout_marginLeft="10.659973dip"
        android:layout_marginRight="8.0dip">
        <com.sec.widget.EditTextWithClearButton
            android:textSize="14.0dip"
            android:id="@id/buddy_group_groupname_field"
            android:background="@drawable/btn_search_dialog_xml"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginTop="6.0dip"
            android:layout_marginBottom="6.0dip"
            android:hint="@string/buddy_group_list_newgroup_hint"
            android:singleLine="true"
            android:maxLength="30"
            android:capitalize="sentences"
            android:layout_weight="1.0"
            android:inputType="textCapSentences"
            android:imeOptions="actionDone" />
        <Button
            android:enabled="false"
            android:textSize="16.0dip"
            android:id="@id/buddy_group_create_btn"
            android:layout_width="97.32999dip"
            android:layout_height="48.549988dip"
            android:layout_marginLeft="6.0dip"
            android:layout_marginTop="5.5dip"
            android:text="@string/buddy_group_edit_menubar_add"
            android:layout_weight="0.0" />
    </LinearLayout>
</LinearLayout>