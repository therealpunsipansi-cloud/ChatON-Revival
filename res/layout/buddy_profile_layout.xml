<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@drawable/co_status_bar_header_bg3"
        android:layout_width="fill_parent"
        android:layout_height="50.0dip"
        android:layout_weight="0.0">
        <ImageView
            android:id="@id/profile_image"
            android:layout_width="43.329987dip"
            android:layout_height="43.329987dip"
            android:layout_marginLeft="8.0dip"
            android:layout_marginRight="14.659973dip"
            android:scaleType="fitXY"
            android:layout_weight="0.0" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="43.329987dip"
            android:layout_marginRight="6.659973dip"
            android:layout_weight="1.0">
            <TextView
                android:textSize="16.0dip"
                android:textStyle="bold"
                android:textColor="@color/brown_color_001"
                android:ellipsize="marquee"
                android:id="@id/profile_name"
                android:layout_width="fill_parent"
                android:layout_height="22.659973dip"
                android:singleLine="true"
                android:shadowColor="@color/brown_color_002"
                android:shadowDx="-1.0"
                android:shadowDy="-1.0" />
            <TextView
                android:textSize="14.0dip"
                android:textColor="#ffffe2b6"
                android:ellipsize="marquee"
                android:id="@id/profile_status_message"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:singleLine="true" />
        </LinearLayout>
        <ImageView
            android:background="@drawable/pbook_favorite_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.0" />
        <CheckBox
            android:id="@id/profile_is_favorite"
            android:layout_width="32.0dip"
            android:layout_height="32.0dip"
            android:layout_marginLeft="9.329987dip"
            android:layout_marginRight="9.329987dip"
            android:button="@drawable/buddyprofile_favorite_btn_xml"
            android:layout_weight="0.0"
            android:layout_centerVertical="true" />
    </LinearLayout>
    <ListView
        android:id="@id/profile_memo_list"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:headerDividersEnabled="false"
        android:footerDividersEnabled="false" />
</LinearLayout>