<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/rLayoutChatParent"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <TextView
            android:textSize="14.0dip"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@id/title_menu"
            android:background="@drawable/co_title_bar"
            android:paddingLeft="7.299988dip"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="25.329987dip"
            android:text="@string/layout_chat_fragment_delete"
            android:layout_alignParentTop="true" />
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@id/ldeletetop"
            android:background="@drawable/co_bt_bg2"
            android:padding="7.299988dip"
            android:visibility="gone"
            android:alwaysDrawnWithCache="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="16.0dip"
                android:id="@id/btnRangeAll"
                android:layout_width="97.29999dip"
                android:layout_height="fill_parent"
                android:layout_marginTop="2.0dip"
                android:layout_marginRight="6.5999756dip"
                android:text="@string/layout_chat_fragment_selectall"
                android:layout_weight="1.0" />
            <Button
                android:textSize="16.0dip"
                android:id="@id/btnRangeRcv"
                android:layout_width="97.29999dip"
                android:layout_height="fill_parent"
                android:layout_marginTop="2.0dip"
                android:layout_marginRight="6.5999756dip"
                android:text="@string/layout_chat_fragment_received"
                android:layout_weight="1.0" />
            <Button
                android:textSize="16.0dip"
                android:id="@id/btnRangeSnt"
                android:layout_width="97.29999dip"
                android:layout_height="fill_parent"
                android:layout_marginTop="2.0dip"
                android:text="@string/layout_chat_fragment_sent"
                android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/lLayoutChat"
            android:background="@color/chat_backgroun"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/lLayoutProfile"
                android:background="@drawable/co_status_bar_header_bg2"
                android:layout_width="fill_parent"
                android:layout_height="55.299988dip">
                <LinearLayout
                    android:layout_gravity="right"
                    android:id="@id/LinearLayout02"
                    android:layout_width="wrap_content"
                    android:layout_height="54.0dip">
                    <RelativeLayout
                        android:id="@id/LayoutChatcount"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="fill_parent">
                        <com.sec.chaton.widget.ProfileImageView
                            android:layout_gravity="center"
                            android:id="@id/Chaticon"
                            android:layout_width="40.0dip"
                            android:layout_height="40.0dip"
                            android:layout_marginLeft="6.299988dip"
                            android:layout_marginTop="6.299988dip" />
                        <TextView
                            android:textSize="12.0dip"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@id/unReadCount"
                            android:background="@drawable/msg_icon_newmsg_num_bg"
                            android:focusable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="30.0dip"
                            android:layout_marginTop="28.0dip" />
                    </RelativeLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/LinearLayout01"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_weight="1.0">
                    <com.sec.chaton.util.EllipsisTextView
                        android:textSize="17.0dip"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:id="@id/textNames"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8.0dip"
                        android:layout_marginTop="2.0dip"
                        android:maxLines="2"
                        android:shadowColor="@color/black"
                        android:shadowDx="1.0"
                        android:shadowDy="1.0"
                        android:shadowRadius="1.0"
                        android:layout_toLeftOf="@id/textStatus" />
                    <TextView
                        android:textSize="14.0dip"
                        android:textColor="@color/chat_title_status"
                        android:ellipsize="marquee"
                        android:id="@id/textStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8.0dip"
                        android:singleLine="true"
                        android:shadowColor="@color/chat_title_status_shadow"
                        android:shadowDx="1.0"
                        android:shadowDy="1.0"
                        android:shadowRadius="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="right"
                    android:id="@id/LinearLayout03"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@id/LayoutTrunkcount"
                        android:visibility="visible"
                        android:layout_width="52.0dip"
                        android:layout_height="fill_parent">
                        <ImageView
                            android:id="@id/imageTrunkBg"
                            android:background="@drawable/header_icon_bg"
                            android:layout_width="46.0dip"
                            android:layout_height="41.0dip"
                            android:layout_marginTop="6.299988dip" />
                        <ImageButton
                            android:id="@id/imageTrunk"
                            android:background="@drawable/trunk_image_button"
                            android:layout_width="38.599976dip"
                            android:layout_height="38.599976dip"
                            android:layout_marginLeft="3.6999817dip"
                            android:layout_marginTop="7.0dip" />
                        <TextView
                            android:textSize="12.0dip"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@id/unReadTrunkCount"
                            android:background="@drawable/msg_icon_newmsg_num_bg"
                            android:focusable="false"
                            android:layout_width="26.0dip"
                            android:layout_height="26.0dip"
                            android:layout_marginLeft="24.0dip"
                            android:layout_marginTop="2.0dip" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:id="@id/chatlistframe"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <ImageView
                    android:id="@id/imagebackgroup"
                    android:visibility="visible"
                    android:layout_width="321.29688dip"
                    android:layout_height="508.0dip" />
                <com.sec.widget.HeightChangedListView
                    android:id="@id/chat_listview"
                    android:background="@null"
                    android:alwaysDrawnWithCache="true"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:listSelector="#00000000"
                    android:cacheColorHint="#00000000"
                    android:divider="@null"
                    android:layout_weight="1.0" />
                <com.sec.chaton.util.EllipsisTextView
                    android:textSize="17.0dip"
                    android:textColor="@color/gray"
                    android:gravity="center"
                    android:layout_gravity="bottom"
                    android:id="@id/previewText"
                    android:background="#88ffffff"
                    android:visibility="invisible"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="vertical"
            android:id="@id/chatEditLayout"
            android:background="@color/chat_backgroun"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <CheckBox
                android:id="@id/chkEditTrans"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:button="@drawable/checkbox_background_xml"
                android:text="@string/layout_chat_fragment_translation" />
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/lLayoutMsgEdit"
                android:background="@drawable/co_bt_bg1"
                android:paddingTop="5.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <ImageButton
                        android:layout_gravity="bottom"
                        android:id="@id/btnAdd"
                        android:background="@drawable/chat_attach_button_xml"
                        android:layout_width="32.0dip"
                        android:layout_height="42.0dip"
                        android:layout_marginLeft="2.6999817dip"
                        android:layout_marginBottom="4.6999817dip" />
                    <ImageButton
                        android:layout_gravity="bottom"
                        android:id="@id/btnChatImage"
                        android:background="@drawable/chat_emoticon_button_xml"
                        android:layout_width="32.0dip"
                        android:layout_height="42.0dip"
                        android:layout_marginLeft="2.6999817dip"
                        android:layout_marginBottom="4.6999817dip"
                        android:onClick="onEmoticonClick" />
                    <EditText
                        android:textSize="16.0dip"
                        android:textColorHint="#aa71360c"
                        android:id="@id/editChatMsg"
                        android:paddingLeft="7.0dip"
                        android:focusable="true"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/chat_enter_message_hint"
                        android:maxLines="5"
                        android:maxLength="2000"
                        android:inputType="textCapSentences"
                        android:imeOptions="actionUnspecified|normal" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent">
                    <Button
                        android:enabled="false"
                        android:textSize="14.0dip"
                        android:textColor="@color/chat_send_button_xml"
                        android:layout_gravity="bottom"
                        android:id="@id/btnChatSend"
                        android:background="@drawable/chat_title"
                        android:layout_width="56.0dip"
                        android:layout_height="42.0dip"
                        android:layout_marginRight="4.6999817dip"
                        android:layout_marginBottom="2.0dip"
                        android:text="@string/layout_chat_fragment_send" />
                </LinearLayout>
                <Button
                    android:id="@id/btnImoticon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@id/ldeletebot"
            android:background="@drawable/co_bt_bg1"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <Button
                android:enabled="false"
                android:layout_gravity="center_vertical"
                android:id="@id/btnDelete"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginLeft="2.0dip"
                android:layout_marginTop="3.0dip"
                android:text="@string/layout_chat_fragment_delete"
                android:layout_weight="0.5" />
            <Button
                android:layout_gravity="center_vertical"
                android:id="@id/btnDelCancel"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="3.0dip"
                android:layout_marginRight="2.0dip"
                android:text="@string/layout_chat_fragment_cancel"
                android:layout_weight="0.5" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:scrollbarStyle="outsideOverlay"
        android:orientation="vertical"
        android:id="@id/scrollemoticon"
        android:background="@drawable/bg_emoticon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="142.6dip"
        android:layout_marginTop="3.0dip">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/linearemoticon"
            android:background="#00000000"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="142.6dip">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/linearemoticontop"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="47.0dip">
                <GridView
                    android:gravity="center"
                    android:id="@id/emoticonGrid1"
                    android:visibility="visible"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:listSelector="@drawable/co_emoti_selected_02"
                    android:horizontalSpacing="8.0dip"
                    android:stretchMode="columnWidth"
                    android:columnWidth="34.599976dip"
                    android:numColumns="auto_fit" />
            </LinearLayout>
            <ImageView
                android:id="@id/imageline"
                android:background="@drawable/emoticon_line"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="1.5dip" />
            <GridView
                android:gravity="center"
                android:id="@id/emoticonGrid0"
                android:layout_width="fill_parent"
                android:layout_height="530.0dip"
                android:listSelector="@drawable/co_emoti_selected_02"
                android:horizontalSpacing="8.0dip"
                android:verticalSpacing="8.0dip"
                android:stretchMode="columnWidth"
                android:columnWidth="34.599976dip"
                android:numColumns="auto_fit"
                android:layout_weight="1.0" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>