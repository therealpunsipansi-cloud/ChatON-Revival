<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/rLayoutBalloon"
        android:background="@null"
        android:paddingLeft="5.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="5.0dip"
        android:paddingBottom="1.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        xmlns:android="http://schemas.android.com/apk/res/android">
        <RelativeLayout
            android:orientation="vertical"
            android:id="@id/lLayoutDate"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6.0dip"
            android:layout_marginBottom="5.0dip"
            android:layout_toLeftOf="@id/DateRcvId">
            <ImageView
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/textDateLeft"
                android:background="@drawable/chat_date_invite_line"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="2.0dip"
                android:layout_toLeftOf="@id/textDate"
                android:layout_centerVertical="true" />
            <TextView
                android:textSize="14.0dip"
                android:textColor="@color/white"
                android:id="@id/textDate"
                android:background="@drawable/chat_date_invite_bg"
                android:paddingLeft="15.0dip"
                android:paddingRight="15.0dip"
                android:longClickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5.799988dip"
                android:layout_marginBottom="9.299988dip"
                android:shadowColor="#ff0f0f0f"
                android:shadowDy="1.0"
                android:shadowRadius="1.0"
                android:layout_centerInParent="true" />
            <ImageView
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/textDateRight"
                android:background="@drawable/chat_date_invite_line"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2.0dip"
                android:layout_toRightOf="@id/textDate"
                android:layout_centerVertical="true" />
        </RelativeLayout>
        <CheckBox
            android:id="@id/DateRcvId"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="@drawable/checkbox_background_xml"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true" />
        <RelativeLayout
            android:orientation="vertical"
            android:id="@id/lLayoutInvite"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6.0dip"
            android:layout_marginBottom="5.0dip"
            android:layout_below="@id/lLayoutDate">
            <TextView
                android:textSize="12.0dip"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/textInvite"
                android:background="@drawable/chat_date_invite_bg"
                android:paddingLeft="15.0dip"
                android:paddingRight="15.0dip"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#ff0f0f0f"
                android:shadowDx="1.0"
                android:shadowDy="1.0"
                android:shadowRadius="1.0"
                android:layout_below="@id/lLayoutDate"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>
        <RelativeLayout
            android:id="@id/parentRcv"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/lLayoutDate">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/lLayoutRcvContent2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">
                <com.sec.chaton.widget.ProfileImageView
                    android:id="@id/imageProfile"
                    android:padding="0.6dip"
                    android:layout_width="40.0dip"
                    android:layout_height="40.0dip"
                    android:layout_marginBottom="16.0dip"
                    android:scaleType="fitCenter"
                    android:layout_alignParentBottom="true" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/lLayoutRcvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">
                <TextView
                    android:textSize="10.0dip"
                    android:textColor="#ff141414"
                    android:layout_gravity="top"
                    android:id="@id/textName"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="200.0dip"
                    android:lines="1"
                    android:shadowColor="#ccffffff"
                    android:shadowDx="1.0"
                    android:shadowDy="1.0"
                    android:shadowRadius="1.0" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/lLayoutRcvContent3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16.0dip"
                android:layout_toRightOf="@id/lLayoutRcvContent2"
                android:layout_alignParentBottom="true">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@id/lLayoutRcvContent"
                    android:background="@drawable/message_bubble_receive1"
                    android:focusable="true"
                    android:addStatesFromChildren="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="11.299988dip"
                    android:maxWidth="100.0dip"
                    android:layout_toRightOf="@id/lLayoutRcvContent2">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/bubbleLayout_R"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="16.0dip"
                            android:textColor="@color/black"
                            android:textColorLink="#ff153da5"
                            android:gravity="left"
                            android:autoLink="all"
                            android:id="@id/textRcvContent"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8.0dip"
                            android:layout_marginRight="8.0dip"
                            android:layout_marginBottom="8.0dip"
                            android:maxWidth="198.0dip"
                            android:shadowColor="#ffffffff"
                            android:shadowDx="1.0"
                            android:shadowDy="1.0"
                            android:shadowRadius="1.0" />
                        <ImageView
                            android:id="@id/imageRcvContent"
                            android:background="@drawable/msg_image_bg"
                            android:visibility="gone"
                            android:layout_width="66.599976dip"
                            android:layout_height="66.599976dip"
                            android:layout_marginLeft="10.0dip"
                            android:layout_marginTop="6.0dip"
                            android:layout_marginRight="12.0dip"
                            android:layout_marginBottom="6.0dip"
                            android:scaleType="fitXY" />
                        <ProgressBar
                            android:layout_gravity="center"
                            android:id="@id/imageLoadingProgressbar"
                            android:visibility="gone"
                            android:layout_width="38.0dip"
                            android:layout_height="38.0dip"
                            android:layout_marginLeft="7.0dip"
                            android:layout_marginTop="3.0dip"
                            android:indeterminateDrawable="@anim/progressbar_chat_image" />
                        <TextView
                            android:textSize="10.599976dip"
                            android:id="@id/spaceText_R"
                            android:focusable="false"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="17.0dip"
                            android:text="(000)00:00 AM" />
                    </LinearLayout>
                    <ImageView
                        android:id="@id/imageRcvTranIcon"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4.0dip"
                        android:src="@drawable/messenger_icon_translate" />
                    <TextView
                        android:textSize="16.0dip"
                        android:textStyle="normal"
                        android:textColor="@color/chat_translate"
                        android:id="@id/textRcvTranslated"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="200.0dip"
                        android:layout_below="@id/lLayoutRcvContent" />
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/bubbleLayout_RE"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:id="@id/lLayoutETC"
                            android:visibility="visible"
                            android:addStatesFromChildren="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10.0dip"
                            android:layout_marginTop="6.0dip"
                            android:layout_marginRight="12.0dip"
                            android:layout_marginBottom="12.0dip">
                            <ImageView
                                android:id="@id/imageEtcContent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/messenger_chat_contact" />
                            <TextView
                                android:textColor="@color/black"
                                android:id="@id/textEtcContent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="160.0dip" />
                        </LinearLayout>
                        <TextView
                            android:textSize="10.599976dip"
                            android:id="@id/spaceText_RE"
                            android:focusable="false"
                            android:visibility="invisible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="17.0dip"
                            android:text="(000)00:00 AM" />
                    </LinearLayout>
                    <RelativeLayout
                        android:layout_gravity="right"
                        android:id="@id/lLayoutTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="10.599976dip"
                            android:textColor="#ff282319"
                            android:id="@id/textRcvTime"
                            android:paddingRight="17.0dip"
                            android:paddingBottom="12.0dip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10:10 PM"
                            android:maxLines="1" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:id="@id/lLayoutsendread"
                android:paddingBottom="24.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/lLayoutRcvContent3"
                android:layout_alignBottom="@id/lLayoutRcvContent3" />
            <ProgressBar
                android:id="@id/progressbarDown"
                android:visibility="gone"
                android:layout_width="96.0dip"
                android:layout_height="9.329987dip"
                android:layout_marginBottom="2.0dip"
                android:max="100"
                android:progressDrawable="@drawable/progressbar_custom"
                android:layout_toRightOf="@id/lLayoutRcvContent3"
                android:layout_above="@id/btnDownCancel"
                style="@android:style/Widget.ProgressBar.Horizontal" />
            <ProgressBar
                android:id="@id/DownProgressBalloon"
                android:visibility="gone"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                android:layout_margin="2.0dip"
                android:indeterminateDrawable="@anim/progressbar_ssm"
                android:layout_toRightOf="@id/lLayoutRcvContent3"
                android:layout_alignBottom="@id/btnDownCancel" />
            <Button
                android:id="@id/btnDownCancel"
                android:background="@drawable/message_send_cancle"
                android:visibility="gone"
                android:layout_width="25.299988dip"
                android:layout_height="25.299988dip"
                android:layout_toRightOf="@id/DownProgressBalloon"
                android:layout_above="@id/lLayoutsendread" />
            <LinearLayout
                android:gravity="right"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10.0dip"
                android:layout_centerInParent="true">
                <CheckBox
                    android:id="@id/chkRcvId"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:button="@drawable/checkbox_background_xml" />
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@id/rSendRoot"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/lLayoutDate" />
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="5.0dip"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
</LinearLayout>