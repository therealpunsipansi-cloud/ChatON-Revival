<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/vcard_item"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="fill_parent"
        android:layout_height="64.0dip">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/vcard_item_text_layout"
            android:paddingLeft="9.5dip"
            android:paddingRight="5.0dip"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0">
            <TextView
                android:textSize="14.0dip"
                android:textColor="#ffffa800"
                android:ellipsize="marquee"
                android:id="@id/list_vcard_main_text"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:singleLine="true" />
            <TextView
                android:textSize="22.0dip"
                android:textColor="@color/brown_color_029"
                android:ellipsize="marquee"
                android:id="@id/list_vcard_sub_text"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                android:singleLine="true" />
        </LinearLayout>
        <ImageView
            android:id="@id/vcard_checkbtn"
            android:layout_width="38.0dip"
            android:layout_height="48.0dip"
            android:layout_marginLeft="9.329987dip"
            android:layout_marginRight="10.0dip"
            android:src="@drawable/co_btn_check_on_disable"
            android:scaleType="fitXY"
            android:layout_weight="0.0" />
    </LinearLayout>
</LinearLayout>