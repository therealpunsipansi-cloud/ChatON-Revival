<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/vcard_item"
    android:layout_width="fill_parent"
    android:layout_height="60.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/vcard_item_ralationlayout"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/vcard_item_text_layout"
            android:layout_width="270.0dip"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7.0dip"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="12.0sp"
                android:id="@id/list_vcard_main_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true" />
            <TextView
                android:textSize="20.0sp"
                android:textColor="#ffffffff"
                android:id="@id/list_vcard_sub_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true" />
        </LinearLayout>
        <ImageView
            android:id="@id/vcard_item_icon"
            android:layout_width="30.0dip"
            android:layout_height="30.0dip"
            android:layout_marginTop="20.0dip"
            android:layout_marginRight="5.0dip"
            android:src="@android:drawable/sym_action_call"
            android:scaleType="fitXY"
            android:layout_alignParentRight="true" />
        <ImageView
            android:background="#88ffffff"
            android:layout_width="fill_parent"
            android:layout_height="0.30000007dip"
            android:layout_alignParentBottom="true" />
    </RelativeLayout>
</LinearLayout>