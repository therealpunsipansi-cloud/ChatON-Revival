<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_gravity="center"
    android:paddingLeft="3.0dip"
    android:paddingTop="3.0dip"
    android:paddingRight="3.0dip"
    android:paddingBottom="3.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_gravity="center"
        android:layout_width="95.599976dip"
        android:layout_height="95.599976dip">
        <ImageView
            android:id="@id/thumbnail"
            android:layout_width="94.599976dip"
            android:layout_height="94.599976dip"
            android:scaleType="centerCrop" />
        <ImageView
            android:id="@id/playButton"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/msg_play_button"
            android:layout_centerInParent="true" />
        <ProgressBar
            android:id="@id/downloadProgressbar"
            android:visibility="gone"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:indeterminateDrawable="@anim/progressbar_ssm"
            android:layout_centerInParent="true" />
        <View
            android:id="@id/unreadCommentBorder"
            android:background="@drawable/trunk_item_image_border"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
        <TextView
            android:textSize="13.299988dip"
            android:textStyle="bold"
            android:textColor="@color/color1"
            android:gravity="center_horizontal"
            android:id="@id/totalCommentCountTextView"
            android:background="@drawable/thumbnail_bubble"
            android:paddingLeft="3.0dip"
            android:paddingRight="3.0dip"
            android:layout_width="24.699982dip"
            android:layout_height="25.299988dip"
            android:layout_marginTop="3.5999756dip"
            android:layout_marginRight="3.0dip"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true" />
    </RelativeLayout>
</RelativeLayout>