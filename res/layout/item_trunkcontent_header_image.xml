<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="182.6dip">
        <ImageView
            android:id="@id/trunkContentMainImage"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="fitCenter" />
        <ImageView
            android:layout_gravity="center"
            android:id="@id/defaultPlayBtn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/msg_play_button_03" />
        <ProgressBar
            android:layout_gravity="center"
            android:id="@id/trunkContentDownloadProgressbar"
            android:visibility="gone"
            android:layout_width="48.0dip"
            android:layout_height="48.0dip"
            android:indeterminateDrawable="@anim/progressbar_trunk" />
    </FrameLayout>
    <LinearLayout
        android:gravity="right"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="26.699982dip">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginTop="3.2999878dip"
            android:layout_marginRight="3.2999878dip"
            android:src="@drawable/ic_comment" />
        <TextView
            android:textSize="14.0dip"
            android:textColor="#ffe07a20"
            android:gravity="center_vertical"
            android:id="@id/trunkContentCommentCount"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginRight="10.0dip"
            android:singleLine="true" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@id/previousView"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="44.299988dip">
            <Button
                android:textSize="16.0dip"
                android:textColor="@color/color2"
                android:layout_gravity="center"
                android:id="@id/previousCommentButton"
                android:background="@drawable/trunk_previous_comment_button_xml"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="31.299988dip"
                android:layout_marginLeft="6.5999756dip"
                android:layout_marginRight="6.5999756dip"
                android:text="@string/trunk_btn_previous_comments"
                android:singleLine="true" />
            <Button
                android:textSize="16.0dip"
                android:textColor="@color/color2"
                android:layout_gravity="center"
                android:id="@id/refreshCommentButton"
                android:background="@drawable/trunk_previous_comment_button_xml"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="31.299988dip"
                android:layout_marginLeft="6.5999756dip"
                android:layout_marginRight="6.5999756dip"
                android:text="@string/trunk_menu_refresh"
                android:singleLine="true" />
        </FrameLayout>
        <FrameLayout
            android:id="@id/trunkCommentsLoadingProgressbar"
            android:background="#ff000000"
            android:layout_width="fill_parent"
            android:layout_height="44.299988dip">
            <ProgressBar
                android:layout_gravity="center"
                android:layout_width="14.0dip"
                android:layout_height="14.0dip"
                android:indeterminateDrawable="@anim/progressbar_ssm" />
        </FrameLayout>
    </FrameLayout>
    <TextView
        android:textSize="17.299988dip"
        android:textColor="@color/color1"
        android:gravity="center"
        android:id="@id/trunkNoCommentTextView"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.0dip"
        android:layout_marginBottom="10.0dip"
        android:text="@string/trunk_write_comment"
        android:inputType="textMultiLine" />
</LinearLayout>