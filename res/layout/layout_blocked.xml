<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/l_layout_blocked"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:background="@drawable/co_title_bar"
        android:paddingLeft="6.0dip"
        android:layout_width="fill_parent"
        android:layout_height="25.0dip"
        android:text="@string/setting_blocked_list" />
    <ListView
        android:id="@id/list"
        android:background="@null"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:drawSelectorOnTop="false"
        android:scrollingCache="false"
        android:layout_weight="1.0"
        android:fastScrollEnabled="true" />
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@id/no_item_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_weight="1.0">
        <ImageView
            android:layout_gravity="center"
            android:background="@drawable/no_lists"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:textSize="24.0dip"
            android:textColor="@color/gray"
            android:gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_title_noblock_item" />
    </LinearLayout>
</LinearLayout>