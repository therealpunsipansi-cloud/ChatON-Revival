<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="fill_vertical"
    android:orientation="vertical"
    android:background="#ff808080"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:id="@id/label_hue"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="@string/scribble_hue" />
    <com.sec.chaton.util.ColorSelector
        android:id="@id/hue"
        android:layout_width="100.0dip"
        android:layout_height="200.0dip" />
    <TextView
        android:id="@id/label_saturation"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="@string/scribble_saturation" />
    <com.sec.chaton.util.ColorSlider
        android:id="@id/satutation"
        android:layout_width="100.0dip"
        android:layout_height="50.0dip" />
    <TextView
        android:id="@id/label_brightness"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="@string/scribble_brightness" />
    <com.sec.chaton.util.ColorSlider
        android:id="@id/brightness"
        android:layout_width="100.0dip"
        android:layout_height="50.0dip" />
</LinearLayout>