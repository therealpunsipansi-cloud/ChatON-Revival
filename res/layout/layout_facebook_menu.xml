<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:background="@drawable/co_title_bar"
            android:paddingLeft="6.6999817dip"
            android:layout_width="fill_parent"
            android:layout_height="25.299988dip"
            android:text="@string/user_facebook_account" />
        <TextView
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:background="@drawable/userprofile_interaction_background"
            android:paddingLeft="6.6999817dip"
            android:layout_width="fill_parent"
            android:layout_height="25.299988dip"
            android:text="@string/facebook_header_post" />
        <TextView
            android:textSize="22.0dip"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@id/facebook_menu_invitation_card"
            android:background="@drawable/userprofile_title_background"
            android:paddingLeft="13.299988dip"
            android:layout_width="fill_parent"
            android:layout_height="64.0dip"
            android:text="@string/facebook_invitation_card" />
        <View
            android:background="#ff333a3a"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="0.30000007dip" />
        <TextView
            android:textSize="22.0dip"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@id/facebook_menu_chaton_family"
            android:background="@drawable/userprofile_title_background"
            android:paddingLeft="13.299988dip"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="64.0dip"
            android:text="@string/facebook_chaton_family" />
        <TextView
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:background="@drawable/userprofile_interaction_background"
            android:paddingLeft="6.6999817dip"
            android:layout_width="fill_parent"
            android:layout_height="25.299988dip"
            android:layout_marginTop="6.0dip"
            android:text="@string/facebook_header_logout" />
        <TextView
            android:textSize="22.0dip"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@id/facebook_menu_logout"
            android:background="@drawable/userprofile_title_background"
            android:paddingLeft="13.299988dip"
            android:layout_width="fill_parent"
            android:layout_height="64.0dip"
            android:text="@string/logout" />
        <View
            android:background="#ff333a3a"
            android:layout_width="fill_parent"
            android:layout_height="0.30000007dip" />
    </LinearLayout>
</ScrollView>