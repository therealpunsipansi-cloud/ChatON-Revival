<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@id/msg_no"
        android:visibility="gone"
        android:alwaysDrawnWithCache="false"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <ImageView
            android:id="@id/msg_no_item"
            android:background="@drawable/noitems_no_chat"
            android:layout_width="wrap_content"
            android:layout_height="116.0dip" />
        <TextView
            android:textSize="24.0dip"
            android:textColor="#4dffffff"
            android:gravity="center"
            android:id="@id/msg_no_item_text"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/layout_msgbox_no_chat" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/linList"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1.0">
        <ListView
            android:id="@android:id/list"
            android:background="@null"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:cacheColorHint="#00000000"
            android:layout_weight="1.0"
            android:fastScrollEnabled="true" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/lLayoutMenu"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="50.0dip">
        <Button
            android:id="@id/btnLeave"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:text="@string/layout_chat_fragment_delete"
            android:layout_weight="1.0" />
        <Button
            android:id="@id/btnCancel"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:text="@string/layout_chat_fragment_cancel"
            android:layout_weight="1.0" />
    </LinearLayout>
</LinearLayout>