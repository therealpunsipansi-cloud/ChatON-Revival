<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <Button
        android:textSize="20.0dip"
        android:id="@id/btn_stop_play_audio"
        android:layout_width="fill_parent"
        android:layout_height="50.0dip"
        android:text="@string/layout_audio_stop"
        android:layout_below="@id/btn_start_play_audio" />
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Button
            android:id="@id/btn_send"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/layout_audio_send"
            android:layout_weight="1.0" />
        <Button
            android:id="@id/btn_discard"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/layout_audio_discard"
            android:layout_weight="1.0" />
    </LinearLayout>
    <Button
        android:textSize="20.0dip"
        android:id="@id/btn_start_play_audio"
        android:layout_width="fill_parent"
        android:layout_height="50.0dip"
        android:layout_marginTop="120.0dip"
        android:text="@string/layout_audio_play"
        android:layout_alignParentRight="true" />
    <TextView
        android:textSize="25.0dip"
        android:id="@id/Timechek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80.0dip"
        android:text="@string/layout_audio_timer"
        android:layout_above="@id/btn_send"
        android:layout_centerHorizontal="true" />
</RelativeLayout>