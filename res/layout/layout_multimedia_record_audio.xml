<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/LinearLayout01"
    android:background="@drawable/chaton_attach_record_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center|left"
        android:paddingLeft="146.0dip"
        android:paddingTop="13.0dip"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@id/record_voice_recording"
            android:background="@drawable/chaton_attach_record_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/record_video_recording_status_xml" />
        <TextView
            android:textSize="28.0dip"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/record_voice_elapsed_time"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.0dip"
            android:text="@string/layout_audio_rec_string" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_weight="3.0">
        <ImageView
            android:id="@id/record_bg"
            android:background="@drawable/chaton_chats_attach_record_mic"
            android:layout_width="349.0dip"
            android:layout_height="506.0dip" />
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@id/LinearLayout02"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@id/progressbarLayout"
            android:paddingLeft="146.0dip"
            android:visibility="invisible"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12.0dip">
            <TextView
                android:textSize="22.0dip"
                android:textColor="#ff000000"
                android:gravity="center"
                android:id="@id/Timechek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20.0dip"
                android:text="@string/layout_audio_timer_run"
                android:layout_toLeftOf="@id/progressbar"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true" />
            <SeekBar
                android:id="@id/progressbar"
                android:layout_width="817.0dip"
                android:layout_height="wrap_content"
                android:layout_marginLeft="232.0dip"
                android:max="1200"
                android:progress="0"
                android:progressDrawable="@drawable/seekbar_progress"
                android:thumb="@null"
                android:thumbOffset="20.0dip"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true" />
            <TextView
                android:textSize="22.0dip"
                android:textColor="#ff000000"
                android:gravity="center"
                android:id="@id/Timechekdim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20.0dip"
                android:text="@string/layout_audio_timer_dim"
                android:layout_toRightOf="@id/progressbar"
                android:layout_centerVertical="true" />
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:background="@drawable/chaton_attach_record_btbg"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@id/Relativebottom"
                android:paddingTop="12.0dip"
                android:layout_width="564.0dip"
                android:layout_height="105.0dip">
                <ImageView
                    android:id="@id/btn_cancel_record_audio"
                    android:background="@drawable/bottom_button_background"
                    android:focusable="true"
                    android:layout_width="184.0dip"
                    android:layout_height="82.0dip"
                    android:src="@drawable/btn_record_audio_cancel"
                    android:scaleType="center"
                    android:layout_weight="1.0" />
                <ImageView
                    android:id="@id/btn_start_record_audio"
                    android:background="@drawable/bottom_button_background"
                    android:focusable="true"
                    android:layout_width="184.0dip"
                    android:layout_height="82.0dip"
                    android:layout_marginLeft="6.0dip"
                    android:layout_marginRight="6.0dip"
                    android:src="@drawable/record_voice_recording"
                    android:scaleType="center"
                    android:layout_weight="1.0" />
                <ImageView
                    android:id="@id/btn_send_record_audio"
                    android:background="@drawable/bottom_button_background"
                    android:focusable="true"
                    android:layout_width="184.0dip"
                    android:layout_height="82.0dip"
                    android:src="@drawable/btn_record_audio_send"
                    android:scaleType="center"
                    android:layout_weight="1.0" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>