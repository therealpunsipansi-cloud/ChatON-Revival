<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip" />
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@color/header_color"
        android:layout_width="fill_parent"
        android:layout_height="25.329987dip">
        <TextView
            android:textSize="14.0dip"
            android:textStyle="bold"
            android:textColor="@color/brown_color_001"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6.659973dip"
            android:text="@string/layout_vcalendar_calendar_list" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/co_search_plate"
        android:layout_width="fill_parent"
        android:layout_height="64.0dip">
        <com.sec.widget.EditTextWithClearButton
            android:textColor="@color/brown_color_002"
            android:gravity="center_vertical"
            android:id="@id/vcal_events_search"
            android:background="@drawable/btn_search_dialog_xml"
            android:paddingLeft="7.0dip"
            android:layout_width="fill_parent"
            android:layout_height="42.69998dip"
            android:layout_marginLeft="10.659973dip"
            android:layout_marginTop="6.0dip"
            android:layout_marginRight="10.699982dip"
            android:layout_marginBottom="6.0dip"
            android:hint="@string/vcalendar_list_search_hint"
            android:singleLine="true"
            android:editable="true"
            android:layout_weight="1.0"
            android:imeOptions="actionDone" />
    </LinearLayout>
    <ExpandableListView
        android:id="@id/vcal_events_list"
        android:background="@null"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:scrollingCache="false"
        android:groupIndicator="@null"
        android:layout_weight="1.0" />
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@id/vcal_events_noresult"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="0.0">
        <TextView
            android:textSize="18.0dip"
            android:textStyle="bold"
            android:textColor="#ffefad51"
            android:ellipsize="marquee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calendar_no_events"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>