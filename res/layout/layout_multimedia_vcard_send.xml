<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/linear_layout_vcard_send"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip" />
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@color/header_color"
        android:layout_width="fill_parent"
        android:layout_height="25.329987dip">
        <TextView
            android:textSize="14.0dip"
            android:textStyle="bold"
            android:textColor="@color/brown_color_001"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6.659973dip"
            android:text="@string/menu_multimedia_contact" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@drawable/co_status_bar_header_bg3"
        android:layout_width="fill_parent"
        android:layout_height="50.0dip"
        android:layout_weight="0.0">
        <ImageView
            android:id="@id/vcard_image_icon"
            android:layout_width="43.329987dip"
            android:layout_height="43.329987dip"
            android:layout_marginLeft="6.0dip"
            android:layout_marginRight="2.0dip"
            android:src="@drawable/msg_list_id_default"
            android:scaleType="fitXY"
            android:layout_weight="0.0" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="43.329987dip"
            android:layout_marginRight="9.329987dip"
            android:layout_weight="1.0">
            <TextView
                android:textSize="16.0dip"
                android:textStyle="bold"
                android:textColor="@color/brown_color_001"
                android:ellipsize="marquee"
                android:id="@id/vcard_name_text"
                android:layout_width="fill_parent"
                android:layout_height="22.659973dip"
                android:singleLine="true"
                android:shadowColor="@color/brown_color_002"
                android:shadowDx="-1.0"
                android:shadowDy="-1.0" />
            <TextView
                android:textSize="14.0dip"
                android:textColor="#ffffe2b6"
                android:ellipsize="marquee"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>
    <ListView
        android:id="@android:id/list"
        android:background="@null"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0"
        android:fastScrollEnabled="true" />
    <LinearLayout
        android:id="@id/vcard_menubar"
        android:background="@drawable/co_bg"
        android:paddingLeft="4.0dip"
        android:paddingTop="4.659973dip"
        android:paddingRight="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="fill_parent"
        android:layout_height="56.659973dip"
        android:layout_weight="0.0">
        <Button
            android:enabled="false"
            android:textSize="16.0dip"
            android:id="@id/vcard_send_btn"
            android:layout_width="0.0dip"
            android:layout_height="48.0dip"
            android:text="@string/vcard_detail_send"
            android:layout_weight="1.0" />
        <Button
            android:enabled="false"
            android:textSize="16.0dip"
            android:id="@id/vcard_save_btn"
            android:layout_width="0.0dip"
            android:layout_height="48.0dip"
            android:text="@string/vcard_detail_save"
            android:layout_weight="1.0" />
        <Button
            android:textSize="16.0dip"
            android:id="@id/vcard_cancel_btn"
            android:layout_width="0.0dip"
            android:layout_height="48.0dip"
            android:text="@string/vcard_detail_cancel"
            android:layout_weight="1.0" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@id/vcard_nocontact_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <TextView
            android:textSize="18.0dip"
            android:textStyle="bold"
            android:textColor="#ffefad51"
            android:ellipsize="marquee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vcard_nocontact_message"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>