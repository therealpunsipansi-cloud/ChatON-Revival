<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/intro_bg_01"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/llayoutid_01"
        android:background="@drawable/co_header2_bg"
        android:layout_width="fill_parent"
        android:layout_height="25.0dip">
        <TextView
            android:textStyle="bold"
            android:textColor="@color/brown_color_001"
            android:gravity="center_vertical"
            android:id="@id/txt_title"
            android:paddingLeft="6.0dip"
            android:layout_width="fill_parent"
            android:layout_height="25.0dip"
            android:text="@string/provisioning_registration" />
    </LinearLayout>
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1.0">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center|left"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6.659973dip"
                android:layout_marginRight="6.659973dip">
                <TextView
                    android:textSize="13.0dip"
                    android:textColor="@color/brown_color_017"
                    android:id="@id/phoneNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3.0dip"
                    android:layout_marginRight="6.659973dip"
                    android:maxLines="3"
                    android:layout_weight="1.0" />
                <TextView
                    android:textSize="17.0dip"
                    android:textColor="@color/white"
                    android:id="@id/changePho"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5.0dip"
                    android:layout_marginRight="5.0dip"
                    android:text="@string/ams_optmenu_edit"
                    android:singleLine="true" />
            </LinearLayout>
            <TextView
                android:textSize="17.0dip"
                android:textColor="@color/white"
                android:id="@id/txtRegistName_0"
                android:paddingLeft="14.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/provisioning_verification_code"
                android:layout_below="@id/llayoutid_01" />
            <EditText
                android:id="@id/vCode"
                android:paddingLeft="10.659973dip"
                android:layout_width="fill_parent"
                android:layout_height="40.0dip"
                android:layout_marginLeft="6.659973dip"
                android:layout_marginTop="3.0dip"
                android:layout_marginRight="6.659973dip"
                android:singleLine="true"
                android:maxLength="4"
                android:inputType="number" />
            <Button
                android:enabled="true"
                android:textSize="16.0dip"
                android:layout_gravity="center"
                android:id="@id/reSend"
                android:background="@drawable/btn_disclaimer_bg_xml"
                android:paddingLeft="5.0dip"
                android:paddingRight="5.0dip"
                android:layout_width="fill_parent"
                android:layout_height="40.0dip"
                android:layout_marginLeft="6.659973dip"
                android:layout_marginTop="10.0dip"
                android:layout_marginRight="6.659973dip"
                android:text="@string/provisioning_resend" />
            <TextView
                android:textSize="13.0dip"
                android:textColor="@color/white"
                android:id="@id/verification_explain_text"
                android:paddingLeft="11.659973dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3.0dip"
                android:text="@string/provisioning_verification_explain" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/layout_done"
        android:background="@drawable/co_bg"
        android:paddingLeft="4.0dip"
        android:paddingTop="8.0dip"
        android:paddingRight="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Button
            android:enabled="false"
            android:textSize="16.0dip"
            android:id="@id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="50.0dip"
            android:layout_marginLeft="42.659973dip"
            android:layout_marginRight="42.659973dip"
            android:text="@string/done"
            android:layout_weight="1.0" />
        <Button
            android:textSize="16.0dip"
            android:id="@id/btnCancel"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="50.0dip"
            android:text="@string/cancel"
            android:layout_weight="1.0" />
    </LinearLayout>
</LinearLayout>