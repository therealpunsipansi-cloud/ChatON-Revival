<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:id="@id/image_preview_menubar"
        android:background="@drawable/co_bg"
        android:paddingLeft="4.0dip"
        android:paddingTop="4.659973dip"
        android:paddingRight="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="fill_parent"
        android:layout_height="54.659973dip"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="16.0dip"
            android:id="@id/save_image"
            android:background="@drawable/buddyprofile_chat_button_xml"
            android:layout_width="0.0dip"
            android:layout_height="48.0dip"
            android:text="@string/save"
            android:layout_weight="1.0" />
        <Button
            android:textSize="16.0dip"
            android:id="@id/send_image"
            android:background="@drawable/buddyprofile_chat_button_xml"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="48.0dip"
            android:text="@string/layout_imageview_send"
            android:layout_weight="1.0" />
        <Button
            android:textSize="16.0dip"
            android:id="@id/image_preview_cancel"
            android:background="@drawable/buddyprofile_chat_button_xml"
            android:layout_width="0.0dip"
            android:layout_height="48.0dip"
            android:text="@string/cancel"
            android:layout_weight="1.0" />
    </LinearLayout>
    <ImageView
        android:id="@id/original_image"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:adjustViewBounds="true"
        android:layout_above="@id/image_preview_menubar" />
</RelativeLayout>