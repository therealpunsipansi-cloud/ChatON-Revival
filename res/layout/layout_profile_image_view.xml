<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/layout_profile_image_title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18.0dip"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@id/profile_image_title"
            android:background="@drawable/co_sub_title_bg"
            android:paddingLeft="6.6999817dip"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="36.0dip"
            android:text="@string/mypage_profile_image" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@id/profile_holder"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_weight="1.0">
        <ImageView
            android:id="@id/profile_big_image"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
    </LinearLayout>
    <LinearLayout
        android:background="@drawable/co_bg"
        android:paddingLeft="4.0dip"
        android:paddingTop="4.659973dip"
        android:paddingRight="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="fill_parent"
        android:layout_height="56.659973dip"
        android:layout_weight="0.0">
        <Button
            android:textSize="16.0dip"
            android:id="@id/profile_ok"
            android:background="@drawable/btn_disclaimer_bg_xml"
            android:layout_width="0.0dip"
            android:layout_height="48.0dip"
            android:text="@string/setting_button_change"
            android:layout_weight="1.0" />
        <Button
            android:textSize="16.0dip"
            android:id="@id/profile_cancel"
            android:background="@drawable/btn_disclaimer_bg_xml"
            android:layout_width="0.0dip"
            android:layout_height="48.0dip"
            android:text="@string/cancel"
            android:layout_weight="1.0" />
    </LinearLayout>
</LinearLayout>