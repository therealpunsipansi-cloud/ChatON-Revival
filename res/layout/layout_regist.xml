<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/intro_bg_01"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/brown_color_001"
        android:gravity="center_vertical"
        android:id="@id/txt_title"
        android:background="@drawable/co_header2_bg"
        android:paddingLeft="6.0dip"
        android:layout_width="fill_parent"
        android:layout_height="25.0dip"
        android:text="@string/layout_regist_country_registration" />
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1.0">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16.0dip"
                android:textColor="@color/white"
                android:gravity="left"
                android:id="@id/txt_select_country"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24.0dip"
                android:layout_marginTop="12.599976dip"
                android:layout_marginRight="24.0dip"
                android:text="@string/registration_select_country_or_region_code" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/newSearch"
                android:background="@drawable/co_btn_01_default"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="fill_parent"
                android:layout_height="48.0dip"
                android:layout_marginLeft="22.0dip"
                android:layout_marginRight="22.0dip">
                <TextView
                    android:textSize="16.0dip"
                    android:textStyle="bold"
                    android:textColor="@color/country_button_text"
                    android:ellipsize="marquee"
                    android:gravity="center_vertical"
                    android:id="@id/editCountryName"
                    android:paddingLeft="5.0dip"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="170.0dip"
                    android:text="@string/layout_regist_country"
                    android:singleLine="true" />
                <TextView
                    android:textSize="16.0dip"
                    android:textStyle="bold"
                    android:textColor="@color/country_button_text"
                    android:gravity="center_vertical"
                    android:id="@id/editCountryCode"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/layout_regist_code"
                    android:layout_weight="1.0" />
                <ImageView
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8.0dip"
                    android:src="@drawable/btn_country_code_bg_xml" />
            </LinearLayout>
            <TextView
                android:textSize="16.0dip"
                android:textColor="@color/white"
                android:id="@id/txtRegist_1"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24.0dip"
                android:layout_marginTop="7.0dip"
                android:layout_marginRight="24.0dip"
                android:text="@string/regist_inputPno" />
            <EditText
                android:id="@id/editPno"
                android:paddingLeft="10.659973dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="22.0dip"
                android:layout_marginRight="22.0dip"
                android:maxLength="20"
                android:inputType="number" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/co_bg"
        android:paddingLeft="4.0dip"
        android:paddingTop="8.0dip"
        android:paddingRight="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <Button
            android:enabled="false"
            android:id="@id/btnSelfSMS"
            android:layout_width="wrap_content"
            android:layout_height="50.0dip"
            android:layout_marginLeft="42.659973dip"
            android:layout_marginRight="42.659973dip"
            android:text="@string/done"
            android:layout_weight="3.0" />
        <Button
            android:id="@id/btnCancel"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="50.0dip"
            android:text="@string/cancel"
            android:layout_weight="3.0" />
        <Button
            android:textSize="7.0sp"
            android:id="@id/btnGenerateIMEI"
            android:visibility="gone"
            android:layout_width="50.0dip"
            android:layout_height="wrap_content"
            android:text="IMEI"
            android:layout_weight="3.0" />
        <Button
            android:textSize="7.0sp"
            android:id="@id/btnNSS"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="50.0dip"
            android:text="NSS"
            android:layout_weight="3.0" />
    </LinearLayout>
</LinearLayout>