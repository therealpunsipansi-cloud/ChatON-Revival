<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@drawable/intro_bg_01"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:scrollbars="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/llayoutid_01"
            android:background="@drawable/co_header2_bg"
            android:layout_width="fill_parent"
            android:layout_height="25.0dip">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/brown_color_001"
                android:gravity="center_vertical"
                android:layout_gravity="top"
                android:id="@id/txt_title"
                android:paddingLeft="5.0dip"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:text="@string/setting_enter_name" />
        </LinearLayout>
        <TextView
            android:textColor="@color/white"
            android:id="@id/txtRegistName_0"
            android:paddingLeft="24.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.599976dip"
            android:text="@string/regist_name"
            android:layout_below="@id/llayoutid_01" />
        <EditText
            android:id="@id/txtName"
            android:paddingLeft="10.659973dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22.0dip"
            android:layout_marginTop="7.0dip"
            android:layout_marginRight="22.0dip"
            android:singleLine="true"
            android:maxLength="30" />
        <TextView
            android:textColor="@color/white"
            android:id="@id/pushnameExplain"
            android:paddingLeft="24.0dip"
            android:paddingRight="24.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7.0dip"
            android:text="@string/regist_name_detail" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/layoutRegistName_0"
        android:background="@drawable/co_bg"
        android:paddingLeft="4.0dip"
        android:paddingTop="8.0dip"
        android:paddingRight="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Button
            android:enabled="false"
            android:textSize="16.0dip"
            android:id="@id/btnDone"
            android:background="@drawable/btn_disclaimer_bg_xml"
            android:layout_width="wrap_content"
            android:layout_height="50.0dip"
            android:layout_marginLeft="42.659973dip"
            android:layout_marginRight="42.659973dip"
            android:text="@string/done"
            android:layout_weight="1.0" />
        <Button
            android:textSize="16.0dip"
            android:id="@id/btnCancel"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="50.0dip"
            android:text="@string/cancel"
            android:layout_weight="1.0" />
    </LinearLayout>
</RelativeLayout>