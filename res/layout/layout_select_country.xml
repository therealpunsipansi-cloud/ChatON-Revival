<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/ics_main_background_color_2"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@id/txt_title"
            android:background="@drawable/co_header2_bg"
            android:paddingLeft="6.0dip"
            android:layout_width="fill_parent"
            android:layout_height="25.0dip"
            android:text="@string/select_country" />
        <TextView
            android:textSize="22.0dip"
            android:textColor="@color/ics_main_font_color_2"
            android:gravity="center|left"
            android:id="@id/editCountryCode"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="220.0dip"
            android:layout_marginTop="74.0dip"
            android:minWidth="100.0dip"
            android:text="@string/registration_select_country_or_region_code"
            android:layout_weight="1.0" />
        <ImageView
            android:background="@color/color_palette_12"
            android:layout_width="843.0dip"
            android:layout_height="1.0dip"
            android:layout_marginLeft="220.0dip"
            android:layout_marginTop="10.0dip"
            android:layout_marginRight="217.0dip" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/newSearch"
            android:background="@drawable/provisioning_btn01"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="220.0dip"
            android:layout_marginTop="10.0dip"
            android:layout_marginRight="217.0dip">
            <TextView
                android:textSize="22.0dip"
                android:textStyle="bold"
                android:textColor="@color/color_button_disable"
                android:ellipsize="marquee"
                android:gravity="center|left|top"
                android:id="@id/editCountryName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12.0dip"
                android:text="@string/layout_regist_no_country_selected"
                android:singleLine="true"
                android:layout_weight="1.0" />
            <ImageView
                android:layout_gravity="center|right"
                android:background="@drawable/list_round_more_arrow_selector"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5.0dip"
                android:scaleType="fitXY" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>