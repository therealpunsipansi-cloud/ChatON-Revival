<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:background="@drawable/co_title_bar"
        android:paddingLeft="6.0dip"
        android:layout_width="fill_parent"
        android:layout_height="25.0dip"
        android:text="@string/setting_birthday" />
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:background="@drawable/co_sub_title_bg"
                android:paddingLeft="6.6999817dip"
                android:layout_width="fill_parent"
                android:layout_height="25.299988dip">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_birthday_option" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/linear_radios">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@id/llayout_full_text"
                    android:background="@drawable/birthday_item_xml"
                    android:layout_width="fill_parent"
                    android:layout_height="64.0dip">
                    <TextView
                        android:textSize="22.0dip"
                        android:id="@id/full_text"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10.0dip"
                        android:text="@string/setting_birthday_option_full"
                        android:layout_weight="1.0" />
                    <RadioButton
                        android:id="@id/full_date_type"
                        android:layout_width="wrap_content"
                        android:layout_height="48.0dip"
                        android:layout_marginRight="10.0dip" />
                </LinearLayout>
                <ImageView
                    android:background="#ff333a3a"
                    android:layout_width="fill_parent"
                    android:layout_height="0.30000007dip" />
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@id/llayout_short_text"
                    android:background="@drawable/birthday_item_xml"
                    android:layout_width="fill_parent"
                    android:layout_height="64.0dip">
                    <TextView
                        android:textSize="22.0dip"
                        android:id="@id/short_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10.0dip"
                        android:text="@string/setting_birthday_option_month"
                        android:layout_weight="1.0" />
                    <RadioButton
                        android:id="@id/short_date_type"
                        android:layout_width="wrap_content"
                        android:layout_height="48.0dip"
                        android:layout_marginRight="10.0dip" />
                </LinearLayout>
                <ImageView
                    android:background="#ff333a3a"
                    android:layout_width="fill_parent"
                    android:layout_height="0.30000007dip" />
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@id/llayout_dont_text"
                    android:background="@drawable/birthday_item_xml"
                    android:layout_width="fill_parent"
                    android:layout_height="64.0dip">
                    <TextView
                        android:textSize="22.0dip"
                        android:id="@id/dont_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10.0dip"
                        android:text="@string/setting_birthday_option_dont"
                        android:layout_weight="1.0" />
                    <RadioButton
                        android:id="@id/dont_show_type"
                        android:layout_width="wrap_content"
                        android:layout_height="48.0dip"
                        android:layout_marginRight="10.0dip" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:background="@drawable/co_sub_title_bg"
                android:paddingLeft="6.6999817dip"
                android:layout_width="fill_parent"
                android:layout_height="25.299988dip">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_birthday_date" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:id="@id/llayoutBDay"
                android:background="@drawable/userprofile_title_background"
                android:clickable="true"
                android:layout_width="fill_parent"
                android:layout_height="64.0dip">
                <TextView
                    android:textSize="22.0dip"
                    android:textColor="@color/blue_color_021"
                    android:gravity="center_vertical"
                    android:id="@id/dateDisplay"
                    android:paddingLeft="10.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:text="@string/add_your_birthday"
                    android:layout_weight="1.0" />
                <ImageButton
                    android:id="@id/birthday_more"
                    android:background="@drawable/mypage_name_more_background_xml"
                    android:focusable="false"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10.0dip"
                    android:scaleType="fitXY"
                    android:layout_centerVertical="true" />
            </LinearLayout>
            <ImageView
                android:background="#ff333a3a"
                android:layout_width="fill_parent"
                android:layout_height="0.30000007dip" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/layoutRegistName_0"
        android:background="@drawable/co_bg"
        android:paddingLeft="4.0dip"
        android:paddingTop="6.0dip"
        android:paddingRight="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="fill_parent"
        android:layout_height="55.0dip"
        android:layout_alignParentBottom="true">
        <Button
            android:enabled="true"
            android:textSize="16.0dip"
            android:id="@id/btnSave"
            android:background="@drawable/btn_disclaimer_bg_xml"
            android:layout_width="wrap_content"
            android:layout_height="48.0dip"
            android:text="@string/save"
            android:layout_weight="1.0" />
        <Button
            android:textSize="16.0dip"
            android:id="@id/btnCancel"
            android:background="@drawable/btn_disclaimer_bg_xml"
            android:layout_width="wrap_content"
            android:layout_height="48.0dip"
            android:text="@string/cancel"
            android:layout_weight="1.0" />
    </LinearLayout>
</LinearLayout>