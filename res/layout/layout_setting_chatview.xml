<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:background="@drawable/co_title_bar"
        android:paddingLeft="6.0dip"
        android:layout_width="fill_parent"
        android:layout_height="25.0dip"
        android:text="@string/settings_chat_view_font_size" />
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:fillViewport="true"
        android:layout_weight="1.0">
        <include
            layout="@layout/layout_skin_chatroom" />
    </ScrollView>
    <ListView
        android:id="@android:id/list"
        android:layout_width="fill_parent"
        android:layout_height="294.0dip" />
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@id/vcalendar_receive_menu_bar"
        android:background="@drawable/co_bg"
        android:paddingLeft="4.0dip"
        android:paddingTop="6.0dip"
        android:paddingRight="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="fill_parent"
        android:layout_height="54.0dip">
        <Button
            android:textSize="16.0sp"
            android:id="@id/save_viewsize"
            android:background="@drawable/btn_disclaimer_bg_xml"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginRight="0.70000005dip"
            android:text="@string/save"
            android:layout_weight="1.0" />
        <Button
            android:textSize="16.0sp"
            android:id="@id/btnCancel"
            android:background="@drawable/btn_disclaimer_bg_xml"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginRight="0.70000005dip"
            android:text="@string/cancel"
            android:layout_weight="1.0" />
    </LinearLayout>
</LinearLayout>