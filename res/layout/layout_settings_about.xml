<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:background="@drawable/co_title_bar"
        android:paddingLeft="6.0dip"
        android:layout_width="fill_parent"
        android:layout_height="25.0dip"
        android:text="@string/settings_about" />
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="fill_parent"
        android:src="@drawable/logo_03"
        android:layout_weight="1.0" />
    <TextView
        android:textSize="16.0sp"
        android:textColor="@color/blue_color_021"
        android:gravity="center"
        android:id="@id/setting_help_explain"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20.0dip"
        android:layout_marginTop="14.0dip"
        android:layout_marginRight="20.0dip"
        android:layout_marginBottom="36.0dip"
        android:text="@string/setting_help_explain" />
    <TextView
        android:textSize="14.0sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@id/setting_current_version"
        android:layout_width="fill_parent"
        android:layout_height="20.0dip"
        android:layout_marginTop="30.0dip"
        android:text="@string/setting_current_version" />
    <TextView
        android:textSize="14.0sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@id/setting_upgrade_version"
        android:visibility="invisible"
        android:layout_width="fill_parent"
        android:layout_height="20.0dip"
        android:layout_marginBottom="16.0dip"
        android:text="" />
    <Button
        android:textSize="16.0sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:id="@id/setting_about_btn_license"
        android:layout_width="232.0dip"
        android:layout_height="50.0dip"
        android:text="@string/settings_license" />
    <Button
        android:textSize="16.0sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:id="@id/setting_about_btn1"
        android:layout_width="232.0dip"
        android:layout_height="50.0dip"
        android:layout_marginTop="8.0dip"
        android:layout_marginBottom="16.0dip"
        android:text="@string/setting_upgrade_text" />
</LinearLayout>