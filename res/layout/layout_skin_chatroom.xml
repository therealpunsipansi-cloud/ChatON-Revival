<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/skin_preview"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_weight="1.0"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/photo_bg"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:scaleType="fitXY" />
    <RelativeLayout
        android:gravity="center"
        android:id="@id/relative_imgfriend"
        android:background="@drawable/thumb_default_line"
        android:layout_width="56.0dip"
        android:layout_height="56.0dip"
        android:layout_marginLeft="6.6999817dip"
        android:layout_marginTop="20.0dip">
        <com.sec.chaton.widget.RoundedImageView
            android:id="@id/imgfriend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/contacts_default_img"
            android:scaleType="fitXY" />
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/textRecvContent"
        android:background="@drawable/message_bubble_read"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4.0dip"
        android:layout_toRightOf="@id/relative_imgfriend"
        android:layout_alignBottom="@id/relative_imgfriend">
        <TextView
            android:textSize="16.0dip"
            android:textColor="@color/black"
            android:textColorLink="#ff153da5"
            android:gravity="center"
            android:autoLink="all"
            android:id="@id/read_font_size"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8.0dip"
            android:layout_marginTop="2.0dip"
            android:layout_marginRight="12.0dip"
            android:layout_marginBottom="6.0dip"
            android:text="@string/setting_set_font_hello" />
        <TextView
            android:textSize="10.0dip"
            android:textColor="#ff282319"
            android:id="@id/read_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12.0dip"
            android:text="@string/setting_change_skin_time" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/textRecvContent">
        <TextView
            android:textSize="11.299988dip"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@id/textfriend1"
            android:layout_width="wrap_content"
            android:layout_height="16.699982dip"
            android:layout_marginLeft="6.6999817dip"
            android:layout_marginBottom="6.6999817dip"
            android:text="Victoria Justice"
            android:singleLine="true"
            android:layout_alignParentBottom="true" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/lLayoutSndContent"
        android:background="@drawable/message_bubble_sent"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.0dip"
        android:layout_below="@id/textRecvContent"
        android:layout_alignParentRight="true">
        <TextView
            android:textSize="16.0dip"
            android:textColor="@color/black"
            android:textColorLink="#ff153da5"
            android:gravity="left"
            android:autoLink="all"
            android:id="@id/sent_font_size"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8.0dip"
            android:layout_marginTop="2.0dip"
            android:layout_marginRight="12.0dip"
            android:layout_marginBottom="6.0dip"
            android:text="@string/setting_set_font_hi" />
        <TextView
            android:textSize="10.0dip"
            android:textColor="#ff282319"
            android:id="@id/sent_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="14.0dip"
            android:text="@string/setting_change_skin_time" />
    </LinearLayout>
</RelativeLayout>