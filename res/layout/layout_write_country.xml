<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/newCountry"
        android:paddingLeft="13.299988dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:onClick="onCountryClick">
        <TextView
            android:id="@id/txtCountry"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="8.0dip"
            android:layout_marginRight="10.0dip"
            android:text="@string/regist_write_country_code"
            android:layout_below="@id/newCountry" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10.0dip"
        android:layout_marginTop="7.0dip"
        android:layout_marginRight="10.0dip"
        android:layout_below="@id/newCountry">
        <EditText
            android:id="@id/editCountryCode"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLength="3"
            android:layout_weight="1.0"
            android:inputType="number" />
        <ImageView
            android:id="@id/seperator"
            android:background="#ff333a3a"
            android:layout_width="fill_parent"
            android:layout_height="0.30000007dip" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="7.0dip"
            android:layout_marginRight="10.0dip">
            <Button
                android:id="@id/done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/done"
                android:layout_weight="3.0" />
            <Button
                android:id="@id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:layout_weight="3.0" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>