<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/rlay_relation"
    android:layout_width="fill_parent"
    android:layout_height="72.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.sec.chaton.widget.ProfileImageView
        android:id="@id/relation_img"
        android:layout_width="53.299988dip"
        android:layout_height="55.0dip"
        android:layout_marginLeft="6.6999817dip"
        android:layout_marginTop="6.6999817dip"
        android:layout_marginRight="0.30000007dip"
        android:layout_marginBottom="6.299988dip"
        android:scaleType="fitXY" />
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@id/relative0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14.599976dip"
        android:layout_marginTop="6.6999817dip"
        android:layout_toRightOf="@id/relation_img">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/linear0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5.0dip"
            android:layout_marginBottom="3.0dip">
            <TextView
                android:textSize="15.0dip"
                android:textColor="@color/white"
                android:ellipsize="marquee"
                android:id="@id/relation_rank_text_name"
                android:layout_width="wrap_content"
                android:layout_height="21.0dip"
                android:text="@string/setting_interaction_wall"
                android:singleLine="true"
                android:shadowColor="@color/black" />
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/namenpoint"
                android:layout_width="wrap_content"
                android:layout_height="14.0dip">
                <TextView
                    android:textSize="10.0dip"
                    android:textColor="@color/white"
                    android:id="@id/relation_rank_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buddy_profile_rank"
                    android:shadowColor="@color/black" />
                <TextView
                    android:textSize="10.0dip"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" : " />
                <TextView
                    android:textSize="10.0dip"
                    android:textColor="@color/white"
                    android:id="@id/relation_rank_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buddy_profile_rank"
                    android:shadowColor="@color/black" />
                <TextView
                    android:textSize="10.0dip"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / "
                    android:shadowColor="@color/black" />
                <TextView
                    android:textSize="10.0dip"
                    android:textColor="@color/white"
                    android:id="@id/relation_point_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buddy_profile_point"
                    android:shadowColor="@color/black" />
                <TextView
                    android:textSize="10.0dip"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" : "
                    android:shadowColor="@color/black" />
                <TextView
                    android:textSize="10.0dip"
                    android:textColor="@color/white"
                    android:id="@id/relation_point"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_interaction_zero"
                    android:shadowColor="@color/black" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@id/lbar"
            android:layout_width="149.0dip"
            android:layout_height="21.0dip"
            android:layout_marginBottom="5.0dip"
            android:layout_below="@id/linear0">
            <ImageView
                android:layout_width="18.659973dip"
                android:layout_height="22.659973dip"
                android:src="@drawable/relationship_bubble2_left_tail"
                android:scaleType="fitXY"
                android:minWidth="18.659973dip"
                android:layout_weight="0.0" />
            <TextView
                android:textSize="12.0dip"
                android:textColor="@color/black"
                android:gravity="center|left"
                android:id="@id/relation_received"
                android:background="@drawable/relationship_bubble2_left"
                android:layout_width="18.659973dip"
                android:layout_height="25.329987dip"
                android:text="Buddy"
                android:layout_weight="250.0" />
            <TextView
                android:textSize="12.0dip"
                android:textColor="@color/black"
                android:gravity="center|right"
                android:id="@id/relation_send"
                android:background="@drawable/relationship_bubble2_right"
                android:layout_width="18.659973dip"
                android:layout_height="25.329987dip"
                android:text="@string/setting_interaction_me"
                android:layout_weight="150.0" />
            <ImageView
                android:id="@id/interaction_right_tail"
                android:background="@drawable/relationship_bubble2_right_tail"
                android:layout_width="18.659973dip"
                android:layout_height="22.659973dip"
                android:scaleType="fitXY"
                android:minWidth="18.659973dip"
                android:layout_weight="0.0" />
            <RelativeLayout
                android:id="@id/rbar"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_marginLeft="2.0dip"
                android:layout_marginRight="5.0dip"
                android:layout_weight="50.0"
                android:layout_toRightOf="@id/lbar">
                <TextView
                    android:textSize="14.0dip"
                    android:textColor="@color/black"
                    android:gravity="right"
                    android:id="@id/relation_gap"
                    android:background="#ffffffff"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="14.699982dip"
                    android:text="@string/setting_interaction_gap"
                    android:layout_alignParentLeft="true" />
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/linearLayout1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="45.0dip"
        android:layout_marginRight="13.0dip"
        android:layout_alignParentRight="true">
        <ImageView
            android:layout_gravity="bottom"
            android:id="@id/relation_img_increase"
            android:background="@drawable/relationship_arrow_up"
            android:layout_width="10.0dip"
            android:layout_height="10.0dip"
            android:scaleType="fitXY" />
        <TextView
            android:textSize="8.659973dip"
            android:textColor="@color/white"
            android:id="@id/relation_increase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30"
            android:shadowColor="@color/black"
            android:shadowDx="1.0"
            android:shadowDy="1.0" />
    </LinearLayout>
    <ImageView
        android:id="@id/relation_rank_img"
        android:layout_width="20.0dip"
        android:layout_height="40.0dip"
        android:layout_marginTop="3.0dip"
        android:layout_marginRight="6.0dip"
        android:layout_alignParentRight="true" />
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/relation_img">
        <ImageView
            android:background="#ff333a3a"
            android:layout_width="fill_parent"
            android:layout_height="0.30000007dip" />
    </LinearLayout>
</RelativeLayout>