<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@drawable/co_status_bar_header_bg3"
        android:layout_width="fill_parent"
        android:layout_height="50.0dip"
        android:layout_weight="0.0">
        <ImageView
            android:id="@id/profile_nonbuddy_image"
            android:layout_width="43.329987dip"
            android:layout_height="43.329987dip"
            android:layout_marginLeft="8.0dip"
            android:layout_marginRight="14.659973dip"
            android:scaleType="fitXY"
            android:layout_weight="0.0" />
        <TextView
            android:textSize="16.0dip"
            android:textStyle="bold"
            android:textColor="@color/brown_color_001"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@id/new_buddy_name"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="9.329987dip"
            android:maxLines="1"
            android:shadowColor="@color/brown_color_002"
            android:shadowDx="-1.0"
            android:shadowDy="-1.0"
            android:layout_weight="1.0" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20.0dip"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <TextView
            android:textSize="18.0dip"
            android:textStyle="bold"
            android:textColor="#ffefad51"
            android:id="@id/new_buddy_information"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout
        android:background="@drawable/co_bg"
        android:paddingLeft="4.0dip"
        android:paddingTop="4.659973dip"
        android:paddingRight="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="fill_parent"
        android:layout_height="56.659973dip"
        android:layout_weight="0.0">
        <Button
            android:textSize="16.0dip"
            android:id="@id/new_buddy_add"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="48.0dip"
            android:text="@string/buddy_profile_button_addbuddy"
            android:layout_weight="1.0" />
        <Button
            android:textSize="16.0dip"
            android:id="@id/new_buddy_block"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="48.0dip"
            android:text="@string/buddy_profile_button_block"
            android:layout_weight="1.0" />
        <Button
            android:textSize="16.0dip"
            android:id="@id/new_buddy_unblock"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="48.0dip"
            android:text="@string/setting_block_unblock"
            android:layout_weight="1.0" />
        <Button
            android:textSize="16.0dip"
            android:id="@id/new_buddy_cancel"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="48.0dip"
            android:text="@string/cancel"
            android:layout_weight="1.0" />
    </LinearLayout>
</LinearLayout>