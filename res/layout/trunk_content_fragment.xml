<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ListView
        android:id="@id/trunkContentList"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomView"
        android:layout_below="@id/titleView" />
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@id/titleView"
        android:background="@drawable/co_status_bar_header_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-5.299988dip">
        <com.sec.chaton.util.EllipsisTextView
            android:textSize="17.299988dip"
            android:textColor="@color/color1"
            android:gravity="center_horizontal"
            android:id="@id/trunkContentTitle"
            android:layout_width="fill_parent"
            android:layout_height="22.0dip"
            android:singleLine="true" />
        <com.sec.chaton.util.EllipsisTextView
            android:textSize="14.0dip"
            android:textColor="#ff3c1f0a"
            android:gravity="center_horizontal"
            android:id="@id/trunkContentTitleTime"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:singleLine="true" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/bottomView"
        android:background="@drawable/co_bg"
        android:paddingLeft="4.0dip"
        android:paddingTop="6.0dip"
        android:paddingRight="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="fill_parent"
        android:layout_height="54.599976dip"
        android:layout_alignParentBottom="true">
        <Button
            android:id="@id/commentButton"
            android:background="@drawable/ams_popup_btn_default"
            android:layout_width="fill_parent"
            android:layout_height="48.0dip"
            android:text="@string/trunk_btn_comment"
            android:layout_weight="0.5" />
        <Button
            android:enabled="false"
            android:id="@id/trunkContentShareButton"
            android:background="@drawable/ams_popup_btn_default"
            android:layout_width="fill_parent"
            android:layout_height="48.0dip"
            android:text="@string/trunk_btn_share"
            android:layout_weight="0.5" />
    </LinearLayout>
</RelativeLayout>