<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:background="@drawable/co_sub_title_bg"
            android:paddingLeft="6.6999817dip"
            android:layout_width="fill_parent"
            android:layout_height="25.299988dip">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_profile" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@id/imgbtnUPPhoto"
                android:background="#00000000"
                android:focusable="true"
                android:layout_width="100.0dip"
                android:layout_height="100.0dip"
                android:layout_marginLeft="7.299988dip"
                android:layout_marginTop="6.669983dip"
                android:scaleType="fitXY" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/layout3"
                android:background="@drawable/userprofile_background_name_xml"
                android:clickable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6.0dip"
                android:layout_marginTop="6.669983dip"
                android:layout_marginRight="4.6999817dip">
                <RelativeLayout
                    android:orientation="horizontal"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="22.0dip"
                        android:textColor="@color/white"
                        android:ellipsize="marquee"
                        android:gravity="center_vertical"
                        android:id="@id/textPersonalName"
                        android:paddingLeft="7.0dip"
                        android:paddingRight="5.299988dip"
                        android:duplicateParentState="true"
                        android:layout_width="fill_parent"
                        android:layout_height="40.0dip"
                        android:layout_marginRight="35.0dip"
                        android:hint="Name"
                        android:singleLine="true"
                        android:imeOptions="actionDone" />
                    <ImageButton
                        android:id="@id/userprofile_detail"
                        android:background="@drawable/mypage_name_more_background_xml"
                        android:focusable="true"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="3.0dip"
                        android:layout_toRightOf="@id/textPersonalName"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>
                <TextView
                    android:textSize="17.0dip"
                    android:textColor="#ff9a9a9a"
                    android:gravity="left"
                    android:id="@id/user_Pno"
                    android:paddingLeft="7.0dip"
                    android:duplicateParentState="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="+1234567890" />
                <TextView
                    android:textSize="17.0dip"
                    android:textColor="#ff9a9a9a"
                    android:gravity="left"
                    android:id="@id/dateDisplay"
                    android:paddingLeft="7.0dip"
                    android:duplicateParentState="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_your_birthday"
                    android:layout_below="@id/text_birthday" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/llayout_account_1"
            android:paddingLeft="13.299988dip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="64.0dip">
            <TextView
                android:textSize="22.0dip"
                android:textColor="@color/white"
                android:gravity="left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_samsung_account" />
            <TextView
                android:textSize="14.0dip"
                android:textColor="@color/ssm_blue"
                android:gravity="left"
                android:id="@id/user_Account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_gmail_account" />
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@id/linear_status_message"
            android:paddingLeft="7.299988dip"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6.0dip">
            <TextView
                android:textSize="22.0dip"
                android:textColor="@color/blue_color_021"
                android:textColorHint="@color/blue_color_021"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@id/textPersonalMsg"
                android:background="@drawable/userprofile_background_xml"
                android:paddingLeft="14.699982dip"
                android:paddingRight="14.699982dip"
                android:duplicateParentState="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dip"
                android:layout_marginRight="6.0dip"
                android:layout_marginBottom="1.5dip"
                android:minHeight="46.0dip"
                android:hint="@string/mypage_profile_status"
                android:maxLines="3"
                android:drawableLeft="@drawable/mypage_status_input_background_xml"
                android:drawablePadding="10.0dip"
                android:imeOptions="actionDone" />
        </LinearLayout>
        <RelativeLayout
            android:id="@id/rlayoutBDay"
            android:background="@drawable/userprofile_title_background"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="64.0dip">
            <TextView
                android:textSize="14.0dip"
                android:textColor="@color/blue_color_021"
                android:gravity="left"
                android:id="@id/text_birthday"
                android:paddingLeft="13.299988dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.699982dip"
                android:text="@string/setting_birthday" />
            <ImageButton
                android:id="@id/birthday_detail"
                android:background="@drawable/ams_btn_radio"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="22.0dip"
                android:src="@drawable/detail_round_more"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>
        <RelativeLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@id/rlay_details"
            android:background="@drawable/co_sub_title_bg"
            android:paddingLeft="6.6999817dip"
            android:layout_width="fill_parent"
            android:layout_height="25.299988dip"
            android:layout_marginTop="6.0dip">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_interaction_rank"
                android:layout_centerVertical="true" />
        </RelativeLayout>
        <LinearLayout
            android:id="@id/flayout_relationship"
            android:layout_width="fill_parent"
            android:layout_height="62.0dip">
            <LinearLayout
                android:gravity="left"
                android:id="@id/rParent"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <com.sec.widget.HorizontalListView
                    android:id="@id/interaction_horizontal_listview"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0" />
                <ImageView
                    android:layout_gravity="center"
                    android:id="@id/userprofile_interaction_rank"
                    android:background="@drawable/mypage_name_more_background_xml"
                    android:focusable="true"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10.0dip"
                    android:layout_marginRight="10.0dip"
                    android:layout_weight="0.0"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true" />
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:background="#ff333a3a"
            android:layout_width="fill_parent"
            android:layout_height="0.30000007dip" />
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@id/rlay_details"
            android:paddingLeft="13.299988dip"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="64.0dip">
            <TextView
                android:textSize="22.0dip"
                android:textColor="@color/white"
                android:layout_width="247.0dip"
                android:layout_height="wrap_content"
                android:text="@string/setting_interaction_rank"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true" />
            <ImageButton
                android:id="@id/userprofile_detail_del"
                android:background="@drawable/ams_btn_radio"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="22.0dip"
                android:src="@drawable/detail_round_more"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>
        <ImageView
            android:background="#ff333a3a"
            android:layout_width="fill_parent"
            android:layout_height="0.30000007dip" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/list_header"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@id/memo_layout_title"
                android:background="@drawable/co_sub_title_bg"
                android:paddingLeft="6.6999817dip"
                android:clickable="true"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:text="@string/memo_title" />
            <LinearLayout
                android:id="@id/mypage_write_area"
                android:padding="6.659973dip"
                android:layout_width="fill_parent"
                android:layout_height="44.659973dip">
                <Button
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@id/memo_btn_write"
                    android:background="@drawable/memo_write_button_xml"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:text="@string/memo_btn_write" />
            </LinearLayout>
            <ImageView
                android:id="@id/memo_write_below_line"
                android:background="#ff333a3a"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="0.30000007dip" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>